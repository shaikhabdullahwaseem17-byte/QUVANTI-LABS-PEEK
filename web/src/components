                  <FormulaBox
                    formula="w_k = w_{k-1} · (d − k + 1) / k,  w_0 = 1"
                    color="#F59E0B"
                  />
                </div>
              )}

              {/* ── VaR 95% + TREYNOR ────────────────────────────────────── */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {m.var95 && (
                  <div
                    className="rounded-xl p-4"
                    style={{
                      background: "rgba(255,255,255,0.025)",
                      border: "1px solid rgba(255,255,255,0.07)",
                    }}
                  >
                    <SectionHeader
                      icon={Shield}
                      title="Value at Risk 95%"
                      color="#EF4444"
                    />
                    <MetricRow
                      label="1-Day VaR ($)"
                      value={`$${Number(m.var95.varDollar || 0).toFixed(2)}`}
                      accent="#EF4444"
                      mono
                    />
                    <MetricRow
                      label="1-Day VaR (%)"
                      value={`${Number(m.var95.varPct || 0).toFixed(3)}%`}
                      accent="#F87171"
                      mono
                    />
                    <MetricRow
                      label="Daily μ"
                      value={`${Number(m.var95.mu || 0).toFixed(3)}%`}
                      accent="#94A3B8"
                      mono
                    />
                    <MetricRow
                      label="Daily σ"
                      value={`${Number(m.var95.sigma || 0).toFixed(3)}%`}
                      accent="#94A3B8"
                      mono
                    />
                    <FormulaBox
                      formula="VaR₉₅% = μ·Δt + 1.645·σ·√Δt"
                      color="#EF4444"
                    />
                  </div>
                )}

                {m.treynor ? (
                  <div
                    className="rounded-xl p-4"
                    style={{
                      background: "rgba(255,255,255,0.025)",
                      border: "1px solid rgba(255,255,255,0.07)",
                    }}
                  >
                    <SectionHeader
                      icon={TrendingUp}
                      title={`Treynor Ratio vs ${m.treynor.benchmark || "BTC"}`}
                      color="#5B8CFF"
                    />
                    <MetricRow
                      label="Treynor Ratio"
                      value={Number(m.treynor.treynor || 0).toFixed(4)}
                      accent="#5B8CFF"
                      mono
                    />
                    <MetricRow
                      label="Beta (β)"
                      value={Number(m.treynor.beta || 0).toFixed(4)}
                      accent="#8A7CFF"
                      mono
                    />
                    <MetricRow
                      label="Alpha (α)"
                      value={`${Number(m.treynor.alpha || 0).toFixed(3)}%`}
                      accent={m.treynor.alpha > 0 ? "#34D399" : "#F87171"}
                      mono
                    />
                    <p
                      className="text-[10px] mt-2"
                      style={{ color: "#6B7280" }}
                    >
                      {m.treynor.interpretation}
                    </p>
                    <FormulaBox
                      formula="TR = (Rp − Rf) / βp   [Treynor 1965, annualised]"
                      color="#5B8CFF"
                    />
                  </div>
                ) : (
                  <div
                    className="rounded-xl p-4 flex items-center justify-center"
                    style={{
                      background: "rgba(255,255,255,0.02)",
                      border: "1px solid rgba(255,255,255,0.05)",
                    }}
                  >
                    <p
                      className="text-[11px] text-center"
                      style={{ color: "#4A5568" }}
                    >
                      Treynor Ratio unavailable
                      <br />
                      (asset = benchmark or insufficient data)
                    </p>
                  </div>
                )}
              </div>

              {/* ── VOLUME PROFILE ───────────────────────────────────────── */}
              {m.volumeProfile && (
                <div
                  className="rounded-xl p-4"
                  style={{
                    background: "rgba(255,255,255,0.025)",
                    border: "1px solid rgba(255,255,255,0.07)",
                  }}
                >
                  <SectionHeader
                    icon={BarChart3}
                    title="Volume Profile — POC / VAH / VAL"
                    color="#06B6D4"
                  />
                  <div className="grid grid-cols-3 gap-3">
                    {[
                      {
                        label: "POC",
                        sub: "Point of Control",
                        value: m.volumeProfile.poc,
                        accent: "#06B6D4",
                      },
                      {
                        label: "VAH",
                        sub: "Value Area High",
                        value: m.volumeProfile.vah,
                        accent: "#34D399",
                      },
                      {
                        label: "VAL",
                        sub: "Value Area Low",
                        value: m.volumeProfile.val,
                        accent: "#F59E0B",
                      },
                    ].map(({ label, sub, value, accent }) => (
                      <div
                        key={label}
                        className="text-center p-3 rounded-xl"
                        style={{
                          background: `${accent}12`,
                          border: `1px solid ${accent}25`,
                        }}
                      >
                        <div
                          className="text-[10px] font-bold uppercase tracking-widest mb-1"
                          style={{ color: accent }}
                        >
                          {label}
                        </div>
                        <div className="text-[14px] font-black font-mono text-white">
                          $
                          {Number(value || 0).toLocaleString(undefined, {
                            minimumFractionDigits: 2,
                          })}
                        </div>
                        <div
                          className="text-[9px] mt-0.5"
                          style={{ color: "#6B7280" }}
                        >
                          {sub}
                        </div>
                      </div>
                    ))}
                  </div>
                  <div
                    className="mt-2 text-[10px]"
                    style={{ color: "#4A5568" }}
                  >
                    70% of volume captured · POC share:{" "}
                    {m.volumeProfile.pocVolumeShare}%
                  </div>
                </div>
              )}

              {/* ── WALK-FORWARD OVERFIT GRAPH ───────────────────────────── */}
              {wfSegments.length > 0 && (
                <div
                  className="rounded-xl p-4"
                  style={{
                    background: "rgba(255,255,255,0.025)",
                    border: "1px solid rgba(255,255,255,0.07)",
                  }}
                >
                  <div className="flex items-center justify-between mb-3">
                    <SectionHeader
                      icon={Layers}
                      title="Walk-Forward IS vs OOS"
                      color="#8A7CFF"
                    />
                    {overfitWarning && (
                      <span
                        className="text-[9px] font-bold uppercase tracking-widest px-2 py-1 rounded"
                        style={{
                          background: "rgba(239,68,68,0.15)",
                          color: "#EF4444",
                          border: "1px solid rgba(239,68,68,0.3)",
                        }}
                      >
                        DIVERGENCE &gt;15%
                      </span>
                    )}
                  </div>
                  <ResponsiveContainer width="100%" height={180}>
                    <LineChart
                      data={wfSegments}
                      margin={{ top: 4, right: 8, bottom: 0, left: 0 }}
                    >
                      <CartesianGrid
                        strokeDasharray="3 3"
                        stroke="rgba(255,255,255,0.04)"
                      />
                      <XAxis
                        dataKey="window"
                        tick={{ fill: "#4A5568", fontSize: 10 }}
                        tickLine={false}
                        axisLine={false}
                        label={{
                          value: "Window",
                          position: "insideBottom",
                          fill: "#4A5568",
                          fontSize: 10,
                        }}
                      />
                      <YAxis
                        tick={{ fill: "#4A5568", fontSize: 10 }}
                        tickLine={false}
                        axisLine={false}
                        tickFormatter={(v) => `${v}%`}
                        width={42}
                      />
                      <Tooltip
                        contentStyle={{
                          background: "#0A0E14",
                          border: "1px solid rgba(255,255,255,0.1)",
                          borderRadius: 8,
                          fontSize: 11,
                        }}
                        labelStyle={{ color: "#94A3B8" }}
                        formatter={(v, name) => [
                          `${Number(v).toFixed(2)}%`,
                          name,
                        ]}
                      />
                      <Legend
                        wrapperStyle={{ fontSize: 10, color: "#94A3B8" }}
                      />
                      <ReferenceLine
                        y={0}
                        stroke="rgba(255,255,255,0.1)"
                        strokeDasharray="3 3"
                      />
                      <Line
                        type="monotone"
                        dataKey="isReturn"
                        name="In-Sample"
                        stroke="#5B8CFF"
                        strokeWidth={2}
                        dot={{ r: 3, fill: "#5B8CFF" }}
                        activeDot={{ r: 5 }}
                      />
                      <Line
                        type="monotone"
                        dataKey="oosReturn"
                        name="Out-of-Sample"
                        stroke={overfitWarning ? "#EF4444" : "#34D399"}
                        strokeWidth={2}
                        dot={{
                          r: 3,
                          fill: overfitWarning ? "#EF4444" : "#34D399",
                        }}
                        strokeDasharray={overfitWarning ? "5 3" : "0"}
                        activeDot={{ r: 5 }}
                      />
                    </LineChart>
                  </ResponsiveContainer>
                  <p className="text-[10px] mt-2" style={{ color: "#4A5568" }}>
                    IS = parameters fitted on historical data. OOS = performance
                    on unseen future data. Divergence &gt;15% indicates
                    curve-fitting.
                  </p>
                </div>
              )}

              {wfSegments.length === 0 && (
                <div
                  className="rounded-xl p-4 text-center"
                  style={{
                    background: "rgba(255,255,255,0.02)",
                    border: "1px solid rgba(255,255,255,0.05)",
                  }}
                >
                  <Layers
                    size={24}
                    style={{ color: "#1E293B", margin: "0 auto 8px" }}
                  />
                  <p className="text-[11px]" style={{ color: "#4A5568" }}>
                    Walk-forward data not available. Re-create agent with a
                    1-year backtest period to enable overfit detection graph.
                  </p>
                </div>
              )}

              {/* Spacer at bottom */}
              <div style={{ height: 32 }} />
            </div>
          )}
        </div>

        {/* Footer — Export Button */}
        <div
          className="flex-shrink-0 px-5 py-4"
          style={{
            borderTop: "1px solid rgba(255,255,255,0.07)",
            background: "rgba(0,0,0,0.3)",
          }}
        >
          <SovereignButton
            purpose="export"
            size="md"
            onClick={() => setShowExport(true)}
            disabled={loading && !agentData}
            className="w-full"
            style={{ justifyContent: "center" }}
          >
            EXPORT AGENT BLUEPRINT
          </SovereignButton>
        </div>
      </div>

      {/* ── EXPORT MODAL ──────────────────────────────────────────────────── */}
      {showExport && (
        <>
          <div
            className="fixed inset-0 z-60"
            style={{
              background: "rgba(0,0,0,0.75)",
              backdropFilter: "blur(8px)",
            }}
            onClick={() => setShowExport(false)}
          />
          <div
            className="fixed inset-0 z-60 flex items-center justify-center p-4"
            onClick={() => setShowExport(false)}
          >
            <div
              className="rounded-2xl w-full overflow-hidden"
              style={{
                maxWidth: 640,
                background: "rgba(8,11,16,0.98)",
                border: "1px solid rgba(255,255,255,0.1)",
                boxShadow: "0 40px 100px rgba(0,0,0,0.8)",
              }}
              onClick={(e) => e.stopPropagation()}
            >
              {/* Modal Header */}
              <div
                className="flex items-center justify-between px-6 py-4"
                style={{ borderBottom: "1px solid rgba(255,255,255,0.07)" }}
              >
                <div className="flex items-center gap-3">
                  <Download size={18} style={{ color: "#5B8CFF" }} />
                  <div>
                    <h3 className="text-[14px] font-black text-white">
                      Export Agent Blueprint
                    </h3>
                    <p
                      className="text-[11px] mt-0.5"
                      style={{ color: "#8B9EB5" }}
                    >
                      JSON config + TradingView Pine Script skeleton
                    </p>
                  </div>
                </div>
                <button
                  onClick={() => setShowExport(false)}
                  className="w-8 h-8 rounded-lg flex items-center justify-center hover:bg-white/10 transition-all"
                >
                  <X size={14} style={{ color: "#8B9EB5" }} />
                </button>
              </div>

              {/* Tab Toggle */}
              <div
                className="flex gap-1 px-4 pt-4"
                style={{ borderBottom: "1px solid rgba(255,255,255,0.06)" }}
              >
                {[
                  { id: "json", label: "JSON Blueprint" },
                  { id: "pine", label: "Pine Script v5" },
                ].map((tab) => (
                  <button
                    key={tab.id}
                    onClick={() => setExportTab(tab.id)}
                    className="px-4 py-2 rounded-t-lg text-[12px] font-bold transition-all"
                    style={{
                      background:
                        exportTab === tab.id
                          ? "rgba(91,140,255,0.15)"
                          : "transparent",
                      color: exportTab === tab.id ? "#5B8CFF" : "#8B9EB5",
                      borderBottom:
                        exportTab === tab.id
                          ? "2px solid #5B8CFF"
                          : "2px solid transparent",
                    }}
                  >
                    {tab.label}
                  </button>
                ))}
              </div>

              {/* Code Area */}
              <div className="px-4 py-4">
                <div
                  className="relative rounded-xl overflow-auto"
                  style={{
                    background: "rgba(0,0,0,0.6)",
                    border: "1px solid rgba(255,255,255,0.07)",
                    maxHeight: 340,
                  }}
                >
                  <pre
                    className="text-[10px] font-mono p-4 leading-relaxed"
                    style={{
                      color: "#94A3B8",
                      whiteSpace: "pre-wrap",
                      wordBreak: "break-word",
                    }}
                  >
                    {exportTab === "json" ? jsonBlueprint : pineScript}
                  </pre>
                </div>
              </div>

              {/* Action Row */}
              <div className="flex gap-3 px-4 pb-5">
                <button
                  onClick={() =>
                    exportTab === "json"
                      ? jsonCopy.copy(jsonBlueprint)
                      : pineCopy.copy(pineScript)
                  }
                  className="flex items-center gap-2 flex-1 justify-center py-3 rounded-xl text-[13px] font-bold transition-all hover:scale-[1.02]"
                  style={{
                    background: "rgba(91,140,255,0.15)",
                    border: "1px solid rgba(91,140,255,0.3)",
                    color: "#5B8CFF",
                  }}
                >
                  {(
                    exportTab === "json"
                      ? jsonCopy.copied
                      : pineCopy.copied
                  ) ? (
                    <>
                      <CheckCircle size={14} /> Copied!
                    </>
                  ) : (
                    <>
                      <Copy size={14} /> Copy to Clipboard
                    </>
                  )}
                </button>
                <button
                  onClick={() => {
                    const content =
                      exportTab === "json" ? jsonBlueprint : pineScript;
                    const ext = exportTab === "json" ? "json" : "pine";
                    const filename = `${agentName.replace(/\s+/g, "_")}_blueprint.${ext}`;
                    const blob = new Blob([content], { type: "text/plain" });
                    const a = document.createElement("a");
                    a.href = URL.createObjectURL(blob);
                    a.download = filename;
                    a.click();
                    URL.revokeObjectURL(a.href);
                  }}
                  className="flex items-center gap-2 flex-1 justify-center py-3 rounded-xl text-[13px] font-bold transition-all hover:scale-[1.02]"
                  style={{
                    background: "#FFFFFF",
                    color: "#000000",
                  }}
                >
                  <Download size={14} />
                  Download File
                </button>
              </div>
            </div>
          </div>
        </>
      )}

      <style jsx global>{`
        @keyframes terminalSlideIn {
          from { transform: translateX(100%); opacity: 0; }
          to   { transform: translateX(0);    opacity: 1; }
        }
        @keyframes terminalSpin {
          from { transform: rotate(0deg);   }
          to   { transform: rotate(360deg); }
        }
        @keyframes terminalPulse {
          0%, 100% { opacity: 1;   }
          50%       { opacity: 0.7; }
        }
      `}</style>
    </>
  );
}



