// ── Pine Script Generator ─────────────────────────────────────────────────────
function generatePineScript(agentName, strategy, metrics) {
  const asset = (strategy?.asset || "BTC").toUpperCase();
  const stopLoss = strategy?.risk_rules?.stop_loss_pct ?? 2;
  const takeProfit = strategy?.risk_rules?.take_profit_pct ?? 5;
  const entryLines = (
    strategy?.entry_conditions || ["Price cross above 50-day MA"]
  )
    .map((c) => `// ENTRY: ${c}`)
    .join("\n");
  const exitLines = (
    strategy?.exit_conditions || ["RSI > 70", "Stop loss triggered"]
  )
    .map((c) => `// EXIT: ${c}`)
    .join("\n");

  const hurstH =
    typeof metrics?.hurst?.H === "number" ? metrics.hurst.H : "N/A";
  const mcMu = metrics?.monteCarlo?.mu ?? 0;
  const mcSigma = metrics?.monteCarlo?.sigma ?? 0;

  return `//@version=5
strategy(
  title       = "${agentName} — Quvanti Labs Export",
  overlay     = true,
  default_qty_type  = strategy.percent_of_equity,
  default_qty_value = 10,
  initial_capital   = 10000,
  commission_type   = strategy.commission.percent,
  commission_value  = 0.1
)

// ── Quvanti Labs — Agent Blueprint Export ──────────────────────────────────────
// Asset   : ${asset}
// Exported: ${new Date().toISOString()}
// Source  : quvantilabs.com
//
// Quantitative Parameters (from live analysis):
//   Hurst Exponent (H) = ${hurstH}   [H > 0.55 = trending, H < 0.45 = mean-reverting]
//   Annualised μ (drift) = ${mcMu}%
//   Annualised σ (vol)   = ${mcSigma}%
//   Stop Loss            = ${stopLoss}%
//   Take Profit          = ${takeProfit}%

// ── Indicators ─────────────────────────────────────────────────────────────────
rsiLen    = input.int(14, "RSI Length", minval=2)
smaFast   = input.int(50, "Fast SMA", minval=1)
smaSlow   = input.int(200, "Slow SMA", minval=1)
bbLen     = input.int(20, "Bollinger Length", minval=2)
bbMult    = input.float(2.0, "Bollinger StdDev", minval=0.1, step=0.1)

rsi14   = ta.rsi(close, rsiLen)
sma50   = ta.sma(close, smaFast)
sma200  = ta.sma(close, smaSlow)
[bbMid, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)

plot(sma50,   "SMA Fast",  color=color.new(color.blue, 30),   linewidth=1)
plot(sma200,  "SMA Slow",  color=color.new(color.orange, 30), linewidth=2)
plot(bbUpper, "BB Upper",  color=color.new(color.gray, 60),   linewidth=1)
plot(bbLower, "BB Lower",  color=color.new(color.gray, 60),   linewidth=1)

// ── Entry Conditions ───────────────────────────────────────────────────────────
${entryLines}
entrySignal = ta.crossover(sma50, sma200) and rsi14 < 70

// ── Exit Conditions ────────────────────────────────────────────────────────────
${exitLines}
exitSignal  = ta.crossunder(sma50, sma200) or rsi14 > 75

// ── Risk Management ────────────────────────────────────────────────────────────
slPct = ${stopLoss} / 100.0
tpPct = ${takeProfit} / 100.0

// ── Execution ──────────────────────────────────────────────────────────────────
if entrySignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="QV Entry")
    strategy.exit(
      "TP/SL", "Long",
      profit = close * tpPct / syminfo.mintick,
      loss   = close * slPct / syminfo.mintick
    )

if exitSignal and strategy.position_size > 0
    strategy.close("Long", comment="QV Exit")

// ── Labels ─────────────────────────────────────────────────────────────────────
bgcolor(entrySignal ? color.new(color.green, 90) : na, title="Entry Signal")
bgcolor(exitSignal  ? color.new(color.red,   90) : na, title="Exit Signal")`;
}

// ── JSON Blueprint Generator ──────────────────────────────────────────────────
function generateJSON(agentId, agentName, strategy, metrics, backtestSummary) {
  return JSON.stringify(
    {
      meta: {
        source: "Quvanti Labs — quvantilabs.com",
        exportedAt: new Date().toISOString(),
        agentId,
        agentName,
        version: "1.0",
      },
      strategy: {
        asset: strategy?.asset || "BTC",
        entryConditions: strategy?.entry_conditions || [],
        exitConditions: strategy?.exit_conditions || [],
        riskRules: strategy?.risk_rules || {},
      },
      quantMetrics: {
        hurstExponent: {
          H: metrics?.hurst?.H,
          regime: metrics?.hurst?.category,
          interpretation: metrics?.hurst?.interpretation,
        },
        monteCarlo: {
          annualisedMu_pct: metrics?.monteCarlo?.mu,
          annualisedSigma_pct: metrics?.monteCarlo?.sigma,
          probabilityOfRuin_pct: metrics?.monteCarlo?.probabilityOfRuin,
          medianReturn_pct: metrics?.monteCarlo?.medianReturn,
          paths: metrics?.monteCarlo?.paths,
        },
        fracDiff: {
          d: 0.4,
          weights: metrics?.fracDiff?.weights,
        },
        var95: {
          varPct: metrics?.var95?.varPct,
          varDollar: metrics?.var95?.varDollar,
          confidence: 95,
        },
        treynorRatio: {
          value: metrics?.treynor?.treynor,
          beta: metrics?.treynor?.beta,
          alpha_pct: metrics?.treynor?.alpha,
          benchmark: metrics?.treynor?.benchmark,
        },
        volumeProfile: {
          poc: metrics?.volumeProfile?.poc,
          vah: metrics?.volumeProfile?.vah,
          val: metrics?.volumeProfile?.val,
        },
      },
      backtestSummary: backtestSummary || null,
    },
    null,
    2,
  );
}

