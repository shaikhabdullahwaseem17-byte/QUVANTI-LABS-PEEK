"use client";

import { useState, useEffect, useRef } from "react";
import {
  LogOut,
  Menu,
  X,
  Crown,
  Zap,
  Activity,
  TrendingUp,
  Cpu,
  BarChart3,
  Sparkles,
  Link2,
  BookOpen,
  Bot,
  AlertTriangle,
} from "lucide-react";
import useUser from "@/utils/useUser";
import { useOmniStore } from "@/store/useOmniStore";
import AnimatedIcon from "@/components/AnimatedIcon";

const NAV_LINKS = [
  { label: "Dashboard", href: "/dashboard", icon: null },
  { label: "My Agents", href: "/agents", icon: Bot },
  { label: "Signals", href: "/signals", icon: Activity, dot: true },
  { label: "Paper Trade", href: "/paper-trading", icon: TrendingUp },
  { label: "Strategy Lab", href: "/strategy-lab", icon: Sparkles },
  { label: "Quant Engine", href: "/quant-engine", icon: Cpu },
  { label: "Analytics", href: "/analytics", icon: BarChart3 },
  { label: "Broker", href: "/settings/broker", icon: Link2 },
  { label: "Features", href: "/features", icon: BookOpen },
];

const TICKER_MESSAGES = [
  "ENGINE_STATUS: STABLE",
  "HURST_DETECTOR: ACTIVE",
  "LATENCY: 12ms",
  "BAYESIAN_BIAS: 0.52",
  "MONTE_CARLO: READY",
  "FRAC_DIFF: CALIBRATED",
  "SIGNAL_FEED: LIVE",
  "RISK_ENGINE: NOMINAL",
];

export default function AppNav() {
  const { data: user } = useUser();
  const [showMobile, setShowMobile] = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [isPro, setIsPro] = useState(false);
  const [activePath, setActivePath] = useState("");
  const navRef = useRef(null);

  // Read global execution mode from OmniStore for persistent indicator
  const executionMode = useOmniStore((s) => s.executionMode);

  useEffect(() => {
    if (typeof window !== "undefined") {
      setActivePath(window.location.pathname);
    }
  }, []);

  useEffect(() => {
    const onScroll = () => setScrolled(window.scrollY > 8);
    window.addEventListener("scroll", onScroll, { passive: true });
    return () => window.removeEventListener("scroll", onScroll);
  }, []);

  useEffect(() => {
    if (!user) return;
    fetch("/api/subscription/status")
      .then((r) => (r.ok ? r.json() : null))
      .then(
        (d) => d && setIsPro(d.tier === "pro" && d.license_status === "active"),
      )
      .catch(() => {});
  }, [user]);

  useEffect(() => {
    const close = (e) => {
      if (navRef.current && !navRef.current.contains(e.target)) {
        setShowMobile(false);
      }
    };
    document.addEventListener("mousedown", close);
    return () => document.removeEventListener("mousedown", close);
  }, []);

  const isActive = (href) =>
    activePath === href || activePath.startsWith(href + "/");

  // Execution mode pill — shown in nav when user is logged in
  const ModePill = () => {
    if (!user) return null;
    const isLive = executionMode === "live";
    return (
      <a
        href="/settings/broker"
        title={
          isLive
            ? "LIVE MODE — Click to manage broker settings"
            : "Paper mode active — Click to manage broker settings"
        }
        style={{
          display: "inline-flex",
          alignItems: "center",
          gap: "6px",
          padding: "4px 10px",
          borderRadius: "6px",
          background: isLive ? "rgba(239,68,68,0.12)" : "rgba(91,140,255,0.1)",
          border: `1px solid ${isLive ? "rgba(239,68,68,0.35)" : "rgba(91,140,255,0.25)"}`,
          textDecoration: "none",
          flexShrink: 0,
          transition: "all 0.2s",
        }}
      >
        <div
          style={{
            width: "6px",
            height: "6px",
            borderRadius: "50%",
            background: isLive ? "#ef4444" : "#5B8CFF",
            boxShadow: isLive ? "0 0 6px #ef4444" : "0 0 6px #5B8CFF",
            flexShrink: 0,
            animation: isLive ? "modePulse 1.5s ease-in-out infinite" : "none",
          }}
        />
        <span
          style={{
            fontSize: "9px",
            fontWeight: 800,
            color: isLive ? "#ef4444" : "#5B8CFF",
            letterSpacing: "0.12em",
            fontFamily: "monospace",
          }}
        >
          {isLive ? "LIVE" : "PAPER"}
        </span>
        {isLive && <AlertTriangle size={9} style={{ color: "#ef4444" }} />}
      </a>
    );
  };

  return (
    <nav
      ref={navRef}
      className={`sticky top-0 z-50 transition-all duration-300 ${
        scrolled
          ? "bg-[rgba(8,11,16,0.92)] backdrop-blur-2xl border-b border-white/[0.06] shadow-[0_8px_32px_rgba(0,0,0,0.5)]"
          : "bg-[rgba(8,11,16,0.7)] backdrop-blur-xl border-b border-white/[0.04]"
      }`}
    >
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex items-center justify-between h-[60px]">
          {/* ── LOGO ──────────────────────────────────────────── */}
          <a href="/" className="group flex items-center gap-3 select-none">
            <div className="relative flex-shrink-0">
              <div className="absolute inset-0 rounded-full bg-white/10 blur-md scale-110 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <img
                src="https://ucarecdn.com/d39e423f-56fe-46e4-b20b-04ba0efd4bdc/-/format/auto/"
                alt="Quvanti Labs"
                className="relative w-9 h-9 rounded-full object-cover border border-white/10"
              />
            </div>
            <div className="hidden sm:block">
              <span
                className="text-[15px] font-bold text-white leading-none"
                style={{
                  fontFamily:
                    "'Satoshi', -apple-system, 'Helvetica Neue', sans-serif",
                  letterSpacing: "-0.03em",
                }}
              >
                Quvanti Labs
              </span>
              <div
                className="text-[9px] font-medium tracking-[0.14em] uppercase mt-0.5 leading-none"
                style={{
                  color: "rgba(255,255,255,0.3)",
                  fontFamily:
                    "'Satoshi', -apple-system, 'Helvetica Neue', sans-serif",
                }}
              >
                Telemetry Protocol
              </div>
            </div>
          </a>

          {/* ── DESKTOP NAV ───────────────────────────────────── */}
          <div className="hidden md:flex items-center gap-1">
            {user ? (
              <>
                {NAV_LINKS.map(({ label, href, icon: Icon, dot }) => (
                  <a
                    key={href}
                    href={href}
                    className={`relative flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[13px] font-medium transition-all duration-200 group ${
                      isActive(href)
                        ? "text-white bg-white/[0.08]"
                        : "text-[#8B9EB5] hover:text-white hover:bg-white/[0.05]"
                    }`}
                  >
                    {Icon && (
                      <AnimatedIcon
                        icon={Icon}
                        size={13}
                        variant={isActive(href) ? "nav" : "spring"}
                        active={isActive(href)}
                        color={isActive(href) ? "#ffffff" : "#5B8CFF"}
                        className={
                          isActive(href)
                            ? ""
                            : "group-hover:text-white transition-colors"
                        }
                      />
                    )}
                    {label}
                    {dot && (
                      <AnimatedIcon
                        icon={Activity}
                        size={6}
                        variant="live"
                        pulsing
                        className="ml-0.5"
                        style={{ color: "#34d399" }}
                      />
                    )}
                    {isActive(href) && (
                      <span className="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-0.5 rounded-full bg-[#5B8CFF] opacity-80" />
                    )}
                  </a>
                ))}

                {isPro && (
                  <a
                    href="/pro-dashboard"
                    className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[13px] font-medium text-amber-400/90 hover:text-amber-300 hover:bg-amber-400/[0.06] transition-all duration-200"
                  >
                    <AnimatedIcon
                      icon={Crown}
                      size={13}
                      variant="shimmer"
                      color="#f59e0b"
                    />
                    PRO
                  </a>
                )}

                <div className="w-px h-5 bg-white/[0.07] mx-1" />

                {/* ── PERSISTENT EXECUTION MODE PILL ── */}
                <ModePill />

                <div className="w-px h-5 bg-white/[0.07] mx-1" />

                {!isPro && (
                  <a
                    href="/upgrade"
                    className="relative flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-[13px] font-semibold overflow-hidden transition-all duration-200 hover:scale-[1.03]"
                    style={{
                      background: "rgba(255,255,255,0.08)",
                      border: "1px solid rgba(255,255,255,0.14)",
                      color: "#ffffff",
                    }}
                  >
                    <AnimatedIcon
                      icon={Zap}
                      size={12}
                      variant="charge"
                      active
                      color="#ffffff"
                    />
                    <span style={{ color: "#ffffff" }}>Upgrade</span>
                  </a>
                )}

                <a
                  href="/account/logout"
                  className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[13px] font-medium text-[#8B9EB5] hover:text-white hover:bg-white/[0.05] transition-all duration-200"
                >
                  <AnimatedIcon icon={LogOut} size={13} variant="spring" />
                </a>
              </>
            ) : (
              <>
                <a
                  href="/demo"
                  className="px-3 py-1.5 rounded-lg text-[13px] font-medium text-[#8B9EB5] hover:text-white hover:bg-white/[0.05] transition-all"
                >
                  Demo
                </a>
                <a
                  href="/account/signin"
                  className="px-3 py-1.5 rounded-lg text-[13px] font-medium text-[#8B9EB5] hover:text-white hover:bg-white/[0.05] transition-all"
                >
                  Sign In
                </a>

                {/* Desktop unauthenticated state */}
                <a
                  href="/account/signup"
                  className="relative flex items-center gap-1.5 px-5 py-2 rounded-lg text-[13px] font-bold overflow-hidden transition-all hover:scale-[1.04] hover:shadow-[0_4px_20px_rgba(255,255,255,0.15)]"
                  style={{
                    background: "#ffffff",
                    color: "#080B10",
                    boxShadow: "0 2px 12px rgba(255,255,255,0.12)",
                  }}
                >
                  <span
                    className="relative"
                    style={{ color: "#080B10", fontWeight: 700 }}
                  >
                    Get Started Free
                  </span>
                </a>
              </>
            )}
          </div>

          {/* ── MOBILE TRIGGER ────────────────────────────────── */}
          <div className="md:hidden flex items-center gap-2">
            {/* Mode pill on mobile too */}
            <ModePill />
            <button
              onClick={() => setShowMobile(!showMobile)}
              className="flex items-center justify-center w-9 h-9 rounded-lg bg-white/[0.05] border border-white/[0.07] text-[#8B9EB5] hover:text-white transition-all"
            >
              {showMobile ? <X size={18} /> : <Menu size={18} />}
            </button>
          </div>
        </div>
      </div>

      {/* STATUS TICKER STRIP */}
      <div
        className="w-full overflow-hidden border-t border-white/[0.04]"
        style={{
          background: "rgba(255, 255, 255, 0.02)",
          backdropFilter: "blur(10px)",
          WebkitBackdropFilter: "blur(10px)",
          height: "26px",
        }}
      >
        <div
          className="ticker-track flex items-center h-full"
          style={{ width: "max-content" }}
        >
          {[...TICKER_MESSAGES, ...TICKER_MESSAGES, ...TICKER_MESSAGES].map(
            (msg, i) => (
              <span
                key={i}
                className="flex items-center gap-2 px-8 whitespace-nowrap"
              >
                <span
                  className="w-1.5 h-1.5 rounded-full flex-shrink-0"
                  style={{
                    background: "#22c55e",
                    boxShadow: "0 0 6px #22c55e",
                  }}
                />
                <span
                  className="text-[10px] tracking-[0.15em]"
                  style={{
                    color: "#F8FAFC",
                    opacity: 0.5,
                    fontFamily:
                      "'Satoshi', -apple-system, 'Helvetica Neue', sans-serif",
                    fontWeight: 500,
                  }}
                >
                  {msg}
                </span>
              </span>
            ),
          )}
        </div>
      </div>

      {/* ── MOBILE MENU ───────────────────────────────────────── */}
      {showMobile && (
        <div className="md:hidden border-t border-white/[0.06] bg-[rgba(8,11,16,0.97)] backdrop-blur-2xl">
          <div className="max-w-7xl mx-auto px-4 py-4 space-y-1">
            {user ? (
              <>
                {NAV_LINKS.map(({ label, href, icon: Icon, dot }) => (
                  <a
                    key={href}
                    href={href}
                    className={`flex items-center gap-3 px-4 py-3 rounded-xl text-[14px] font-medium transition-all ${
                      isActive(href)
                        ? "bg-white/[0.08] text-white"
                        : "text-[#8B9EB5] hover:text-white hover:bg-white/[0.04]"
                    }`}
                  >
                    {Icon && (
                      <AnimatedIcon
                        icon={Icon}
                        size={15}
                        variant={isActive(href) ? "nav" : "spring"}
                        active={isActive(href)}
                        color={
                          isActive(href) ? "#5B8CFF" : "rgba(91,140,255,0.6)"
                        }
                      />
                    )}
                    {label}
                    {dot && (
                      <span className="ml-auto w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
                    )}
                  </a>
                ))}

                {isPro && (
                  <a
                    href="/pro-dashboard"
                    className="flex items-center gap-3 px-4 py-3 rounded-xl text-[14px] font-medium text-amber-400 hover:bg-amber-400/[0.06] transition-all"
                  >
                    <AnimatedIcon
                      icon={Crown}
                      size={15}
                      variant="shimmer"
                      color="#f59e0b"
                    />{" "}
                    PRO Dashboard
                  </a>
                )}

                <div className="pt-2 border-t border-white/[0.06] space-y-1">
                  {!isPro && (
                    <a
                      href="/upgrade"
                      className="flex items-center gap-3 px-4 py-3 rounded-xl text-[14px] font-semibold transition-all"
                      style={{
                        background: "rgba(255,255,255,0.07)",
                        border: "1px solid rgba(255,255,255,0.12)",
                        color: "#ffffff",
                      }}
                    >
                      <AnimatedIcon
                        icon={Zap}
                        size={15}
                        variant="charge"
                        active
                        color="#ffffff"
                      />{" "}
                      Upgrade to Pro
                    </a>
                  )}
                  <a
                    href="/account/logout"
                    className="flex items-center gap-3 px-4 py-3 rounded-xl text-[14px] font-medium text-[#8B9EB5] hover:text-white hover:bg-white/[0.04] transition-all"
                  >
                    <AnimatedIcon icon={LogOut} size={15} variant="spring" />{" "}
                    Sign Out
                  </a>
                </div>
              </>
            ) : (
              <>
                <a
                  href="/demo"
                  className="block px-4 py-3 rounded-xl text-[14px] font-medium text-[#8B9EB5] hover:text-white hover:bg-white/[0.04] transition-all"
                >
                  Demo
                </a>
                <a
                  href="/account/signin"
                  className="block px-4 py-3 rounded-xl text-[14px] font-medium text-[#8B9EB5] hover:text-white hover:bg-white/[0.04] transition-all"
                >
                  Sign In
                </a>

                {/* Mobile "Get Started Free" */}
                <a
                  href="/account/signup"
                  className="block px-4 py-3 rounded-xl text-[14px] font-bold text-center transition-all hover:opacity-90"
                  style={{
                    background: "#ffffff",
                    color: "#080B10",
                  }}
                >
                  <span style={{ color: "#080B10", fontWeight: 700 }}>
                    Get Started Free
                  </span>
                </a>

                {/* Mobile "Upgrade to Pro" */}
                <a
                  href="/upgrade"
                  className="flex items-center gap-3 px-4 py-3 rounded-xl text-[14px] font-semibold text-white transition-all"
                  style={{
                    background: "rgba(255,255,255,0.07)",
                    border: "1px solid rgba(255,255,255,0.12)",
                  }}
                >
                  <AnimatedIcon
                    icon={Zap}
                    size={15}
                    variant="charge"
                    active
                    color="#ffffff"
                  />{" "}
                  Upgrade to Pro
                </a>
              </>
            )}
          </div>
        </div>
      )}

      <style jsx global>{`
        @keyframes ticker-scroll {
          0%   { transform: translateX(0); }
          100% { transform: translateX(-33.333%); }
        }
        .ticker-track {
          animation: ticker-scroll 28s linear infinite;
        }
        .ticker-track:hover {
          animation-play-state: paused;
        }
        @keyframes modePulse {
          0%, 100% { opacity: 1; box-shadow: 0 0 6px #ef4444; }
          50%       { opacity: 0.6; box-shadow: 0 0 12px #ef4444; }
        }
      `}</style>
    </nav>
  );
}



