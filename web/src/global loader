"use client";

/**
 * GlobalLoader — Quvanti Labs
 *
 * Full-screen obsidian overlay that fires on every page mount.
 * Displays the Quvanti logo with an angled 11 o'clock light-beam sweep.
 *
 * Lifecycle:
 *   1. Mounts immediately — blocks interaction with z-index 9999
 *   2. Waits for window "load" event (all assets resolved)
 *   3. Fades out over 600ms then unmounts from the DOM
 *
 * The beam:
 *   - Positioned via ::after pseudo-element (injected via <style> tag
 *     since pseudo-elements aren't reachable via inline React style)
 *   - Enters from top-left at -45deg skew (the "11 o'clock" angle)
 *   - Sweeps fully across the logo container continuously at 1.8s cycle
 *
 * Logo URL: reuses the existing Quvanti cdn asset baked into layout.jsx
 */

import { useState, useEffect } from "react";

// The exact logo CDN url used across the platform (from layout.jsx / AppNav.jsx)
const LOGO_URL =
  "https://ucarecdn.com/d39e423f-56fe-46e4-b20b-04ba0efd4bdc/-/format/auto/";

export default function GlobalLoader() {
  const [phase, setPhase] = useState("visible"); // "visible" | "fading" | "gone"

  useEffect(() => {
    // Already loaded before React hydrated
    if (document.readyState === "complete") {
      startFade();
      return;
    }

    // Wait for the full page load (fonts, images, scripts)
    const handleLoad = () => startFade();
    window.addEventListener("load", handleLoad, { once: true });

    // Hard-cap: even if load never fires (SSR / slow assets), dismiss after 3.5s
    const hardCap = setTimeout(startFade, 3500);

    return () => {
      window.removeEventListener("load", handleLoad);
      clearTimeout(hardCap);
    };
  }, []);

  function startFade() {
    setPhase("fading");
    setTimeout(() => setPhase("gone"), 650);
  }

  if (phase === "gone") return null;

  return (
    <>
      {/* ── OVERLAY ──────────────────────────────────────────────── */}
      <div
        aria-hidden="true"
        style={{
          position: "fixed",
          inset: 0,
          zIndex: 9999,
          background: "#000000",
          display: "flex",
          flexDirection: "column",
          alignItems: "center",
          justifyContent: "center",
          gap: "32px",
          transition: "opacity 0.65s cubic-bezier(0.4, 0, 0.2, 1)",
          opacity: phase === "fading" ? 0 : 1,
          pointerEvents: phase === "fading" ? "none" : "all",
          // Subtle diagonal smoke consistent with InternalLayout gradient
          backgroundImage:
            "linear-gradient(135deg, rgba(255,255,255,0.04) 0%, rgba(148,163,184,0.015) 20%, #000000 65%)",
        }}
      >
        {/* ── LOGO CONTAINER WITH SWEEP ─────────────────────────── */}
        <div
          className="qv-logo-sweep"
          style={{
            position: "relative",
            width: "120px",
            height: "120px",
            borderRadius: "50%",
            overflow: "hidden",
            // Subtle ring
            boxShadow:
              "0 0 0 1px rgba(255,255,255,0.08), 0 0 60px rgba(255,255,255,0.04)",
          }}
        >
          <img
            src={LOGO_URL}
            alt="Quvanti Labs"
            style={{
              width: "100%",
              height: "100%",
              objectFit: "cover",
              display: "block",
              opacity: 0.88,
            }}
          />
        </div>

        {/* ── WORDMARK ─────────────────────────────────────────────── */}
        <div style={{ textAlign: "center" }}>
          <p
            style={{
              margin: 0,
              fontSize: "18px",
              fontWeight: 700,
              letterSpacing: "-0.04em",
              color: "#F8FAFC",
              fontFamily:
                "'Satoshi', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif",
            }}
          >
            Quvanti Labs
          </p>
          <p
            style={{
              margin: "4px 0 0",
              fontSize: "10px",
              fontWeight: 600,
              letterSpacing: "0.18em",
              textTransform: "uppercase",
              color: "#5B8CFF",
              fontFamily:
                "'Satoshi', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif",
            }}
          >
            AI Trading Terminal
          </p>
        </div>

        {/* ── STATUS LINE ─────────────────────────────────────────── */}
        <div
          style={{
            position: "absolute",
            bottom: "48px",
            left: "50%",
            transform: "translateX(-50%)",
            display: "flex",
            alignItems: "center",
            gap: "10px",
          }}
        >
          {/* Pulsing dot */}
          <span
            style={{
              display: "inline-block",
              width: "6px",
              height: "6px",
              borderRadius: "50%",
              background: "#22c55e",
              boxShadow: "0 0 8px #22c55e",
              animation: "qvPulse 1.4s ease-in-out infinite",
            }}
          />
          <span
            style={{
              fontSize: "10px",
              fontWeight: 600,
              letterSpacing: "0.20em",
              textTransform: "uppercase",
              color: "rgba(226,232,240,0.45)",
              fontFamily: "monospace",
            }}
          >
            Initializing Core…
          </span>
        </div>

        {/* ── THIN PROGRESS BAR ────────────────────────────────────── */}
        <div
          style={{
            position: "absolute",
            bottom: 0,
            left: 0,
            right: 0,
            height: "2px",
            background: "rgba(255,255,255,0.04)",
            overflow: "hidden",
          }}
        >
          <div
            style={{
              height: "100%",
              background: "linear-gradient(90deg, #5B8CFF, #8A7CFF, #5B8CFF)",
              backgroundSize: "200% 100%",
              animation:
                "qvProgress 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite",
            }}
          />
        </div>
      </div>

      {/* ── ANIMATION KEYFRAMES ─────────────────────────────────── */}
      <style>{`
        /* ── 11 O'CLOCK VOLUMETRIC BEAM SWEEP ──────────────────────
           The ::after pseudo-element sits above the logo image.
           skewX(-45deg) tilts the beam's entry point to ~11 o'clock.
           It sweeps left → right in 1.8s, then repeats.
        ───────────────────────────────────────────────────────────── */
        .qv-logo-sweep::after {
          content: '';
          position: absolute;
          top: 0;
          left: -150%;
          width: 50%;
          height: 100%;
          background: linear-gradient(
            to right,
            rgba(255, 255, 255, 0)    0%,
            rgba(255, 255, 255, 0.42) 50%,
            rgba(255, 255, 255, 0)    100%
          );
          transform: skewX(-45deg);
          animation: sweep11 1.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
          pointer-events: none;
          z-index: 2;
        }

        @keyframes sweep11 {
          0%   { left: -150%; }
          100% { left: 200%;  }
        }

        /* ── PULSING STATUS DOT ─────────────────────────────────── */
        @keyframes qvPulse {
          0%, 100% { opacity: 1;   transform: scale(1);    }
          50%       { opacity: 0.5; transform: scale(0.85); }
        }

        /* ── PROGRESS BAR SHIMMER ───────────────────────────────── */
        @keyframes qvProgress {
          0%   { width: 0%;    background-position: 0% 0;    }
          70%  { width: 90%;   background-position: 100% 0;  }
          100% { width: 100%;  background-position: 200% 0;  }
        }
      `}</style>
    </>
  );
}



