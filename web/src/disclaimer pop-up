                      service at your own risk.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            {/* Practice recommendation */}
            <div className="bg-gradient-to-r from-green-500/10 to-cyan-500/10 border border-green-500/30 rounded-xl p-4 sm:p-5">
              <div className="flex items-start gap-3 sm:gap-4">
                <div className="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center flex-shrink-0">
                  <svg
                    className="text-green-400"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="2"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 16v-4M12 8h.01" />
                  </svg>
                </div>
                <div>
                  <h4 className="text-white font-semibold mb-1 sm:mb-2 text-sm sm:text-base">
                    We Recommend Paper Trading
                  </h4>
                  <p className="text-gray-300 text-xs sm:text-sm leading-relaxed">
                    Practice with simulated money before considering real
                    investments. Learn the concepts, test strategies, and build
                    confidence safely.
                  </p>
                </div>
              </div>
            </div>
          </div>

          {/* Footer with acceptance - MOBILE OPTIMIZED */}
          <div className="px-4 sm:px-8 py-4 sm:py-6 bg-[#0A0E14] border-t border-[#2a3441]">
            <label className="flex items-start gap-3 sm:gap-4 cursor-pointer group mb-4">
              <input
                type="checkbox"
                checked={accepted}
                onChange={(e) => setAccepted(e.target.checked)}
                className="mt-1 w-5 h-5 sm:w-6 sm:h-6 flex-shrink-0 cursor-pointer accent-cyan-500 rounded"
              />
              <span className="text-gray-300 text-xs sm:text-sm leading-relaxed">
                I understand this is{" "}
                <strong className="text-white">
                  educational software only
                </strong>
                . I will practice with paper trading and consult a licensed
                professional before any real investments. I acknowledge Quvanti
                Labs is not liable for any losses.
              </span>
            </label>

            <button
              onClick={handleAccept}
              disabled={!accepted}
              className={`w-full py-3 sm:py-4 px-4 sm:px-6 rounded-xl font-semibold text-sm sm:text-base transition-all duration-300 ${
                accepted
                  ? "bg-gradient-to-r from-cyan-600 to-purple-600 hover:from-cyan-500 hover:to-purple-500 text-white shadow-lg shadow-cyan-500/25 transform hover:scale-[1.02]"
                  : "bg-gray-800 text-gray-500 cursor-not-allowed"
              }`}
            >
              {accepted
                ? "I Understand — Continue to Quvanti"
                : "Please accept to continue"}
            </button>

            <p className="text-gray-500 text-xs text-center mt-3 sm:mt-4">
              By continuing, you agree to our{" "}
              <a
                href="/terms"
                className="text-cyan-400 hover:text-cyan-300 transition-colors"
              >
                Terms of Service
              </a>{" "}
              and{" "}
              <a
                href="/privacy"
                className="text-cyan-400 hover:text-cyan-300 transition-colors"
              >
                Privacy Policy
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  );
