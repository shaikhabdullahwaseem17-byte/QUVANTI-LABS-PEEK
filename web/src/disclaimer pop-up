"use client";

import { useState, useEffect } from "react";
import { AlertTriangle, Shield, BookOpen, TrendingUp, X } from "lucide-react";

export default function DisclaimerPopup() {
  const [show, setShow] = useState(false);
  const [accepted, setAccepted] = useState(false);
  const [animateIn, setAnimateIn] = useState(false);

  useEffect(() => {
    const hasAccepted = localStorage.getItem("quvanti_disclaimer_accepted");
    if (!hasAccepted) {
      setShow(true);
      setTimeout(() => setAnimateIn(true), 100);
    }
  }, []);

  const handleAccept = () => {
    if (accepted) {
      setAnimateIn(false);
      setTimeout(() => {
        localStorage.setItem("quvanti_disclaimer_accepted", "true");
        setShow(false);
      }, 300);
    }
  };

  const handleClose = () => {
    // Permanently dismiss — store in localStorage so it never re-triggers
    localStorage.setItem("quvanti_disclaimer_accepted", "true");
    setAnimateIn(false);
    setTimeout(() => {
      setShow(false);
    }, 300);
  };

  if (!show) return null;

  return (
    <div
      className={`fixed inset-0 z-[9999] flex items-center justify-center p-4 transition-all duration-500 overflow-y-auto ${
        animateIn ? "opacity-100" : "opacity-0"
      }`}
      style={{
        background: "rgba(10, 14, 20, 0.95)",
        backdropFilter: "blur(12px)",
        WebkitBackdropFilter: "blur(12px)",
      }}
    >
      <div
        className={`relative bg-gradient-to-br from-[#1a1f2e] to-[#141821] border border-[#2a3441] rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden shadow-2xl transition-all duration-500 my-auto ${
          animateIn ? "scale-100 opacity-100" : "scale-95 opacity-0"
        }`}
      >
        {/* CLOSE BUTTON - STICKY TOP RIGHT */}
        <button
          onClick={handleClose}
          className="absolute top-4 right-4 z-[10000] bg-gray-800/90 hover:bg-gray-700 rounded-full p-2 transition-all shadow-lg border border-gray-600 hover:border-gray-500"
          aria-label="Close disclaimer"
        >
          <X className="text-gray-300 hover:text-white" size={24} />
        </button>

        {/* Animated gradient border effect */}
        <div className="absolute inset-0 bg-gradient-to-r from-cyan-500/20 via-purple-500/20 to-cyan-500/20 rounded-2xl opacity-50 blur-xl"></div>

        {/* Content container */}
        <div className="relative bg-[#1a1f2e]/90 rounded-2xl overflow-hidden">
          {/* Header with subtle gradient - MOBILE OPTIMIZED */}
          <div className="relative bg-gradient-to-r from-cyan-900/30 via-purple-900/30 to-cyan-900/30 px-4 sm:px-8 py-4 sm:py-6 border-b border-[#2a3441]">
            <div className="flex items-center justify-center gap-2 sm:gap-3 mb-1 sm:mb-2">
              <AlertTriangle className="text-cyan-400" size={24} />
              <h2 className="text-xl sm:text-3xl font-bold bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">
                Important Notice
              </h2>
            </div>
            <p className="text-gray-400 text-center text-xs sm:text-sm">
              Please read this carefully before using Quvanti
            </p>
          </div>

          {/* Scrollable content - MOBILE OPTIMIZED */}
          <div className="overflow-y-auto max-h-[calc(90vh-240px)] px-4 sm:px-8 py-4 sm:py-6 space-y-4 sm:space-y-5">
            {/* Main educational focus */}
            <div className="bg-gradient-to-r from-cyan-500/10 to-purple-500/10 border border-cyan-500/30 rounded-xl p-4 sm:p-5 backdrop-blur-sm">
              <div className="flex items-start gap-3 sm:gap-4">
                <BookOpen
                  className="text-cyan-400 flex-shrink-0 mt-1"
                  size={20}
                />
                <div>
                  <h3 className="text-lg sm:text-xl font-bold text-white mb-1 sm:mb-2">
                    Educational Platform
                  </h3>
                  <p className="text-gray-300 leading-relaxed text-sm sm:text-base">
                    Quvanti is an{" "}
                    <strong className="text-cyan-400">
                      educational trading research platform
                    </strong>
                    . All signals and strategies are AI-generated simulations
                    designed for learning purposes only.
                  </p>
                </div>
              </div>
            </div>

            {/* Key disclaimers in elegant grid - MOBILE STACKED */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <div className="bg-[#0A0E14] border border-[#2a3441] rounded-lg p-3 sm:p-4 hover:border-cyan-500/30 transition-colors">
                <div className="flex items-start gap-3">
                  <div className="w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-orange-500/10 flex items-center justify-center flex-shrink-0">
                    <Shield className="text-orange-400" size={18} />
                  </div>
                  <div>
                    <h4 className="text-white font-semibold mb-1 text-sm sm:text-base">
                      Not Financial Advice
                    </h4>
                    <p className="text-gray-400 text-xs sm:text-sm leading-relaxed">
                      We are not licensed advisors. Always consult a
                      professional before investing.
                    </p>
                  </div>
                </div>
              </div>

              <div className="bg-[#0A0E14] border border-[#2a3441] rounded-lg p-3 sm:p-4 hover:border-purple-500/30 transition-colors">
                <div className="flex items-start gap-3">
                  <div className="w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-red-500/10 flex items-center justify-center flex-shrink-0">
                    <TrendingUp className="text-red-400" size={18} />
                  </div>
                  <div>
                    <h4 className="text-white font-semibold mb-1 text-sm sm:text-base">
                      Trading Involves Risk
                    </h4>
                    <p className="text-gray-400 text-xs sm:text-sm leading-relaxed">
                      You can lose 100% of your capital. Past performance
                      doesn't guarantee future results.
                    </p>
                  </div>
                </div>
              </div>

              <div className="bg-[#0A0E14] border border-[#2a3441] rounded-lg p-3 sm:p-4 hover:border-blue-500/30 transition-colors">
                <div className="flex items-start gap-3">
                  <div className="w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-purple-500/10 flex items-center justify-center flex-shrink-0">
                    <svg
                      className="text-purple-400"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      strokeWidth="2"
                    >
                      <path d="M12 2L2 7l10 5 10-5-10-5z" />
                      <path d="M2 17l10 5 10-5" />
                      <path d="M2 12l10 5 10-5" />
                    </svg>
                  </div>
                  <div>
                    <h4 className="text-white font-semibold mb-1 text-sm sm:text-base">
                      AI-Generated Simulations
                    </h4>
                    <p className="text-gray-400 text-xs sm:text-sm leading-relaxed">
                      Signals are created by AI algorithms and may contain
                      errors. Never trade blindly.
                    </p>
                  </div>
                </div>
              </div>

              <div className="bg-[#0A0E14] border border-[#2a3441] rounded-lg p-3 sm:p-4 hover:border-green-500/30 transition-colors">
