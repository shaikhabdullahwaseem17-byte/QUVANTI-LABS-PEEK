"use client";

/**
 * InternalLayout — Obsidian & Frosted Milk canvas wrapper
 *
 * Apply this to every authenticated internal page.
 * DO NOT apply to the homepage (app/page.jsx).
 *
 * Provides:
 *   1. Pure #000000 pitch-black base
 *   2. Asymmetrical vignette: soft white light pool from top-left (10%, 10%)
 *   3. Secondary cool-blue micro-bleed from bottom-right at 1/3 intensity
 *   4. Breathing animation auto-applied to first h1 on the page via CSS
 *   5. Typography token enforcement (F8FAFC headings, E2E8F0 body)
 *   6. Fixed background so gradient doesn't scroll — creates physical depth
 *
 * Usage:
 *   import InternalLayout from "@/components/InternalLayout";
 *   export default function MyPage() {
 *     return (
 *       <InternalLayout>
 *         <AppNav />
 *         <div>...page content...</div>
 *       </InternalLayout>
 *     );
 *   }
 */

export default function InternalLayout({
  children,
  noSmoke = false,
  className = "",
  style = {},
}) {
  return (
    <div className={`internal-page-wrapper ${className}`} style={style}>
      {/* ── ANIMATED SILVER-WHITE SMOKE ORBS ────────────────────────
          Two overlapping fixed-position radial blobs that breathe
          and drift on a slow organic cycle — matching reference image.
          Suppressed on Dashboard via noSmoke prop.
      ─────────────────────────────────────────────────────────────── */}
      {!noSmoke && (
        <>
          <div className="qv-smoke-primary" aria-hidden="true" />
          <div className="qv-smoke-secondary" aria-hidden="true" />
        </>
      )}

      {/* Page content — z-index 1, above smoke layer */}
      <div style={{ position: "relative", zIndex: 1, minHeight: "100vh" }}>
        {children}
      </div>

      <style jsx global>{`

        /* ── BASE CANVAS — pure obsidian, orbs are the background ── */
        .internal-page-wrapper {
          background-color: #000000 !important;
          min-height: 100vh;
          width: 100%;
          color: #FFFFFF;
          overflow-x: hidden;
          position: relative;
          isolation: isolate;
        }

        /* ── PRIMARY ORB — large silver-white bloom, bottom-left ─── */
        .qv-smoke-primary {
          position: fixed;
          bottom: -22%;
          left: -14%;
          width: 75vw;
          height: 80vh;
          border-radius: 50%;
          pointer-events: none;
          z-index: 0;
          will-change: transform, opacity;
          animation: smokeOrbPrimary 14s ease-in-out infinite;
          background: radial-gradient(
            ellipse at center,
            rgba(218, 228, 238, 0.60)  0%,
            rgba(195, 210, 225, 0.32) 20%,
            rgba(160, 178, 195, 0.14) 42%,
            rgba(100, 118, 135, 0.05) 65%,
            transparent               85%
          );
        }

        /* ── SECONDARY ORB — softer mid-body silver taper ───────── */
        .qv-smoke-secondary {
          position: fixed;
          bottom: 4%;
          left: -6%;
          width: 48vw;
          height: 50vh;
          border-radius: 50%;
          pointer-events: none;
          z-index: 0;
          will-change: transform, opacity;
          animation: smokeOrbSecondary 18s ease-in-out infinite;
          animation-delay: -6s;
          background: radial-gradient(
            ellipse at center,
            rgba(205, 218, 232, 0.20)  0%,
            rgba(165, 182, 200, 0.08) 38%,
            transparent               72%
          );
        }

        /* ── PRIMARY ORB DRIFT KEYFRAMES ────────────────────────── */
        @keyframes smokeOrbPrimary {
          0%   { transform: scale(1.00) translate(  0px,   0px); opacity: 0.88; }
          18%  { transform: scale(1.04) translate( 12px, -18px); opacity: 1.00; }
          40%  { transform: scale(1.07) translate( 22px,  -8px); opacity: 0.94; }
          62%  { transform: scale(1.03) translate( 16px,  14px); opacity: 0.91; }
          80%  { transform: scale(0.97) translate( -6px,  10px); opacity: 0.87; }
          100% { transform: scale(1.00) translate(  0px,   0px); opacity: 0.88; }
        }

        /* ── SECONDARY ORB DRIFT (offset phase) ─────────────────── */
        @keyframes smokeOrbSecondary {
          0%   { transform: scale(1.00) translate(  0px,   0px); opacity: 0.72; }
          28%  { transform: scale(1.08) translate( 16px, -12px); opacity: 0.88; }
          55%  { transform: scale(0.93) translate( -8px,  18px); opacity: 0.68; }
          78%  { transform: scale(1.04) translate( 10px,  -6px); opacity: 0.80; }
          100% { transform: scale(1.00) translate(  0px,   0px); opacity: 0.72; }
        }

        /* ── TYPOGRAPHY TOKENS ──────────────────────────────────── */
        .internal-page-wrapper h1,
        .internal-page-wrapper h2,
        .internal-page-wrapper h3,
        .internal-page-wrapper h4 {
          color: #F8FAFC;
          font-weight: 700;
          font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
          line-height: 1.08;
        }

        .internal-page-wrapper h1 { letter-spacing: -0.05em; }
        .internal-page-wrapper h2 { letter-spacing: -0.04em; }
        .internal-page-wrapper h3 { letter-spacing: -0.03em; }
        .internal-page-wrapper h4 { letter-spacing: -0.02em; }

        .internal-page-wrapper p,
        .internal-page-wrapper li {
          font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
          font-weight: 400;
          letter-spacing: -0.01em;
          line-height: 1.65;
        }

        .internal-page-wrapper span,
        .internal-page-wrapper a,
        .internal-page-wrapper button,
        .internal-page-wrapper label {
          font-family: 'Satoshi', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
        }

        .internal-page-wrapper .text-muted-obsidian {
          color: #94A3B8;
          font-weight: 400;
          opacity: 0.85;
        }

        /* ── BREATHING HEADER FLOAT — 7s cycle ──────────────────── */
        @keyframes dynamicHeaderFlow {
          0%   { transform: translateY( 0px); opacity: 0.92; }
          50%  { transform: translateY(-3px); opacity: 1.00; }
          100% { transform: translateY( 0px); opacity: 0.92; }
        }

        .dynamic-flow-header {
          animation: dynamicHeaderFlow 7s ease-in-out infinite;
          will-change: transform, opacity;
        }

        .internal-page-wrapper h1:first-of-type {
          animation: dynamicHeaderFlow 7s ease-in-out infinite;
          will-change: transform, opacity;
        }

        .internal-page-wrapper h1.no-breathe {
          animation: none;
        }

        /* ── ENTRANCE ANIMATION ──────────────────────────────────── */
        @keyframes obsidianFadeIn {
          from { opacity: 0; transform: translateY(12px); }
          to   { opacity: 1; transform: translateY(0);    }
        }

        .internal-page-wrapper .obs-animate     { animation: obsidianFadeIn 0.55s cubic-bezier(0.4, 0, 0.2, 1) both; }
        .internal-page-wrapper .obs-animate-d1  { animation-delay: 0.10s; }
        .internal-page-wrapper .obs-animate-d2  { animation-delay: 0.20s; }
        .internal-page-wrapper .obs-animate-d3  { animation-delay: 0.30s; }
        .internal-page-wrapper .obs-animate-d4  { animation-delay: 0.40s; }

        /* ── GLASS CARDS ON OBSIDIAN ─────────────────────────────── */
        .internal-page-wrapper .obs-card {
          background: rgba(255, 255, 255, 0.038) !important;
          -webkit-backdrop-filter: blur(24px) saturate(140%);
          backdrop-filter: blur(24px) saturate(140%);
          border: 1px solid rgba(255, 255, 255, 0.08) !important;
          border-radius: 18px;
          box-shadow:
            0 8px 48px rgba(0, 0, 0, 0.65),
            inset 0 1px 0 rgba(255, 255, 255, 0.055);
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .internal-page-wrapper .obs-card:hover {
          background: rgba(255, 255, 255, 0.062) !important;
          border-color: rgba(255, 255, 255, 0.13) !important;
          transform: translateY(-2px);
          box-shadow:
            0 16px 64px rgba(0, 0, 0, 0.70),
            inset 0 1px 0 rgba(255, 255, 255, 0.09);
        }

        /* ── SPACING TOKENS ──────────────────────────────────────── */
        .internal-page-wrapper .obs-section {
          padding-top: 4rem;
          padding-bottom: 4rem;
        }

        .internal-page-wrapper .obs-page-container {
          max-width: 80rem;
          margin-left: auto;
          margin-right: auto;
          padding-left: 1.5rem;
          padding-right: 1.5rem;
          padding-top: 2.5rem;
          padding-bottom: 4rem;
        }

        /* ── SCROLLBAR ───────────────────────────────────────────── */
        .internal-page-wrapper ::-webkit-scrollbar       { width: 4px; height: 4px; }
        .internal-page-wrapper ::-webkit-scrollbar-track { background: transparent; }
        .internal-page-wrapper ::-webkit-scrollbar-thumb {
          background: rgba(255, 255, 255, 0.08);
          border-radius: 4px;
        }
        .internal-page-wrapper ::-webkit-scrollbar-thumb:hover {
          background: rgba(255, 255, 255, 0.15);
        }
      `}</style>
    </div>
  );
}



