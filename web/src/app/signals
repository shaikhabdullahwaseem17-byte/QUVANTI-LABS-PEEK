                        <FieldLabel>Quantity</FieldLabel>
                        <input
                          type="number"
                          value={orderForm.qty}
                          onChange={(e) =>
                            setOrderForm((p) => ({ ...p, qty: e.target.value }))
                          }
                          style={inputStyle}
                          placeholder="0.01"
                          min="0.0001"
                          max="10000"
                          step="0.0001"
                          required
                        />
                      </div>
                    </div>

                    <div
                      style={{
                        display: "grid",
                        gridTemplateColumns: "1fr 1fr",
                        gap: "12px",
                      }}
                    >
                      <div>
                        <FieldLabel>Side</FieldLabel>
                        <div style={{ display: "flex", gap: "8px" }}>
                          {["buy", "sell"].map((s) => (
                            <button
                              key={s}
                              type="button"
                              onClick={() =>
                                setOrderForm((p) => ({ ...p, side: s }))
                              }
                              style={{
                                flex: 1,
                                padding: "9px",
                                borderRadius: "8px",
                                border: "none",
                                background:
                                  orderForm.side === s
                                    ? s === "buy"
                                      ? D.green
                                      : D.red
                                    : "rgba(255,255,255,0.05)",
                                color: "#fff",
                                fontSize: "12px",
                                fontWeight: 700,
                                cursor: "pointer",
                                display: "flex",
                                alignItems: "center",
                                justifyContent: "center",
                                gap: "5px",
                              }}
                            >
                              {s === "buy" ? (
                                <ArrowUpCircle size={12} />
                              ) : (
                                <ArrowDownCircle size={12} />
                              )}
                              {s.toUpperCase()}
                            </button>
                          ))}
                        </div>
                      </div>
                      <div>
                        <FieldLabel>Order Type</FieldLabel>
                        <select
                          value={orderForm.type}
                          onChange={(e) =>
                            setOrderForm((p) => ({
                              ...p,
                              type: e.target.value,
                            }))
                          }
                          style={{ ...inputStyle, cursor: "pointer" }}
                        >
                          <option value="market">Market</option>
                          <option value="limit">Limit</option>
                          <option value="stop">Stop</option>
                          <option value="stop_limit">Stop Limit</option>
                        </select>
                      </div>
                    </div>

                    {orderError && (
                      <div
                        style={{
                          display: "flex",
                          gap: "8px",
                          padding: "10px 12px",
                          background: "rgba(239,68,68,0.08)",
                          border: "1px solid rgba(239,68,68,0.2)",
                          borderRadius: "8px",
                        }}
                      >
                        <AlertTriangle
                          size={12}
                          style={{ color: D.red, flexShrink: 0 }}
                        />
                        <span style={{ fontSize: "12px", color: D.red }}>
                          {orderError}
                        </span>
                      </div>
                    )}

                    {orderResult && (
                      <div
                        style={{
                          padding: "10px 12px",
                          background: "rgba(16,185,129,0.08)",
                          border: "1px solid rgba(16,185,129,0.2)",
                          borderRadius: "8px",
                        }}
                      >
                        <div
                          style={{
                            display: "flex",
                            alignItems: "center",
                            gap: "7px",
                            marginBottom: "6px",
                          }}
                        >
                          <CheckCircle size={12} style={{ color: D.green }} />
                          <span
                            style={{
                              fontSize: "12px",
                              color: D.green,
                              fontWeight: 700,
                            }}
                          >
                            Order Filled — {orderResult.id}
                          </span>
                        </div>
                        <div
                          style={{
                            display: "grid",
                            gridTemplateColumns: "1fr 1fr 1fr",
                            gap: "8px",
                          }}
                        >
                          {[
                            {
                              label: "Fill Price",
                              value: `$${(orderResult.fillPrice || 0).toFixed(4)}`,
                            },
                            {
                              label: "Slippage",
                              value: `${(orderResult.slippageBps || 0).toFixed(1)} bps`,
                            },
                            {
                              label: "Latency",
                              value: `${orderResult.latencyMs}ms`,
                            },
                          ].map((d) => (
                            <div key={d.label} style={{ textAlign: "center" }}>
                              <div
                                style={{
                                  fontSize: "8px",
                                  color: D.faint,
                                  textTransform: "uppercase",
                                  letterSpacing: "0.08em",
                                }}
                              >
                                {d.label}
                              </div>
                              <div
                                style={{
                                  fontSize: "12px",
                                  fontWeight: 700,
                                  color: D.green,
                                  fontFamily: "monospace",
                                }}
                              >
                                {d.value}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {executionMode === "live" && (
                      <div
                        style={{
                          padding: "10px 12px",
                          background: "rgba(239,68,68,0.08)",
                          border: "1px solid rgba(239,68,68,0.2)",
                          borderRadius: "8px",
                        }}
                      >
                        <p
                          style={{
                            margin: 0,
                            fontSize: "11px",
                            color: D.red,
                            fontWeight: 700,
                          }}
                        >
                          ⚠️ LIVE ORDER — Real capital will be committed. Verify
                          before submitting.
                        </p>
                      </div>
                    )}

                    <button
                      type="submit"
                      disabled={orderLoading}
                      style={{
                        padding: "12px",
                        background: orderForm.side === "buy" ? D.green : D.red,
                        color: "#fff",
                        border: "none",
                        borderRadius: "10px",
                        fontSize: "13px",
                        fontWeight: 800,
                        cursor: orderLoading ? "not-allowed" : "pointer",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        gap: "8px",
                        opacity: orderLoading ? 0.7 : 1,
                      }}
                    >
                      {orderLoading && (
                        <RefreshCw
                          size={14}
                          style={{ animation: "spin 1s linear infinite" }}
                        />
                      )}
                      {orderLoading
                        ? "Routing Order..."
                        : `${orderForm.side.toUpperCase()} ${orderForm.qty || "?"} ${orderForm.symbol} · ${executionMode.toUpperCase()}`}
                    </button>
                  </form>
                )}
              </Card>

              {/* ── EXECUTION LOG ──────────────────────────────────────── */}
              <Card>
                <button
                  style={{
                    width: "100%",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "space-between",
                    background: "transparent",
                    border: "none",
                    cursor: "pointer",
                    padding: 0,
                    marginBottom: showExecLog ? "14px" : 0,
                  }}
                  onClick={() => setShowExecLog((p) => !p)}
                >
                  <span
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "8px",
                      fontSize: "14px",
                      fontWeight: 700,
                      color: "#ffffff",
                    }}
                  >
                    <ListOrdered size={15} style={{ color: D.accent }} />
                    Execution Log
                    {executionLog.length > 0 && (
                      <span
                        style={{
                          fontSize: "10px",
                          fontWeight: 700,
                          background: "rgba(91,140,255,0.15)",
                          color: D.accent,
                          padding: "1px 7px",
                          borderRadius: "10px",
                          border: "1px solid rgba(91,140,255,0.2)",
                        }}
                      >
                        {executionLog.length}
                      </span>
                    )}
                  </span>
                  {showExecLog ? (
                    <ChevronUp size={16} style={{ color: D.muted }} />
                  ) : (
                    <ChevronDown size={16} style={{ color: D.muted }} />
                  )}
                </button>

                {showExecLog && (
                  <>
                    {executionLog.length === 0 ? (
                      <p
                        style={{
                          textAlign: "center",
                          fontSize: "13px",
                          color: D.faint,
                          padding: "16px 0",
                        }}
                      >
                        No fills recorded this session.
                      </p>
                    ) : (
                      <div style={{ overflowX: "auto" }}>
                        <table
                          style={{ width: "100%", borderCollapse: "collapse" }}
                        >
                          <thead>
                            <tr
                              style={{
                                borderBottom:
                                  "1px solid rgba(255,255,255,0.06)",
                              }}
                            >
                              {[
                                "Time",
                                "Symbol",
                                "Side",
                                "Qty",
                                "Fill",
                                "Slip",
                                "RTT",
                                "Mode",
                              ].map((h) => (
                                <th
                                  key={h}
                                  style={{
                                    padding: "5px 4px",
                                    fontSize: "8px",
                                    color: D.faint,
                                    fontWeight: 600,
                                    textAlign: h === "Time" ? "left" : "right",
                                    textTransform: "uppercase",
                                    letterSpacing: "0.07em",
                                    whiteSpace: "nowrap",
                                  }}
                                >
                                  {h}
                                </th>
                              ))}
                            </tr>
                          </thead>
                          <tbody>
                            {executionLog.map((entry, i) => (
                              <ExecLogRow
                                key={`${entry.id}-${i}`}
                                entry={entry}
                              />
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}
                  </>
                )}
              </Card>
            </>
          ) : (
            <Card
              style={{
                display: "flex",
                flexDirection: "column",
                alignItems: "center",
                justifyContent: "center",
                minHeight: "320px",
                textAlign: "center",
              }}
            >
              <Link2Off
                size={40}
                style={{ color: "rgba(255,255,255,0.1)", marginBottom: "16px" }}
              />
              <h3
                style={{
                  margin: "0 0 8px 0",
                  fontSize: "16px",
                  fontWeight: 700,
                  color: "#ffffff",
                }}
              >
                No Broker Connected
              </h3>
              <p
                style={{
                  margin: "0 0 24px 0",
                  fontSize: "13px",
                  color: D.muted,
                  maxWidth: "300px",
                  lineHeight: "1.6",
                }}
              >
                Connect Alpaca or switch to Paper Trading mode to view live P&L,
                positions, and execute orders.
              </p>
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "1fr 1fr",
                  gap: "10px",
                }}
              >
                {[
                  { e: "🦙", l: "Alpaca" },
                  { e: "📝", l: "Paper" },
                ].map((b) => (
                  <div
                    key={b.l}
                    style={{
                      padding: "12px",
                      background: "rgba(255,255,255,0.03)",
                      borderRadius: "10px",
                      border: "1px solid rgba(255,255,255,0.06)",
                      display: "flex",
                      flexDirection: "column",
                      alignItems: "center",
                      gap: "6px",
                    }}
                  >
                    <span style={{ fontSize: "22px" }}>{b.e}</span>
                    <span style={{ fontSize: "11px", color: D.faint }}>
                      {b.l}
                    </span>
                  </div>
                ))}
              </div>
            </Card>
          )}

          {/* Risk Disclosure */}
          <div
            style={{
              padding: "16px 20px",
              background: "rgba(239,68,68,0.06)",
              border: "1px solid rgba(239,68,68,0.18)",
              borderRadius: "12px",
              borderLeft: "3px solid #ef4444",
            }}
          >
            <div style={{ display: "flex", gap: "10px" }}>
              <AlertTriangle
                size={14}
                style={{ color: D.red, flexShrink: 0, marginTop: "2px" }}
              />
              <div>
                <p
                  style={{
                    margin: "0 0 4px 0",
                    fontSize: "10px",
                    fontWeight: 800,
                    color: D.red,
                    letterSpacing: "0.1em",
                    textTransform: "uppercase",
                  }}
                >
                  Risk Disclosure
                </p>
                <p
                  style={{
                    margin: 0,
                    fontSize: "11px",
                    color: D.muted,
                    lineHeight: "1.7",
                  }}
                >
                  Quvanti Labs is a research-first terminal. We assume{" "}
                  <strong style={{ color: "rgba(255,255,255,0.6)" }}>
                    no liability
                  </strong>{" "}
                  for exchange failures, data errors, or capital loss. All
                  backtested results are simulated.{" "}
                  <strong style={{ color: D.red }}>
                    Trading involves a 100% risk of capital loss.
                  </strong>{" "}
                  Not financial advice.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <style jsx global>{`
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @keyframes ws-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
        .ws-pulse { animation: ws-pulse 1.5s ease-in-out infinite; }
        select option { background: #1a1a1a; color: #ffffff; }
      `}</style>
    </InternalLayout>
  );
}



