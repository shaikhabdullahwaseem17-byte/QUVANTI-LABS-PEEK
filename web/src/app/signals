function WsLED({ status, latency }) {
  const colors = {
    connected: D.green,
    reconnecting: D.amber,
    disconnected: "rgba(255,255,255,0.2)",
  };
  const labels = {
    connected: "LIVE",
    reconnecting: "SYNC",
    disconnected: "OFFLINE",
  };
  const c = colors[status] || colors.disconnected;
  const label = labels[status] || "OFFLINE";
  return (
    <div
      style={{
        display: "inline-flex",
        alignItems: "center",
        gap: "8px",
        padding: "5px 12px",
        borderRadius: "6px",
        background: `${c}12`,
        border: `1px solid ${c}30`,
      }}
    >
      <div
        style={{
          width: "7px",
          height: "7px",
          borderRadius: "50%",
          background: c,
          boxShadow:
            status === "connected" ? `0 0 0 2px ${c}30, 0 0 12px ${c}` : "none",
          flexShrink: 0,
        }}
        className={status === "connected" ? "ws-pulse" : ""}
      />
      <span
        style={{
          fontSize: "9px",
          fontWeight: 800,
          color: c,
          letterSpacing: "0.12em",
          fontFamily: "monospace",
        }}
      >
        {label}
      </span>
      {latency !== null && status === "connected" && (
        <span
          style={{ fontSize: "9px", color: D.faint, fontFamily: "monospace" }}
        >
          {latency}ms
        </span>
      )}
    </div>
  );
}

function ConnectionBadge({ status }) {
  const map = {
    connected: { color: D.green, label: "CONNECTED" },
    pending: { color: D.amber, label: "PENDING" },
    error: { color: D.red, label: "ERROR" },
    disconnected: { color: "rgba(255,255,255,0.2)", label: "OFFLINE" },
  };
  const c = map[status] || map.disconnected;
  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        gap: "5px",
        padding: "3px 10px",
        borderRadius: "4px",
        background: `${c.color}15`,
        border: `1px solid ${c.color}35`,
        fontSize: "10px",
        fontWeight: 700,
        letterSpacing: "0.1em",
        color: c.color,
        fontFamily: "monospace",
      }}
    >
      <div
        style={{
          width: "5px",
