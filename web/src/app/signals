export default function BrokerSettingsPage() {
  const executionMode = useOmniStore((s) => s.executionMode);
  const setExecutionMode = useOmniStore((s) => s.setExecutionMode);
  const routeTrade = useOmniStore((s) => s.routeTrade);
  const wsStatus = useOmniStore((s) => s.wsStatus);
  const wsLatency = useOmniStore((s) => s.wsLatency);
  const pingWs = useOmniStore((s) => s.pingWs);
  const executionLog = useOmniStore((s) => s.executionLog);
  const paperLiveMetrics = useOmniStore((s) => s.paperLiveMetrics);

  const [connection, setConnection] = useState(null);
  const [portfolio, setPortfolio] = useState(null);
  const [connectLoading, setConnectLoading] = useState(false);
  const [portfolioLoading, setPortfolioLoading] = useState(false);
  const [connectError, setConnectError] = useState(null);
  const [selectedBroker, setSelectedBroker] = useState("alpaca");
  const [formData, setFormData] = useState({});
  const [connectMode, setConnectMode] = useState("paper");
  const [showLiveConfirm, setShowLiveConfirm] = useState(false);

  const [orderForm, setOrderForm] = useState({
    symbol: "BTC/USD",
    side: "buy",
    qty: "",
    type: "market",
  });
  const [orderLoading, setOrderLoading] = useState(false);
  const [orderResult, setOrderResult] = useState(null);
  const [orderError, setOrderError] = useState(null);
  const [showOrderForm, setShowOrderForm] = useState(false);
  const [showExecLog, setShowExecLog] = useState(true);
  const [initialLoad, setInitialLoad] = useState(true);
  const wsIntervalRef = useRef(null);

  useEffect(() => {
    fetchConnection();
    pingWs();
    wsIntervalRef.current = setInterval(() => pingWs(), 5000);
    return () => {
      if (wsIntervalRef.current) clearInterval(wsIntervalRef.current);
    };
  }, []);

  useEffect(() => {
    if (!connection || connection.status !== "connected") return;
    fetchPortfolio();
    const interval = setInterval(fetchPortfolio, 15000);
    return () => clearInterval(interval);
  }, [connection]);

  async function fetchConnection() {
    try {
      const res = await fetch("/api/broker/connect");
      if (!res.ok) throw new Error("Failed to load connection");
      const data = await res.json();
      setConnection(data.connection);
    } catch (e) {
      console.error("[BrokerSettings.fetchConnection]", e.message);
    } finally {
      setInitialLoad(false);
    }
  }

  async function fetchPortfolio() {
    setPortfolioLoading(true);
    try {
      const res = await fetch("/api/broker/portfolio");
      if (!res.ok) throw new Error("Failed to sync portfolio");
      const data = await res.json();
      setPortfolio(data);
    } catch (e) {
      console.error("[BrokerSettings.fetchPortfolio]", e.message);
    } finally {
      setPortfolioLoading(false);
    }
  }

  async function handleConnect(e) {
    e.preventDefault();
    setConnectLoading(true);
    setConnectError(null);
    const payload = { broker: selectedBroker, mode: connectMode, ...formData };
    try {
      const res = await fetch("/api/broker/connect", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) {
        setConnectError(data.message || data.error || "Connection failed");
        return;
      }
      await fetchConnection();
      await fetchPortfolio();
    } catch (e) {
      setConnectError(e.message);
    } finally {
      setConnectLoading(false);
    }
  }

  async function handlePlaceOrder(e) {
    e.preventDefault();
    setOrderLoading(true);
    setOrderError(null);
    setOrderResult(null);
    try {
      const result = await routeTrade({
        symbol: orderForm.symbol,
        side: orderForm.side,
        qty: parseFloat(orderForm.qty),
        type: orderForm.type,
      });
      if (!result.success) {
        setOrderError(result.error || "Order rejected");
        return;
      }
      setOrderResult(result.entry);
      await fetchPortfolio();
    } catch (e) {
      setOrderError(e.message);
    } finally {
      setOrderLoading(false);
    }
  }

  function handleRequestLiveMode() {
    if (executionMode === "live") {
      // Switching back to paper is always safe — no confirmation needed
      setExecutionMode("paper");
    } else {
      setShowLiveConfirm(true);
    }
  }

  function handleConfirmLive() {
    setShowLiveConfirm(false);
    setExecutionMode("live");
  }

  const broker = BROKERS.find((b) => b.id === selectedBroker);
  const isConnected = connection?.status === "connected";
  const displayPortfolio =
    portfolio ||
    (executionMode === "paper"
      ? {
          broker: "paper",
          account: {
            equity: useOmniStore.getState().paperPortfolio?.total_value || 0,
            buyingPower:
              useOmniStore.getState().paperPortfolio?.cash_balance || 0,
            pnl: paperLiveMetrics.totalPnL,
            pnlPct:
              useOmniStore.getState().paperPortfolio?.total_return_percent || 0,
          },
          positions: useOmniStore.getState().paperPositions,
        }
      : null);

  const pnl = displayPortfolio?.account?.pnl ?? 0;
  const pnlPct = displayPortfolio?.account?.pnlPct ?? 0;

  const inputStyle = {
    width: "100%",
    padding: "10px 12px",
    background: "rgba(255,255,255,0.04)",
    border: "1px solid rgba(255,255,255,0.1)",
    borderRadius: "8px",
    color: "#ffffff",
    fontSize: "13px",
    fontFamily: "monospace",
    outline: "none",
    boxSizing: "border-box",
  };

  if (initialLoad) {
    return (
      <InternalLayout>
        <div
          style={{
            minHeight: "100vh",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          <RefreshCw
            size={32}
            style={{ color: D.muted, animation: "spin 1s linear infinite" }}
          />
          <style
            jsx
            global
          >{`@keyframes spin { from{transform:rotate(0deg)}to{transform:rotate(360deg)} }`}</style>
        </div>
      </InternalLayout>
    );
  }

  return (
    <InternalLayout>
      {showLiveConfirm && (
        <LiveConfirmModal
          onConfirm={handleConfirmLive}
          onCancel={() => setShowLiveConfirm(false)}
        />
      )}

      <AppNav />

      {/* ── PAGE HEADER ──────────────────────────────────────────────────── */}
      <div
        style={{
          background: "#0a0a0a",
          borderBottom: "1px solid rgba(255,255,255,0.06)",
          padding: "20px 24px",
        }}
      >
        <div className="max-w-[1200px] mx-auto flex flex-wrap items-center justify-between gap-3">
          <div style={{ display: "flex", alignItems: "center", gap: "14px" }}>
            <div
              style={{
                width: "40px",
                height: "40px",
                borderRadius: "10px",
                background: "rgba(91,140,255,0.12)",
                border: "1px solid rgba(91,140,255,0.25)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <Zap size={20} style={{ color: D.accent }} />
            </div>
            <div>
              <h1
                style={{
                  margin: 0,
                  fontSize: "20px",
                  fontWeight: 800,
                  color: "#ffffff",
                  letterSpacing: "-0.02em",
                }}
              >
                Broker Settings
              </h1>
              <p
                style={{
                  margin: 0,
                  fontSize: "12px",
                  color: D.muted,
                  marginTop: "2px",
                }}
              >
                Broker integration · Order routing · Real-time P&L
              </p>
            </div>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: "12px" }}>
            <WsLED status={wsStatus} latency={wsLatency} />
            {isConnected && (
              <button
                onClick={fetchPortfolio}
                disabled={portfolioLoading}
                style={{
                  display: "flex",
                  alignItems: "center",
                  gap: "6px",
                  padding: "7px 14px",
                  background: "rgba(255,255,255,0.05)",
                  border: "1px solid rgba(255,255,255,0.08)",
                  borderRadius: "8px",
                  color: D.muted,
                  fontSize: "12px",
                  cursor: "pointer",
                }}
              >
                <RefreshCw
                  size={12}
                  style={{
                    animation: portfolioLoading
                      ? "spin 1s linear infinite"
                      : "none",
                  }}
                />
                Sync
              </button>
            )}
            <ConnectionBadge status={connection?.status || "disconnected"} />
          </div>
        </div>
      </div>

      {/* ── EXECUTION MODE TOGGLE ────────────────────────────────────────── */}
      <div
        style={{
          background: "#0d0d0d",
          borderBottom: "1px solid rgba(255,255,255,0.05)",
          padding: "12px 24px",
        }}
      >
        <div className="max-w-[1200px] mx-auto">
          <div
            style={{
              display: "flex",
