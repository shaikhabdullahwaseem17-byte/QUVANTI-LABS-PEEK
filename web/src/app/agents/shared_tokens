/* ─── Helpers ──────────────────────────────────────────────────────────── */
function fmtCurrency(v) {
  const n = Number(v);
  if (isNaN(n)) return "$—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: 2,
  }).format(n);
}
function fmtPct(v, showSign = true) {
  const n = Number(v);
  if (isNaN(n)) return "—";
  return (showSign && n > 0 ? "+" : "") + n.toFixed(2) + "%";
}
function fmtNum(v, d = 2) {
  const n = Number(v);
  return isNaN(n) ? "—" : n.toFixed(d);
}
function sharpeColor(v) {
  const n = Number(v);
  if (n >= 1.5) return "#34D399";
  if (n >= 0.8) return "#FBBF24";
  return "#F87171";
}
function returnColor(v) {
  return Number(v) >= 0 ? "#34D399" : "#F87171";
}

/* ─── Equity Chart (pure SVG, no deps) ────────────────────────────────── */
function EquityChart({
  equityCurve = [],
  trades = [],
  initialCapital = 10000,
}) {
  const W = 700,
    H = 200,
    PAD = { top: 14, right: 14, bottom: 28, left: 56 };
  const data = equityCurve.slice(0, 250);
  if (data.length < 2) {
    return (
      <div
        style={{
          height: H,
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          color: "#4A5568",
          fontSize: 13,
        }}
      >
        Equity data not available
      </div>
    );
  }
  const vals = data.map((d) => d.equity || d);
  const minV = Math.min(...vals),
    maxV = Math.max(...vals);
  const range = maxV - minV || 1;
  const xS = (i) =>
    PAD.left + (i / (data.length - 1)) * (W - PAD.left - PAD.right);
  const yS = (v) =>
    PAD.top + (1 - (v - minV) / range) * (H - PAD.top - PAD.bottom);
  const linePath = data
    .map(
      (d, i) =>
        `${i === 0 ? "M" : "L"}${xS(i).toFixed(1)},${yS(d.equity || d).toFixed(1)}`,
    )
    .join(" ");
  const areaPath =
    linePath +
    ` L${xS(data.length - 1).toFixed(1)},${(H - PAD.bottom).toFixed(1)} L${xS(0).toFixed(1)},${(H - PAD.bottom).toFixed(1)} Z`;
  const isProfit = vals[vals.length - 1] >= initialCapital;
  const lineColor = isProfit ? "#34D399" : "#F87171";
  const yTicks = [0, 0.5, 1].map((p) => ({
    y: PAD.top + (1 - p) * (H - PAD.top - PAD.bottom),
    label: fmtCurrency(minV + p * range),
  }));
  return (
    <svg
      viewBox={`0 0 ${W} ${H}`}
      style={{ width: "100%", height: H, display: "block" }}
    >
      <defs>
        <linearGradient id="sg1" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stopColor={lineColor} stopOpacity="0.3" />
          <stop offset="100%" stopColor={lineColor} stopOpacity="0.01" />
        </linearGradient>
      </defs>
      {yTicks.map((t, i) => (
        <g key={i}>
          <line
            x1={PAD.left}
            x2={W - PAD.right}
            y1={t.y}
            y2={t.y}
            stroke="rgba(255,255,255,0.06)"
            strokeWidth="1"
            strokeDasharray="4 4"
          />
          <text
            x={PAD.left - 6}
            y={t.y + 4}
            textAnchor="end"
            fill="#4A5568"
            fontSize="9"
            fontFamily="monospace"
          >
            {t.label}
          </text>
        </g>
      ))}
      <line
        x1={PAD.left}
        x2={W - PAD.right}
        y1={yS(initialCapital)}
        y2={yS(initialCapital)}
        stroke="rgba(255,255,255,0.18)"
        strokeWidth="1"
        strokeDasharray="6 3"
      />
      <path d={areaPath} fill="url(#sg1)" />
      <path
        d={linePath}
        fill="none"
        stroke={lineColor}
        strokeWidth="2"
        strokeLinejoin="round"
      />
    </svg>
  );
}

