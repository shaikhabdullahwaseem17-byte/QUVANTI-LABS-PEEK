      </div>
    </div>
  );
}

// ── Main Page ─────────────────────────────────────────────────────────────────
export default function AgentsPage() {
  const agents = useOmniStore((s) => s.agents);
  const agentFetchStatus = useOmniStore((s) => s.agentFetchStatus);
  const syncAgents = useOmniStore((s) => s.syncAgents);
  const removeAgentOptimistic = useOmniStore((s) => s.removeAgentOptimistic);
  const updateAgentStatusOptimistic = useOmniStore(
    (s) => s.updateAgentStatusOptimistic,
  );

  const [terminalAgent, setTerminalAgent] = useState(null);
  const [deleting, setDeleting] = useState(null);

  useEffect(() => {
    syncAgents();
    const onVisible = () => {
      if (document.visibilityState === "visible") syncAgents();
    };
    document.addEventListener("visibilitychange", onVisible);
    const interval = setInterval(syncAgents, 20000);
    return () => {
      document.removeEventListener("visibilitychange", onVisible);
      clearInterval(interval);
    };
  }, []);

  const handlePauseResume = async (agent) => {
    const newStatus = agent.status === "active" ? "paused" : "active";
    updateAgentStatusOptimistic(agent.id, newStatus);
    try {
      const res = await fetch(`/api/agents/${agent.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: newStatus }),
      });
      if (!res.ok) throw new Error("Status update failed");
    } catch (err) {
      console.error(err);
    } finally {
      await syncAgents();
    }
  };

  const handleDelete = async (agent) => {
    if (
      !confirm(
        `Delete "${agent.name}" permanently?\n\nThis will close all positions and cannot be undone.`,
      )
    )
      return;
    setDeleting(agent.id);
    removeAgentOptimistic(agent.id);
    try {
      const res = await fetch("/api/agents/liquidate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ agentId: agent.id }),
      });
      if (!res.ok) throw new Error("Delete failed");
    } catch (err) {
      console.error(err);
    } finally {
      setDeleting(null);
      await syncAgents();
    }
  };

  const isInitialLoad = agentFetchStatus === "loading" && agents.length === 0;

  const activeCount = agents.filter((a) => a.status === "active").length;
  const pausedCount = agents.filter((a) => a.status === "paused").length;

  return (
    <div
      style={{
        minHeight: "100vh",
