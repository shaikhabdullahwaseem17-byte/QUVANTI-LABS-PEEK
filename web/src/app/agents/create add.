                  style={{ color: "rgba(255,255,255,0.2)" }}
                />
              </div>
              <h2
                style={{
                  fontSize: 22,
                  fontWeight: 700,
                  color: "#F8FAFC",
                  margin: "0 0 10px",
                  letterSpacing: "-0.04em",
                }}
              >
                No Agents Yet
              </h2>
              <p
                style={{
                  fontSize: 14,
                  color: "rgba(255,255,255,0.38)",
                  margin: "0 0 28px",
                  maxWidth: 380,
                  marginLeft: "auto",
                  marginRight: "auto",
                  lineHeight: 1.6,
                }}
              >
                Create your first AI trading agent. Define a strategy in plain
                English and let Quvanti build, backtest, and deploy it.
              </p>
              <a
                href="/agents/create"
                style={{
                  display: "inline-flex",
                  alignItems: "center",
                  gap: 8,
                  padding: "12px 28px",
                  borderRadius: 12,
                  background: "#ffffff",
                  color: "#000000",
                  fontSize: 14,
                  fontWeight: 700,
                  textDecoration: "none",
                  letterSpacing: "-0.02em",
                  boxShadow: "0 4px 24px rgba(255,255,255,0.14)",
                }}
              >
                <Plus size={15} />
                Create Your First Agent
              </a>
            </div>
          )}

          {/* ── Agent Grid ── */}
          {!isInitialLoad && agents.length > 0 && (
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fill, minmax(360px, 1fr))",
                gap: 20,
              }}
            >
              {agents.map((agent) => (
                <AgentCard
                  key={agent.id}
                  agent={agent}
                  onOpenTerminal={setTerminalAgent}
                  onPauseResume={handlePauseResume}
                  onDelete={handleDelete}
                  onShare={() => {}}
                />
              ))}
            </div>
          )}
        </div>
      </div>

      {/* ── Agent Terminal Slide-Over ── */}
      {terminalAgent && (
        <AgentTerminal
          agentId={Number(terminalAgent.id)}
          agentName={terminalAgent.name}
          agentData={terminalAgent}
          onClose={() => setTerminalAgent(null)}
        />
      )}

      <style jsx global>{`
        @keyframes spin {
          from { transform: rotate(0deg); }
          to   { transform: rotate(360deg); }
        }
        @keyframes agentOrbFloat {
          0%,100% { transform: scale(1) translate(0,0); opacity: 0.9; }
          40%     { transform: scale(1.06) translate(18px,-14px); opacity: 1; }
          70%     { transform: scale(0.97) translate(-8px,10px); opacity: 0.85; }
        }
      `}</style>
    </div>
  );
}



