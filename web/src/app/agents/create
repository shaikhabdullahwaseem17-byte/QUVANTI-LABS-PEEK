// ── Status badge for roster items ─────────────────────────────────────────────
function StatusBadge({ status }) {
  const map = {
    active: { color: D.green, label: "ACTIVE", glow: true },
    paused: { color: D.amber, label: "PAUSED", glow: false },
    stopped: { color: "rgba(255,255,255,0.2)", label: "STOPPED", glow: false },
  };
  const s = map[status] || map.stopped;
  return (
    <span
      style={{
        display: "inline-flex",
        alignItems: "center",
        gap: "4px",
        padding: "2px 8px",
        borderRadius: "4px",
        background: `${s.color}18`,
        border: `1px solid ${s.color}35`,
        fontSize: "9px",
        fontWeight: 800,
        color: s.color,
        letterSpacing: "0.1em",
        fontFamily: "monospace",
        flexShrink: 0,
      }}
    >
      <span
        style={{
          width: "4px",
          height: "4px",
          borderRadius: "50%",
          background: s.color,
          boxShadow: s.glow ? `0 0 6px ${s.color}` : "none",
          display: "inline-block",
        }}
      />
      {s.label}
    </span>
  );
}

// ── Individual roster card ────────────────────────────────────────────────────
function RosterCard({ agent, onDelete, deleteLoading }) {
  const isDeleting = deleteLoading === agent.id;
  const pnlRaw = parseFloat(
    agent.parsed_strategy?.expectedReturn ||
      agent.parsed_strategy?.performance?.totalReturn ||
      0,
  );
  const hasPnL = !isNaN(pnlRaw) && pnlRaw !== 0;
  const pnlColor = pnlRaw >= 0 ? D.green : D.red;

  return (
    <div
      style={{
        padding: "14px 16px",
        background: "rgba(255,255,255,0.03)",
        border: `1px solid ${D.border}`,
        borderRadius: "12px",
        display: "flex",
        flexDirection: "column",
        gap: "10px",
        transition: "border-color 0.2s",
      }}
      onMouseEnter={(e) =>
        (e.currentTarget.style.borderColor = "rgba(255,255,255,0.13)")
      }
      onMouseLeave={(e) => (e.currentTarget.style.borderColor = D.border)}
    >
      {/* Top row: name + status */}
      <div
        style={{
          display: "flex",
          alignItems: "flex-start",
          justifyContent: "space-between",
          gap: "8px",
        }}
      >
        <div style={{ flex: 1, minWidth: 0 }}>
          <p
            style={{
              margin: 0,
              fontSize: "13px",
              fontWeight: 700,
              color: D.text,
              whiteSpace: "nowrap",
              overflow: "hidden",
              textOverflow: "ellipsis",
            }}
          >
            {agent.name}
          </p>
          {agent.description && (
            <p
              style={{
                margin: "2px 0 0",
                fontSize: "11px",
                color: D.muted,
                whiteSpace: "nowrap",
                overflow: "hidden",
                textOverflow: "ellipsis",
              }}
            >
              {agent.description}
            </p>
          )}
        </div>
        <StatusBadge status={agent.status} />
      </div>

      {/* Asset + PnL strip */}
      <div style={{ display: "flex", alignItems: "center", gap: "12px" }}>
        {agent.parsed_strategy?.asset && (
          <span
            style={{
              fontSize: "10px",
              fontWeight: 700,
              color: D.accent,
              background: "rgba(91,140,255,0.1)",
              border: "1px solid rgba(91,140,255,0.2)",
              padding: "2px 8px",
              borderRadius: "4px",
              fontFamily: "monospace",
            }}
          >
            {agent.parsed_strategy.asset}
          </span>
        )}
        {hasPnL && (
          <span
            style={{
              fontSize: "10px",
              fontWeight: 700,
              color: pnlColor,
              fontFamily: "monospace",
              display: "flex",
              alignItems: "center",
              gap: "3px",
            }}
          >
            {pnlRaw >= 0 ? (
              <TrendingUp size={10} />
            ) : (
              <TrendingDown size={10} />
            )}
            {pnlRaw >= 0 ? "+" : ""}
            {pnlRaw.toFixed(2)}%
          </span>
        )}
        <span
          style={{
            fontSize: "9px",
            color: D.faint,
            fontFamily: "monospace",
            marginLeft: "auto",
          }}
        >
          {agent.created_at
            ? new Date(agent.created_at).toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
              })
            : ""}
        </span>
      </div>

      {/* Actions */}
      <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
        <SovereignButton
          as="a"
          href={`/agents/${agent.id}`}
          purpose="terminal"
          variant="outline"
          size="xs"
          iconPosition="left"
          style={{ flex: 1, justifyContent: "center" }}
        >
          OPEN TERMINAL
        </SovereignButton>

        <button
          onClick={() => onDelete(agent.id)}
          disabled={isDeleting}
          title="Delete agent"
          style={{
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            width: "30px",
            height: "30px",
            borderRadius: "8px",
            background: "rgba(239,68,68,0.08)",
            border: "1px solid rgba(239,68,68,0.2)",
            color: isDeleting ? D.faint : D.red,
            cursor: isDeleting ? "not-allowed" : "pointer",
            transition: "all 0.2s",
            flexShrink: 0,
            opacity: isDeleting ? 0.5 : 1,
          }}
          onMouseEnter={(e) => {
            if (!isDeleting) {
              e.currentTarget.style.background = "rgba(239,68,68,0.18)";
              e.currentTarget.style.borderColor = "rgba(239,68,68,0.4)";
            }
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.background = "rgba(239,68,68,0.08)";
            e.currentTarget.style.borderColor = "rgba(239,68,68,0.2)";
          }}
        >
          {isDeleting ? (
            <Loader
              size={12}
              style={{ animation: "rosterSpin 0.8s linear infinite" }}
            />
          ) : (
            <Trash2 size={13} />
          )}
        </button>
      </div>
    </div>
  );
}

// ── Allocation progress bar ───────────────────────────────────────────────────
function AllocationBar({ current, max }) {
  const pct = max > 0 ? Math.min((current / max) * 100, 100) : 0;
  const atLimit = current >= max;
  const barColor = atLimit ? D.crimson : pct >= 75 ? D.amber : D.accent;

  return (
    <div>
      {/* Labels */}
      <div
        style={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          marginBottom: "8px",
        }}
      >
        <span
          style={{
            fontSize: "11px",
            fontWeight: 700,
            color: atLimit ? D.crimson : D.muted,
            display: "flex",
            alignItems: "center",
            gap: "5px",
            transition: "color 0.3s",
          }}
        >
          <Users size={12} />
          Agent Slots
          {atLimit && (
            <span
              style={{
                fontSize: "9px",
                fontWeight: 800,
                color: D.crimson,
                background: "rgba(255,0,0,0.1)",
                border: "1px solid rgba(255,0,0,0.3)",
                padding: "1px 6px",
                borderRadius: "3px",
                letterSpacing: "0.08em",
                animation: "limitPulse 1.5s ease-in-out infinite",
              }}
            >
              LIMIT REACHED
            </span>
          )}
        </span>
        <span
          style={{
            fontSize: "12px",
            fontWeight: 800,
            color: atLimit ? D.crimson : D.text,
            fontFamily: "monospace",
            transition: "color 0.3s",
          }}
        >
          {current} / {max}
        </span>
      </div>

      {/* Track */}
      <div
        style={{
          width: "100%",
          height: "5px",
          borderRadius: "3px",
          background: "rgba(255,255,255,0.07)",
          overflow: "hidden",
          position: "relative",
        }}
      >
        {/* Fill */}
        <div
          style={{
            height: "100%",
            width: `${pct}%`,
            borderRadius: "3px",
            background: atLimit
              ? D.crimson
              : `linear-gradient(90deg, ${D.accent}, ${pct >= 75 ? D.amber : D.accent})`,
            transition:
              "width 0.5s cubic-bezier(0.25, 1, 0.5, 1), background 0.3s",
            boxShadow: atLimit
              ? `0 0 10px ${D.crimson}80`
              : `0 0 8px ${D.accent}50`,
          }}
        />
      </div>

      {/* Sub-label */}
      <p
        style={{
          margin: "6px 0 0",
          fontSize: "10px",
          color: atLimit ? "rgba(255,0,0,0.6)" : D.faint,
          lineHeight: "1.5",
          transition: "color 0.3s",
        }}
      >
        {atLimit
          ? "Delete an agent below to free a slot, or upgrade to Pro."
          : current === 0
            ? "No agents yet. Create your first below."
            : `${max - current} slot${max - current !== 1 ? "s" : ""} remaining.`}
      </p>
    </div>
  );
}

