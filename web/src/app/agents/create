              >
                <form onSubmit={handleSubmit} className="p-8 space-y-8">
                  {/* Agent Name */}
                  <div>
                    <label className="block text-sm font-semibold text-white mb-3">
                      Agent Name
                    </label>
                    <input
                      type="text"
                      value={name}
                      onChange={(e) => setName(e.target.value)}
                      placeholder="e.g., BTC Momentum Trader or AAPL Mean Reversion"
                      required
                      disabled={!canCreateMore}
                      className="w-full px-4 py-3.5 rounded-xl bg-white/5 border border-white/10 focus:border-cyan-500/50 focus:ring-2 focus:ring-cyan-500/20 text-white placeholder-gray-500 transition-all outline-none disabled:opacity-50 disabled:cursor-not-allowed"
                    />
                  </div>

                  {/* Backtest Period */}
                  <div>
                    <label className="block text-sm font-semibold text-white mb-3 flex items-center gap-2">
                      <Calendar size={16} className="text-cyan-400" />
                      Backtest Period
                    </label>
                    <div className="grid grid-cols-3 gap-3">
                      {[
                        { d: 90, label: "90 Days", sub: "~3 months" },
                        { d: 180, label: "180 Days", sub: "~6 months" },
                        { d: 365, label: "1 Year", sub: "Most reliable" },
                      ].map(({ d, label, sub }) => (
                        <button
                          key={d}
                          type="button"
                          onClick={() => setBacktestDays(d)}
                          className={`px-4 py-3 rounded-xl border text-sm font-bold transition-all ${backtestDays === d ? "border-cyan-500 bg-cyan-500/15 text-cyan-300" : "border-white/10 bg-white/5 text-gray-400 hover:border-white/20"}`}
                        >
                          <span className="block">{label}</span>
                          <span
                            className={`text-xs font-normal ${backtestDays === d ? "text-cyan-400" : "text-gray-500"}`}
                          >
                            {sub}
                          </span>
                        </button>
                      ))}
                    </div>
                    <p className="mt-2 text-xs text-gray-500">
                      Longer periods give more statistically significant
                      walk-forward OOS windows.
                    </p>
                  </div>

                  {/* Strategy textarea + Analyze button */}
                  <div>
                    <label className="block text-sm font-semibold text-white mb-3 flex items-center justify-between">
                      <span>Trading Strategy in Plain English</span>
                      <button
                        type="button"
                        onClick={analyzeStrategy}
                        disabled={
                          analyzing || !prompt || prompt.trim().length < 20
                        }
                        className="px-4 py-2 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 disabled:from-gray-600 disabled:to-gray-600 text-white text-sm font-bold transition-all flex items-center gap-2"
                      >
                        {analyzing ? (
                          <>
                            <Loader className="animate-spin" size={16} />
                            Analyzing...
                          </>
                        ) : (
                          <>
                            <Sparkles size={16} />
                            Analyze & Improve
                          </>
                        )}
                      </button>
                    </label>
                    <textarea
                      value={prompt}
                      onChange={(e) => setPrompt(e.target.value)}
                      placeholder={
                        "Example:\n• Buy Bitcoin when 50-day MA crosses above 200-day MA. Sell when RSI > 70. Use 2% stop loss.\n• Buy AAPL when RSI drops below 35 and price is above 50-day EMA. Sell at 5% profit or 3% stop loss."
                      }
                      rows={8}
                      required
                      disabled={!canCreateMore}
                      className="w-full px-4 py-3.5 rounded-xl bg-white/5 border border-white/10 focus:border-cyan-500/50 focus:ring-2 focus:ring-cyan-500/20 text-white placeholder-gray-500 transition-all outline-none resize-none font-mono text-sm disabled:opacity-50 disabled:cursor-not-allowed"
                    />
                    <p className="mt-3 text-xs text-gray-500 flex items-start gap-2">
                      <Sparkles
                        size={14}
                        className="flex-shrink-0 mt-0.5 text-cyan-400"
                      />
                      Be specific about entry/exit conditions, indicators, and
                      risk management.
                    </p>
                  </div>

                  {/* Strategy Analysis Panel */}
                  {strategyAnalysis && (
                    <div className="p-6 rounded-2xl bg-gradient-to-br from-purple-500/10 to-pink-500/10 border-2 border-purple-500/30">
                      <div className="flex items-center justify-between mb-6">
                        <div className="flex items-center gap-3">
                          <div
                            className={`text-5xl font-black ${strategyAnalysis.grade === "A" ? "text-emerald-400" : strategyAnalysis.grade === "B" ? "text-cyan-400" : strategyAnalysis.grade === "C" ? "text-amber-400" : "text-red-400"}`}
                          >
                            {strategyAnalysis.grade}
                          </div>
                          <div>
                            <h3 className="text-xl font-black text-white">
                              Strategy Score
                            </h3>
                            <p className="text-sm text-gray-300">
                              {strategyAnalysis.summary}
                            </p>
                          </div>
                        </div>
                        <div className="text-right">
                          <div className="text-4xl font-black text-white mb-1">
                            {strategyAnalysis.score}/100
                          </div>
                          <p className="text-xs text-gray-400">
                            Overall Rating
                          </p>
                        </div>
                      </div>
                      {strategyAnalysis.strengths?.length > 0 && (
                        <div className="mb-4">
                          <h4 className="text-sm font-bold text-emerald-400 mb-2">
                            Strengths
                          </h4>
                          <div className="space-y-1">
                            {strategyAnalysis.strengths.map((s, i) => (
                              <p key={i} className="text-sm text-emerald-300">
                                {s}
                              </p>
                            ))}
                          </div>
                        </div>
                      )}
                      {strategyAnalysis.weaknesses?.length > 0 && (
                        <div className="mb-4">
                          <h4 className="text-sm font-bold text-red-400 mb-2">
                            Critical Issues
                          </h4>
                          <div className="space-y-2">
                            {strategyAnalysis.weaknesses.map((w, i) => (
                              <div
                                key={i}
                                className="p-3 rounded-lg bg-red-900/20 border border-red-500/20"
                              >
                                <p className="text-sm font-semibold text-red-400 mb-1">
                                  {w.issue}
                                </p>
                                <p className="text-xs text-red-300">
                                  {w.description}
                                </p>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                      {strategyAnalysis.improvements?.length > 0 && (
                        <div className="mb-6">
                          <h4 className="text-sm font-bold text-cyan-400 mb-2">
                            Recommended Improvements
                          </h4>
                          <div className="space-y-2">
                            {strategyAnalysis.improvements.map((imp, i) => (
                              <div
                                key={i}
                                className="p-3 rounded-lg bg-cyan-900/20 border border-cyan-500/20"
                              >
                                <p className="text-sm font-semibold text-cyan-400 mb-1">
                                  {imp.suggestion}
                                </p>
                                <p className="text-xs text-cyan-300">
                                  Impact: {imp.impact}
                                </p>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                      {strategyAnalysis.improvements?.length > 0 && (
                        <button
                          type="button"
                          onClick={applyImprovements}
                          disabled={applyingImprovements}
                          className="w-full px-6 py-4 rounded-xl bg-gradient-to-r from-emerald-600 to-cyan-600 hover:from-emerald-500 hover:to-cyan-500 disabled:from-gray-600 disabled:to-gray-600 text-white font-black text-lg transition-all flex items-center justify-center gap-3"
                        >
                          {applyingImprovements ? (
                            <>
                              <Loader className="animate-spin" size={20} />
                              Applying...
                            </>
                          ) : (
                            <>
                              <Zap size={20} />
                              Apply All Improvements
                            </>
                          )}
                        </button>
                      )}
                    </div>
                  )}

                  {error && !agentLimitReached && (
                    <div className="p-4 rounded-xl bg-red-500/10 border border-red-500/20 flex items-start gap-3">
                      <AlertCircle
                        className="text-red-400 flex-shrink-0 mt-0.5"
                        size={20}
                      />
                      <div>
                        <p className="text-sm font-medium text-red-400 mb-1">
                          Failed to create agent
                        </p>
                        <p className="text-sm text-red-300">{error}</p>
                      </div>
                    </div>
                  )}

                  {/* Step progress */}
                  {loading && creationStep && (
                    <div className="p-5 rounded-xl bg-white/[0.03] border border-white/8">
                      <div className="flex items-center justify-between mb-3">
                        <p className="text-sm font-semibold text-white">
                          Creating your agent…
                        </p>
                        <p className="text-xs text-gray-500">
                          Takes 30–90 seconds
                        </p>
                      </div>
                      <div className="flex items-center gap-1">
                        {[
                          { key: "parsing", label: "Parsing" },
                          { key: "backtesting", label: "Backtesting" },
                          { key: "validating", label: "Validating" },
                        ].map(({ key, label }, idx) => {
                          const steps = [
                            "parsing",
                            "backtesting",
                            "validating",
                          ];
                          const stepIdx = steps.indexOf(creationStep);
                          const thisIdx = steps.indexOf(key);
                          const isDone = thisIdx < stepIdx;
                          const isActive = thisIdx === stepIdx;
                          const stepColor = isDone
                            ? "#34D399"
                            : isActive
                              ? "#5B8CFF"
                              : "#374151";
                          return (
                            <div
                              key={key}
                              style={{
                                flex: 1,
                                display: "flex",
                                alignItems: "center",
                                gap: 4,
                              }}
                            >
                              <div style={{ flex: 1 }}>
                                <div
                                  style={{
                                    height: 3,
                                    borderRadius: 2,
                                    background: stepColor,
                                    opacity: isActive ? 1 : isDone ? 1 : 0.25,
                                    transition: "all 0.4s ease",
                                  }}
                                />
                                <p
                                  style={{
                                    fontSize: 10,
                                    color: isActive
                                      ? "#EEF2FF"
                                      : isDone
                                        ? "#34D399"
                                        : "#4A5568",
                                    marginTop: 4,
                                    textAlign: "center",
                                  }}
                                >
                                  {isDone ? "✓ " : ""}
                                  {label}
                                </p>
                              </div>
                              {idx < 2 && (
                                <div style={{ width: 6, flexShrink: 0 }} />
                              )}
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  )}

                  <button
                    type="submit"
                    disabled={
                      loading ||
                      !canCreateMore ||
                      (subscription?.usage?.remaining ?? 1) === 0
                    }
                    className="group relative w-full bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-600 hover:from-cyan-400 hover:via-blue-400 hover:to-purple-500 disabled:from-white/5 disabled:via-white/5 disabled:to-white/5 disabled:cursor-not-allowed text-white disabled:text-gray-500 px-8 py-4 rounded-xl font-bold text-lg transition-all flex items-center justify-center gap-3 shadow-2xl shadow-cyan-500/30 hover:shadow-cyan-400/40 hover:scale-[1.02] active:scale-[0.98] overflow-hidden border border-transparent disabled:border-white/10"
                  >
                    <div className="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-1000" />
                    {loading ? (
                      <>
                        <Loader className="animate-spin" size={24} />
                        <span>
                          {creationStep === "parsing" && "Parsing Strategy…"}
                          {creationStep === "backtesting" &&
                            `Backtesting ${backtestDays} Days…`}
                          {creationStep === "validating" &&
                            "Running Monte Carlo + Walk-Forward…"}
                          {!creationStep && "Creating Agent…"}
                        </span>
                      </>
                    ) : !canCreateMore ? (
                      <>
                        <AlertCircle size={24} />
                        <span>Slot Limit Reached</span>
                      </>
                    ) : (
                      <>
                        <Sparkles size={24} />
                        <span className="relative z-10">
                          Create AI Trading Agent ({backtestDays}-Day Backtest)
                        </span>
                      </>
                    )}
                  </button>
                </form>
              </div>
            </div>

            {/* Pro tips */}
            <div className="mt-6 p-6 rounded-2xl bg-gradient-to-br from-cyan-500/10 to-purple-500/10 border border-cyan-500/20">
              <h3 className="text-sm font-semibold text-white mb-4 flex items-center gap-2">
                <Sparkles className="text-cyan-400" size={16} />
                Pro Tips for Better AI Agents
              </h3>
              <ul className="space-y-2 text-sm text-gray-300">
                <li className="flex items-start gap-2">
                  <span className="text-cyan-400 flex-shrink-0">•</span>
                  <span>
                    Specify exact entry and exit conditions (e.g., "RSI below
                    30" not just "oversold")
                  </span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-cyan-400 flex-shrink-0">•</span>
                  <span>
                    Include risk management rules: stop loss %, position sizing,
                    max drawdown limit
                  </span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-cyan-400 flex-shrink-0">•</span>
                  <span>
                    Stocks: AAPL, TSLA, NVDA, SPY, QQQ. Crypto: BTC, ETH, SOL.
                  </span>
                </li>
                <li className="flex items-start gap-2">
                  <span className="text-cyan-400 flex-shrink-0">•</span>
                  <span>
                    Use 1-year backtest for walk-forward validation with more
                    statistically meaningful OOS windows.
                  </span>
                </li>
              </ul>
            </div>
          </div>

          {/* ════ RIGHT: Active Roster ════════════════════════════════════════ */}
          <ActiveRoster
            agents={agents}
            agentCount={agentCount}
            maxAgents={maxAgents}
            onDelete={handleDeleteAgent}
            deleteLoading={deleteLoading}
            isSyncing={agentFetchStatus === "loading"}
          />
        </div>
      </div>

      {showPaywall && (
        <PaywallModal
          onClose={() => setShowPaywall(false)}
          userTier={subscription?.tier || "free"}
        />
      )}

      <style jsx global>{`
        @keyframes rosterSpin {
          from { transform: rotate(0deg); }
          to   { transform: rotate(360deg); }
        }
        @keyframes limitPulse {
          0%, 100% { opacity: 1; }
          50%       { opacity: 0.55; }
        }
        .lg\\:grid-cols-\\[1fr_380px\\] {
          grid-template-columns: 1fr 380px;
        }
        @media (max-width: 1023px) {
          .lg\\:grid-cols-\\[1fr_380px\\] {
            grid-template-columns: 1fr;
          }
        }
      `}</style>
    </InternalLayout>
  );
}



