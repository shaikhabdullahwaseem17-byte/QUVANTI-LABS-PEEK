// ─────────────────────────────────────────────────────────────────────────────
// MAIN PAGE
// ─────────────────────────────────────────────────────────────────────────────
export default function CreateAgent() {
  // ── OmniStore ──────────────────────────────────────────────────────────────
  const agents = useOmniStore((s) => s.agents);
  const agentCount = useOmniStore((s) => s.agentCount);
  const agentFetchStatus = useOmniStore((s) => s.agentFetchStatus);
  const syncAgents = useOmniStore((s) => s.syncAgents);
  const removeAgentOptimistic = useOmniStore((s) => s.removeAgentOptimistic);
  const userTier = useOmniStore((s) => s.userTier);
  const syncSubscription = useOmniStore((s) => s.syncSubscription);

  // ── Local form state ───────────────────────────────────────────────────────
  const [name, setName] = useState("");
  const [prompt, setPrompt] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [subscription, setSubscription] = useState(null);
  const [showPaywall, setShowPaywall] = useState(false);
  const [agentLimitReached, setAgentLimitReached] = useState(false);
  const [deleteLoading, setDeleteLoading] = useState(null);
  const [strategyImported, setStrategyImported] = useState(false);
  const [backtestDays, setBacktestDays] = useState(90);

  const [createdAgent, setCreatedAgent] = useState(null);
  const [backtestResults, setBacktestResults] = useState(null);
  const [creationStep, setCreationStep] = useState(null);
  const [usedFallback, setUsedFallback] = useState(false);
  const [backendWarnings, setBackendWarnings] = useState([]);

  const [analyzing, setAnalyzing] = useState(false);
  const [strategyAnalysis, setStrategyAnalysis] = useState(null);
  const [applyingImprovements, setApplyingImprovements] = useState(false);

  // ── Derived from OmniStore ─────────────────────────────────────────────────
  const maxAgents = userTier === "pro" ? 10 : 1;
  const canCreateMore = agentCount < maxAgents;
  const atLimit = agentCount >= maxAgents;

  // ── Init ───────────────────────────────────────────────────────────────────
  useEffect(() => {
    // Sync both subscription and agents from OmniStore on mount
    syncAgents();
    syncSubscription();
    loadSubscriptionLocal();

    try {
      const pending = localStorage.getItem("pendingStrategy");
      if (pending) {
        const { prompt: savedPrompt, timestamp } = JSON.parse(pending);
        if (Date.now() - timestamp < 5 * 60 * 1000 && savedPrompt) {
          setPrompt(savedPrompt);
          setStrategyImported(true);
          localStorage.removeItem("pendingStrategy");
          setTimeout(() => setStrategyImported(false), 5000);
        } else {
          localStorage.removeItem("pendingStrategy");
        }
      }
    } catch (e) {
      console.error("Error loading pending strategy:", e);
    }
  }, []);

  // Keep subscription banner up to date
  const loadSubscriptionLocal = async () => {
    try {
      const res = await fetch("/api/subscription/status");
      if (res.ok) setSubscription(await res.json());
    } catch (e) {
      console.error("loadSubscriptionLocal:", e);
    }
  };

  // ── Delete handler — optimistic via OmniStore ──────────────────────────────
  const handleDeleteAgent = useCallback(
    async (agentId) => {
      if (!confirm("Delete this agent? This action cannot be undone.")) return;
      setDeleteLoading(agentId);

      // Optimistic: remove from store instantly → agentCount drops immediately
      removeAgentOptimistic(agentId);
      setAgentLimitReached(false);
      setError(null);

      try {
        const res = await fetch("/api/agents/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ agentId }),
        });
        if (!res.ok) throw new Error("Failed to delete agent");
        // Reconcile with server truth
        await syncAgents();
      } catch (e) {
        console.error("[CreateAgent.handleDeleteAgent]", e.message);
        setError("Failed to delete agent. Please try again.");
        // Rollback: re-sync to restore correct state
        await syncAgents();
      } finally {
        setDeleteLoading(null);
      }
    },
    [removeAgentOptimistic, syncAgents],
  );

  // ── Create handler ─────────────────────────────────────────────────────────
  const handleSubmit = async (e) => {
    e.preventDefault();
    setError(null);
    setLoading(true);
    setAgentLimitReached(false);
    setCreationStep("parsing");
    setUsedFallback(false);
    setBackendWarnings([]);

    const idempotencyKey =
      typeof crypto !== "undefined" && crypto.randomUUID
        ? crypto.randomUUID()
        : Math.random().toString(36).slice(2);

    const timeoutId = setTimeout(() => {
      setError("Request timed out after 2 minutes. Please try again.");
      setLoading(false);
      setCreationStep(null);
    }, 120000);

    const stepTimer1 = setTimeout(() => setCreationStep("backtesting"), 8000);
    const stepTimer2 = setTimeout(() => setCreationStep("validating"), 25000);

    try {
      const response = await fetch("/api/agents/create", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-idempotency-key": idempotencyKey,
        },
        body: JSON.stringify({
          name,
          naturalLanguagePrompt: prompt,
          backtestDays,
        }),
      });

      clearTimeout(timeoutId);
      clearTimeout(stepTimer1);
      clearTimeout(stepTimer2);

      let data;
      try {
        data = await response.json();
      } catch {
        throw new Error(
          "Server returned an invalid response. Please try again.",
        );
      }

      if (response.status === 403 && data.error === "usage_limit_reached") {
        setShowPaywall(true);
        setLoading(false);
        setCreationStep(null);
        return;
      }
      if (response.status === 403 && data.error === "agent_limit_reached") {
        setAgentLimitReached(true);
        setError(data.message);
        setLoading(false);
        setCreationStep(null);
        await syncAgents();
        return;
      }
      if (data.error === "validation_error") {
        const fieldMessages = Object.entries(data.fields || {})
          .filter(([, v]) => v)
          .map(([, v]) => v)
          .join(". ");
        throw new Error(fieldMessages || data.message);
      }
      if (!response.ok) {
        throw new Error(
          data.message ||
            data.details ||
            data.error ||
            "Server error " + response.status,
        );
      }
      if (!data.agent?.id) {
        throw new Error(
          "Server response is missing agent information. Please try again.",
        );
      }

      setCreatedAgent(data.agent);
      setBacktestResults(data.backtest);
      setUsedFallback(data.usedFallbackStrategy || false);
      setBackendWarnings(data.warnings || []);
      setCreationStep("complete");
      setLoading(false);

      // Sync roster immediately after creation → agentCount updates across all pages
      await syncAgents();
    } catch (err) {
      clearTimeout(timeoutId);
      clearTimeout(stepTimer1);
      clearTimeout(stepTimer2);
      setError(err.message);
      setLoading(false);
      setCreationStep(null);
    }
  };

  // ── Strategy analysis ──────────────────────────────────────────────────────
  const analyzeStrategy = async () => {
    if (!prompt || prompt.trim().length < 20) {
      alert("Please enter a strategy first");
      return;
    }
    setAnalyzing(true);
    setStrategyAnalysis(null);
    try {
      const res = await fetch("/api/strategy/improve", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ strategyText: prompt }),
      });
      if (!res.ok) throw new Error("Analysis failed");
      const d = await res.json();
      setStrategyAnalysis(d.analysis);
    } catch (e) {
      console.error(e);
      alert("Failed to analyze strategy");
    } finally {
      setAnalyzing(false);
    }
  };

  const applyImprovements = async () => {
    setApplyingImprovements(true);
    try {
      const res = await fetch("/api/strategy/apply-improvements", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          originalStrategy: prompt,
          improvements: strategyAnalysis.improvements,
        }),
      });
      if (!res.ok) throw new Error("Failed to apply improvements");
      const d = await res.json();
      setPrompt(d.improvedStrategy);
      setStrategyAnalysis(null);
      alert(`${d.improvementsApplied} improvements applied!`);
    } catch (e) {
      console.error(e);
      alert("Failed to apply improvements");
    } finally {
      setApplyingImprovements(false);
    }
  };

  // ── Results View (unchanged) ───────────────────────────────────────────────
  if (createdAgent && backtestResults) {
    const fmtCurrency = (v, compact = false) => {
      const num = Number(v);
      if (isNaN(num)) return "$—";
      const abs = Math.abs(num);
      const sign = num < 0 ? "-" : "";
      if (compact) {
        if (abs >= 1_000_000) return `${sign}$${(abs / 1_000_000).toFixed(2)}M`;
        if (abs >= 10_000) return `${sign}$${(abs / 1_000).toFixed(1)}K`;
        if (abs >= 1_000) return `${sign}$${(abs / 1_000).toFixed(2)}K`;
      }
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
      }).format(num);
