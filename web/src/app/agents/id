                    padding: "12px 16px",
                    borderRadius: 10,
                    background: "rgba(255,255,255,0.03)",
                    border: "1px solid rgba(255,255,255,0.06)",
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "center",
                  }}
                >
                  <div>
                    <p
                      style={{
                        fontWeight: 600,
                        color: "#EEF2FF",
                        fontSize: 13,
                        margin: 0,
                      }}
                    >
                      {t.symbol}
                    </p>
                    <p style={{ fontSize: 11, color: "#4A5568", margin: 0 }}>
                      {t.trigger_type.replace(/_/g, " ")}
                    </p>
                  </div>
                  <span
                    style={{
                      padding: "2px 10px",
                      borderRadius: 20,
                      fontSize: 10,
                      fontWeight: 700,
                      background: t.is_active
                        ? "rgba(52,211,153,0.12)"
                        : "rgba(75,85,99,0.12)",
                      color: t.is_active ? "#34D399" : "#6B7280",
                    }}
                  >
                    {t.is_active ? "Active" : "Inactive"}
                  </span>
                </div>
              ))}
            </div>
          </Section>
        )}

        {/* Risk Rules */}
        {riskRules.length > 0 && (
          <Section title="🛡️ Risk Management Rules">
            <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
              {riskRules.map((r) => (
                <div
                  key={r.id}
                  style={{
                    padding: "12px 16px",
                    borderRadius: 10,
                    background: "rgba(251,191,36,0.04)",
                    border: "1px solid rgba(251,191,36,0.12)",
                  }}
                >
                  <p
                    style={{
                      fontWeight: 700,
                      color: "#FBBF24",
                      fontSize: 12,
                      margin: "0 0 4px",
                    }}
                  >
                    {r.rule_type.replace(/_/g, " ").toUpperCase()}
                  </p>
                  <p
                    style={{
                      fontSize: 11,
                      color: "#8B9EB5",
                      margin: 0,
                      fontFamily: "monospace",
                    }}
                  >
                    {JSON.stringify(r.parameters)}
                  </p>
                </div>
              ))}
            </div>
          </Section>
        )}

        {/* Positions */}
        {positions.length > 0 && (
          <Section title="📂 Open Positions">
            <div style={{ overflowX: "auto" }}>
              <table
                style={{
                  width: "100%",
                  borderCollapse: "collapse",
                  fontSize: 13,
                }}
              >
                <thead>
                  <tr>
                    {[
                      "Symbol",
                      "Qty",
                      "Avg Price",
                      "Current",
                      "Unrealised P&L",
                    ].map((h) => (
                      <th
                        key={h}
                        style={{
                          textAlign: h === "Symbol" ? "left" : "right",
                          padding: "8px 12px",
                          color: "#4A5568",
                          fontWeight: 600,
                          fontSize: 11,
                          textTransform: "uppercase",
                          letterSpacing: 0.5,
                          borderBottom: "1px solid rgba(255,255,255,0.06)",
                        }}
                      >
                        {h}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {positions.map((p) => {
                    const pnl = parseFloat(p.unrealized_pnl || 0);
                    return (
                      <tr
                        key={p.id}
                        style={{
                          borderBottom: "1px solid rgba(255,255,255,0.04)",
                        }}
                      >
                        <td
                          style={{
                            padding: "10px 12px",
                            color: "#EEF2FF",
                            fontWeight: 600,
                          }}
                        >
                          {p.symbol}
                        </td>
                        <td
                          style={{
                            padding: "10px 12px",
                            textAlign: "right",
                            color: "#8B9EB5",
                            fontFamily: "monospace",
                          }}
                        >
                          {parseFloat(p.quantity).toFixed(4)}
                        </td>
                        <td
                          style={{
                            padding: "10px 12px",
                            textAlign: "right",
                            color: "#8B9EB5",
                            fontFamily: "monospace",
                          }}
                        >
                          {fmtCurrency(p.average_price)}
                        </td>
                        <td
                          style={{
                            padding: "10px 12px",
                            textAlign: "right",
                            color: "#8B9EB5",
                            fontFamily: "monospace",
                          }}
                        >
                          {fmtCurrency(p.current_price || p.average_price)}
                        </td>
                        <td
                          style={{
                            padding: "10px 12px",
                            textAlign: "right",
                            fontWeight: 700,
                            fontFamily: "monospace",
                            color: pnl >= 0 ? "#34D399" : "#F87171",
                          }}
                        >
                          {fmtCurrency(pnl)}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </Section>
        )}

        {/* Recent Trades */}
        {recentTrades.length > 0 && (
          <Section title="📜 Recent Trades">
            <div style={{ overflowX: "auto" }}>
              <table
                style={{
                  width: "100%",
                  borderCollapse: "collapse",
                  fontSize: 13,
                }}
              >
                <thead>
                  <tr>
                    {["Date", "Type", "Symbol", "Qty", "Price", "Status"].map(
                      (h) => (
                        <th
                          key={h}
                          style={{
                            textAlign:
                              h === "Date" ||
                              h === "Type" ||
                              h === "Symbol" ||
                              h === "Status"
                                ? "left"
                                : "right",
                            padding: "8px 12px",
                            color: "#4A5568",
                            fontWeight: 600,
                            fontSize: 11,
                            textTransform: "uppercase",
                            letterSpacing: 0.5,
                            borderBottom: "1px solid rgba(255,255,255,0.06)",
                          }}
                        >
                          {h}
                        </th>
                      ),
                    )}
                  </tr>
                </thead>
                <tbody>
                  {recentTrades.map((t) => (
                    <tr
                      key={t.id}
                      style={{
                        borderBottom: "1px solid rgba(255,255,255,0.04)",
                      }}
                    >
                      <td
                        style={{
                          padding: "10px 12px",
                          color: "#4A5568",
                          fontSize: 11,
                        }}
                      >
                        {new Date(t.executed_at).toLocaleString()}
                      </td>
                      <td style={{ padding: "10px 12px" }}>
                        <span
                          style={{
                            padding: "2px 8px",
                            borderRadius: 6,
                            fontSize: 10,
                            fontWeight: 700,
                            background:
                              t.trade_type === "buy"
                                ? "rgba(52,211,153,0.12)"
                                : "rgba(248,113,113,0.12)",
                            color:
                              t.trade_type === "buy" ? "#34D399" : "#F87171",
                          }}
                        >
                          {t.trade_type.toUpperCase()}
                        </span>
                      </td>
                      <td
                        style={{
                          padding: "10px 12px",
                          color: "#EEF2FF",
                          fontWeight: 600,
                        }}
                      >
                        {t.symbol}
                      </td>
                      <td
                        style={{
                          padding: "10px 12px",
                          textAlign: "right",
                          color: "#8B9EB5",
                          fontFamily: "monospace",
                        }}
                      >
                        {parseFloat(t.quantity).toFixed(4)}
                      </td>
                      <td
                        style={{
                          padding: "10px 12px",
                          textAlign: "right",
                          color: "#8B9EB5",
                          fontFamily: "monospace",
                        }}
                      >
                        {fmtCurrency(t.price)}
                      </td>
                      <td
                        style={{
                          padding: "10px 12px",
                          color: "#4A5568",
                          fontSize: 11,
                        }}
                      >
                        {t.status}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </Section>
        )}

        {/* ── AGENT TERMINAL SLIDE-OVER ── */}
        {showTerminal && agent && (
          <AgentTerminal
            agentId={Number(params.id)}
            agentName={agent.name}
            agentData={agent}
            onClose={() => setShowTerminal(false)}
          />
        )}
      </div>
    </div>
  );
}



