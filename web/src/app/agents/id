                trustScore.overall >= 80
                  ? "rgba(52,211,153,0.25)"
                  : trustScore.overall >= 60
                    ? "rgba(251,191,36,0.25)"
                    : "rgba(248,113,113,0.25)"
              }`,
            }}
          >
            <div
              style={{
                display: "flex",
                alignItems: "center",
                gap: 12,
                marginBottom: 16,
                flexWrap: "wrap",
              }}
            >
              <p
                style={{
                  fontWeight: 700,
                  color: "#EEF2FF",
                  fontSize: 14,
                  margin: 0,
                }}
              >
                🔐 Strategy Trust Report
              </p>
              <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
                {(trustScore.badges || []).map((badge, i) => (
                  <span
                    key={i}
                    style={{
                      padding: "2px 10px",
                      borderRadius: 20,
                      fontSize: 10,
                      fontWeight: 700,
                      background: "rgba(255,255,255,0.06)",
                      border: "1px solid rgba(255,255,255,0.1)",
                      color: "#EEF2FF",
                    }}
                  >
                    {badge}
                  </span>
                ))}
              </div>
            </div>
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))",
                gap: 10,
                marginBottom: trustScore.warnings?.length > 0 ? 14 : 0,
              }}
            >
              <KPI
                label="Performance"
                value={`${trustScore.performanceScore}/100`}
                color="#5B8CFF"
                sub={trustScore.breakdown?.performance}
              />
              <KPI
                label="Risk Score"
                value={`${trustScore.riskScore}/100`}
                color="#34D399"
                sub={trustScore.breakdown?.risk}
              />
              <KPI
                label="Stability"
                value={`${Math.floor(trustScore.stabilityScore || 0)}/100`}
                color="#8A7CFF"
                sub={trustScore.breakdown?.stability}
              />
              <KPI
                label="Overall"
                value={`${trustScore.overall}/100`}
                color={
                  trustScore.overall >= 80
                    ? "#34D399"
                    : trustScore.overall >= 60
                      ? "#FBBF24"
                      : "#F87171"
                }
                sub={trustScore.verified ? "✅ VERIFIED" : "⚠️ UNVERIFIED"}
              />
            </div>
            {trustScore.warnings?.length > 0 && (
              <div style={{ display: "flex", flexDirection: "column", gap: 4 }}>
                {trustScore.warnings.map((w, i) => (
                  <p
                    key={i}
                    style={{ fontSize: 11, color: "#F59E0B", margin: 0 }}
                  >
                    {w}
                  </p>
                ))}
              </div>
            )}
          </div>
        )}

        {/* ══ STRATEGY DIAGNOSTICS ══════════════════════════════════════════════ */}
        {hasBacktest ? (
          <>
            {/* ── Institutional KPI Grid ─────────────────────────────────────── */}
            <Section
              title="📊 Institutional Performance Metrics"
              subtitle={`Backtest period: ${bt.total_trades} trades · Initial capital: ${fmtCurrency(initCap)}`}
            >
              <div
                style={{
                  display: "grid",
                  gridTemplateColumns: "repeat(auto-fit, minmax(145px, 1fr))",
                  gap: 10,
                }}
              >
                <KPI
                  label="Total Return"
                  value={fmtPct(bt.total_return)}
                  color={returnColor(bt.total_return)}
                  sub="vs initial capital"
                />
                <KPI
                  label="Sharpe Ratio"
                  value={fmtNum(bt.sharpe_ratio, 2)}
                  color={sharpeColor(bt.sharpe_ratio)}
                  sub=">1.5 = institutional"
                />
                <KPI
                  label="Max Drawdown"
                  value={fmtPct(bt.max_drawdown, false)}
                  color={drawdownColor(bt.max_drawdown)}
                  sub="peak-to-trough"
                />
                <KPI
                  label="Win Rate"
                  value={fmtPct(bt.win_rate, false)}
                  color={winRateColor(bt.win_rate)}
                  sub="% of closed trades"
                />
                <KPI
                  label="Total Trades"
                  value={bt.total_trades}
                  color="#8B9EB5"
                  sub="30+ = statistically valid"
                />
                {mc && (
                  <>
                    <KPI
                      label="Prob. of Ruin"
                      value={fmtNum(mc.probabilityOfRuin, 1) + "%"}
                      color={
                        mc.probabilityOfRuin > 15
                          ? "#F87171"
                          : mc.probabilityOfRuin > 5
                            ? "#FBBF24"
                            : "#34D399"
                      }
                      sub="<5% = low risk"
                    />
                    <KPI
                      label="Expected Return"
                      value={fmtPct(mc.expectedReturn)}
                      color={returnColor(mc.expectedReturn)}
                      sub="MC median (1,000 paths)"
                    />
                    <KPI
                      label="DD P95"
                      value={
                        fmtNum(mc.confidenceIntervals?.maxDrawdown?.upper, 1) +
                        "%"
                      }
                      color="#F87171"
                      sub="worst 5% of scenarios"
                    />
                  </>
                )}
              </div>
            </Section>

            {/* ── Equity Curve ───────────────────────────────────────────────── */}
            <Section
              title="📈 Equity Curve"
              subtitle="Entry markers (▲) = BUY · Exit markers (▼) = SELL · Dashed = break-even"
            >
              <EquityChart
                equityCurve={equity}
                trades={btTrades}
                initialCapital={initCap}
              />
            </Section>

            {/* ── Monte Carlo Fan Chart ──────────────────────────────────────── */}
            <Section
              title="🎲 Monte Carlo Simulation"
              subtitle="1,000 bootstrap paths · Shaded bands = 95% and 99% confidence intervals"
              badge={
                mc
                  ? {
                      text: `P(Ruin) = ${fmtNum(mc.probabilityOfRuin, 1)}%`,
                      color:
                        mc.probabilityOfRuin > 15
                          ? "#F87171"
                          : mc.probabilityOfRuin > 5
                            ? "#FBBF24"
                            : "#34D399",
                    }
                  : null
              }
            >
              <MonteCarloChart mc={mc} initialCapital={initCap} />
              {mc && (
                <div
                  style={{
                    display: "grid",
                    gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))",
                    gap: 10,
                    marginTop: 18,
                  }}
                >
                  <KPI
                    label="Best Case"
                    value={fmtCurrency(mc.bestCase)}
                    color="#34D399"
                  />
                  <KPI
                    label="P95 Outcome"
                    value={fmtCurrency(
                      mc.confidenceIntervals?.finalCapital?.upper,
                    )}
                    color="#5B8CFF"
                  />
                  <KPI
                    label="Median"
                    value={fmtCurrency(mc.median)}
                    color="#EEF2FF"
                  />
                  <KPI
                    label="P5 Outcome"
                    value={fmtCurrency(
                      mc.confidenceIntervals?.finalCapital?.lower,
                    )}
                    color="#FBBF24"
                  />
                  <KPI
                    label="Worst Case"
                    value={fmtCurrency(mc.worstCase)}
                    color="#F87171"
                  />
                </div>
              )}
            </Section>

            {/* ── Hurst + WFA side-by-side ───────────────────────────────────── */}
            <div
              style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(280px, 1fr))",
                gap: 20,
                marginBottom: 20,
              }}
            >
              <Section
                title="〰 Hurst Exponent"
                subtitle="Measures the mathematical regime of the asset"
              >
                <HurstCard hurst={hurst} />
              </Section>
              <Section
                title="🔄 Walk-Forward Analysis"
                subtitle="Blue = In-Sample · Green/Red = Out-of-Sample pass/fail"
                badge={
                  wfa
                    ? {
                        text: wfa.passedValidation ? "PASSED" : "FAILED",
                        color: wfa.passedValidation ? "#34D399" : "#F87171",
                      }
                    : null
                }
              >
                {wfa && (
                  <div style={{ marginBottom: 12 }}>
                    <div
                      style={{
                        display: "grid",
                        gridTemplateColumns: "1fr 1fr 1fr",
                        gap: 8,
                        marginBottom: 14,
                      }}
                    >
                      <KPI
                        label="IS Return"
                        value={fmtPct(wfa.averageInSampleReturn)}
                        color="#5B8CFF"
                      />
                      <KPI
                        label="OOS Return"
                        value={fmtPct(wfa.averageOutOfSampleReturn)}
                        color={returnColor(wfa.averageOutOfSampleReturn)}
                      />
                      <KPI
                        label="Degradation"
                        value={fmtNum(wfa.degradationPercent, 1) + "%"}
                        color={
                          wfa.degradationPercent > 50 ? "#F87171" : "#34D399"
                        }
                      />
                    </div>
                  </div>
                )}
                <WFAChart wfa={wfa} />
              </Section>
            </div>

            {/* ── Overfitting Analysis ───────────────────────────────────────── */}
            <Section
              title="🔬 Overfitting Detection"
              subtitle="Flags curve-fitting via Win Rate, Profit Factor, Sharpe, and sample size heuristics"
              badge={
                overfit
                  ? {
                      text: overfit.overfitDetected ? "HIGH RISK" : "LOW RISK",
                      color: overfit.overfitDetected ? "#F87171" : "#34D399",
                    }
                  : null
              }
            >
              <OverfitCard analysis={overfit} />
            </Section>
          </>
        ) : (
          /* ── No Backtest ──────────────────────────────────────────────────── */
          <Section title="📊 Strategy Diagnostics">
            <div style={{ textAlign: "center", padding: "40px 20px" }}>
