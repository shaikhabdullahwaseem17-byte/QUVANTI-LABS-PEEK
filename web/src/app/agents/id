// ─── Number formatters ────────────────────────────────────────────────────────
function fmtCurrency(v) {
  const n = Number(v);
  if (isNaN(n)) return "$—";
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    minimumFractionDigits: 2,
  }).format(n);
}
function fmtPct(v, showSign = true) {
  const n = Number(v);
  if (isNaN(n)) return "—";
  return (showSign && n > 0 ? "+" : "") + n.toFixed(2) + "%";
}
function fmtNum(v, decimals = 2) {
  const n = Number(v);
  if (isNaN(n)) return "—";
  return n.toFixed(decimals);
}

// ─── KPI colour logic ─────────────────────────────────────────────────────────
function sharpeColor(v) {
  const n = Number(v);
  if (n >= 1.5) return "#34D399";
  if (n >= 0.8) return "#FBBF24";
  return "#F87171";
}
function drawdownColor(v) {
  const n = Number(v);
  if (n <= 10) return "#34D399";
  if (n <= 25) return "#FBBF24";
  return "#F87171";
}
function winRateColor(v) {
  const n = Number(v);
  if (n >= 55) return "#34D399";
  if (n >= 45) return "#FBBF24";
  return "#F87171";
}
function returnColor(v) {
  return Number(v) >= 0 ? "#34D399" : "#F87171";
}

// ─── SVG Equity Curve ─────────────────────────────────────────────────────────
function EquityChart({
  equityCurve = [],
  trades = [],
  initialCapital = 10000,
}) {
  const W = 800,
    H = 220,
    PAD = { top: 16, right: 16, bottom: 32, left: 64 };
  const data = equityCurve.slice(0, 300);
  if (data.length < 2)
    return (
      <div
        style={{
          height: H,
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          color: "#4A5568",
          fontSize: 13,
        }}
      >
        No equity data available
      </div>
    );

  const values = data.map((d) => d.equity || d);
  const minV = Math.min(...values);
  const maxV = Math.max(...values);
  const range = maxV - minV || 1;

  const xS = (i) =>
    PAD.left + (i / (data.length - 1)) * (W - PAD.left - PAD.right);
  const yS = (v) =>
    PAD.top + (1 - (v - minV) / range) * (H - PAD.top - PAD.bottom);

  const linePath = data
    .map(
      (d, i) =>
        `${i === 0 ? "M" : "L"}${xS(i).toFixed(1)},${yS(d.equity || d).toFixed(1)}`,
    )
    .join(" ");
  const areaPath =
    linePath +
    ` L${xS(data.length - 1).toFixed(1)},${(H - PAD.bottom).toFixed(1)} L${xS(0).toFixed(1)},${(H - PAD.bottom).toFixed(1)} Z`;

  const finalVal = values[values.length - 1];
  const isProfit = finalVal >= initialCapital;
  const lineColor = isProfit ? "#34D399" : "#F87171";
  const gradId = isProfit ? "eqGreen" : "eqRed";

  // Y-axis ticks
  const yTicks = [0, 0.25, 0.5, 0.75, 1].map((p) => ({
    y: PAD.top + (1 - p) * (H - PAD.top - PAD.bottom),
    label: fmtCurrency(minV + p * range),
  }));

  return (
    <svg
      viewBox={`0 0 ${W} ${H}`}
      style={{ width: "100%", height: H, display: "block" }}
    >
      <defs>
        <linearGradient id={gradId} x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stopColor={lineColor} stopOpacity="0.25" />
          <stop offset="100%" stopColor={lineColor} stopOpacity="0.01" />
        </linearGradient>
      </defs>
      {/* Grid lines */}
      {yTicks.map((t, i) => (
        <g key={i}>
          <line
            x1={PAD.left}
            x2={W - PAD.right}
            y1={t.y}
            y2={t.y}
            stroke="rgba(255,255,255,0.06)"
            strokeWidth="1"
            strokeDasharray="4 4"
          />
          <text
            x={PAD.left - 6}
            y={t.y + 4}
            textAnchor="end"
            fill="#4A5568"
            fontSize="9"
            fontFamily="monospace"
          >
            {t.label}
          </text>
        </g>
      ))}
      {/* Break-even line */}
      <line
        x1={PAD.left}
        x2={W - PAD.right}
        y1={yS(initialCapital)}
        y2={yS(initialCapital)}
        stroke="rgba(255,255,255,0.18)"
        strokeWidth="1"
        strokeDasharray="6 3"
      />
      {/* Area fill */}
      <path d={areaPath} fill={`url(#${gradId})`} />
      {/* Equity line */}
      <path
        d={linePath}
        fill="none"
        stroke={lineColor}
        strokeWidth="1.8"
        strokeLinejoin="round"
      />
      {/* Trade markers (BUY = triangle up, SELL = triangle down) */}
      {trades.slice(0, 60).map((t, i) => {
        const idx = Math.min(
          Math.round((i / trades.length) * (data.length - 1)),
          data.length - 1,
        );
        const cx = xS(idx);
        const cy = yS(data[idx]?.equity || values[idx] || minV);
        const isBuy = t.action === "BUY";
        return (
          <polygon
            key={i}
            points={
              isBuy
                ? `${cx},${cy - 7} ${cx - 4},${cy} ${cx + 4},${cy}`
                : `${cx},${cy + 7} ${cx - 4},${cy} ${cx + 4},${cy}`
            }
            fill={isBuy ? "#34D399" : "#F87171"}
            opacity="0.85"
          />
        );
      })}
    </svg>
  );
}

// ─── Monte Carlo Fan Chart ────────────────────────────────────────────────────
function MonteCarloChart({ mc, initialCapital = 10000 }) {
  if (!mc?.confidenceIntervals)
    return (
      <div
        style={{
          height: 180,
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          color: "#4A5568",
          fontSize: 13,
        }}
      >
        Monte Carlo data not available (requires 5+ closed trades)
      </div>
    );

  const W = 600,
    H = 180,
    PAD = { top: 16, right: 24, bottom: 28, left: 72 };
  const ci = mc.confidenceIntervals.finalCapital;
  const allVals = [
    mc.worstCase,
    ci.lower,
    ci.median,
    ci.upper,
    mc.bestCase,
    initialCapital,
  ].filter(Boolean);
  const minV = Math.min(...allVals);
  const maxV = Math.max(...allVals);
  const range = maxV - minV || 1;

  // We draw a "fan" from left (initial capital) to right (outcomes)
  // 5 horizontal outcome levels → fan from point to spread
  const x0 = PAD.left;
  const x1 = W - PAD.right;
  const yS = (v) =>
    PAD.top + (1 - (v - minV) / range) * (H - PAD.top - PAD.bottom);

  const yWorst = yS(mc.worstCase || minV);
  const yLower = yS(ci.lower);
  const yMedian = yS(ci.median);
  const yUpper = yS(ci.upper);
  const yBest = yS(mc.bestCase || maxV);
  const yStart = yS(initialCapital);

  const yTicks = [0, 0.25, 0.5, 0.75, 1].map((p) => ({
    y: PAD.top + (1 - p) * (H - PAD.top - PAD.bottom),
    label: fmtCurrency(minV + p * range),
  }));

  return (
    <svg
      viewBox={`0 0 ${W} ${H}`}
      style={{ width: "100%", height: H, display: "block" }}
    >
      <defs>
        <linearGradient id="fanGrad99" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stopColor="#5B8CFF" stopOpacity="0.08" />
          <stop offset="100%" stopColor="#5B8CFF" stopOpacity="0.18" />
        </linearGradient>
        <linearGradient id="fanGrad95" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stopColor="#5B8CFF" stopOpacity="0.15" />
          <stop offset="100%" stopColor="#5B8CFF" stopOpacity="0.30" />
        </linearGradient>
      </defs>
      {/* Grid */}
      {yTicks.map((t, i) => (
        <g key={i}>
          <line
            x1={PAD.left}
            x2={W - PAD.right}
            y1={t.y}
            y2={t.y}
            stroke="rgba(255,255,255,0.05)"
            strokeWidth="1"
            strokeDasharray="3 3"
          />
          <text
            x={PAD.left - 6}
            y={t.y + 4}
            textAnchor="end"
            fill="#4A5568"
            fontSize="9"
            fontFamily="monospace"
          >
            {t.label}
          </text>
        </g>
      ))}
      {/* 99% band (worst → best) */}
      <polygon
        points={`${x0},${yStart} ${x1},${yBest} ${x1},${yWorst}`}
        fill="url(#fanGrad99)"
      />
      {/* 95% band (lower → upper) */}
      <polygon
        points={`${x0},${yStart} ${x1},${yUpper} ${x1},${yLower}`}
        fill="url(#fanGrad95)"
      />
      {/* Median line */}
      <line
        x1={x0}
        y1={yStart}
        x2={x1}
        y2={yMedian}
        stroke="#5B8CFF"
        strokeWidth="2"
      />
      {/* Break-even */}
      <line
        x1={PAD.left}
        x2={W - PAD.right}
        y1={yStart}
        y2={yStart}
        stroke="rgba(255,255,255,0.2)"
        strokeWidth="1"
        strokeDasharray="5 3"
      />
      {/* Labels at right edge */}
      <text
        x={x1 + 4}
        y={yBest + 4}
        fill="#34D399"
        fontSize="9"
        fontFamily="monospace"
      >
        Best
      </text>
      <text
        x={x1 + 4}
        y={yUpper + 4}
        fill="#5B8CFF"
        fontSize="9"
        fontFamily="monospace"
      >
        P95
      </text>
      <text
        x={x1 + 4}
        y={yMedian + 4}
        fill="#EEF2FF"
        fontSize="9"
        fontFamily="monospace"
      >
        P50
      </text>
      <text
        x={x1 + 4}
        y={yLower + 4}
        fill="#FBBF24"
        fontSize="9"
        fontFamily="monospace"
      >
        P5
      </text>
      <text
        x={x1 + 4}
        y={yWorst + 4}
        fill="#F87171"
        fontSize="9"
        fontFamily="monospace"
      >
        Worst
      </text>
    </svg>
  );
}

// ─── Walk-Forward Bar Chart ───────────────────────────────────────────────────
function WFAChart({ wfa }) {
  if (!wfa?.segments || wfa.segments.length === 0)
    return (
      <div
        style={{
          height: 140,
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          color: "#4A5568",
          fontSize: 13,
        }}
      >
        Walk-Forward data not available (requires 100+ candles)
      </div>
    );

  const segs = wfa.segments;
  const W = 500,
    H = 140,
    PAD = { top: 16, right: 16, bottom: 28, left: 64 };
  const allVals = segs.flatMap((s) => [s.inSampleReturn, s.outOfSampleReturn]);
  const minV = Math.min(0, ...allVals);
  const maxV = Math.max(0, ...allVals);
  const range = maxV - minV || 1;

  const zeroY = PAD.top + (1 - (0 - minV) / range) * (H - PAD.top - PAD.bottom);
  const barW = ((W - PAD.left - PAD.right) / segs.length) * 0.38;
  const gap = (W - PAD.left - PAD.right) / segs.length;

  const yS = (v) =>
    PAD.top + (1 - (v - minV) / range) * (H - PAD.top - PAD.bottom);

  return (
    <svg
      viewBox={`0 0 ${W} ${H}`}
      style={{ width: "100%", height: H, display: "block" }}
    >
      {/* Zero line */}
      <line
        x1={PAD.left}
        x2={W - PAD.right}
        y1={zeroY}
        y2={zeroY}
        stroke="rgba(255,255,255,0.2)"
        strokeWidth="1"
      />
      {segs.map((seg, i) => {
        const cx = PAD.left + i * gap + gap / 2;
        // IS bar
        const isH = Math.abs(yS(seg.inSampleReturn) - zeroY);
        const isY = seg.inSampleReturn >= 0 ? yS(seg.inSampleReturn) : zeroY;
        // OOS bar
        const oosH = Math.abs(yS(seg.outOfSampleReturn) - zeroY);
        const oosY =
          seg.outOfSampleReturn >= 0 ? yS(seg.outOfSampleReturn) : zeroY;

        return (
          <g key={i}>
            <rect
              x={cx - barW - 1}
              y={isY}
              width={barW}
              height={Math.max(1, isH)}
              fill="#5B8CFF"
              rx="2"
              opacity="0.8"
            />
            <rect
              x={cx + 1}
              y={oosY}
              width={barW}
              height={Math.max(1, oosH)}
              fill={seg.passed ? "#34D399" : "#F87171"}
              rx="2"
              opacity="0.8"
            />
            <text
              x={cx}
              y={H - 6}
              textAnchor="middle"
              fill="#4A5568"
              fontSize="9"
            >
              W{seg.segmentIndex}
            </text>
          </g>
        );
      })}
      {/* Y-axis labels */}
      <text
        x={PAD.left - 4}
        y={PAD.top + 10}
        textAnchor="end"
        fill="#4A5568"
        fontSize="9"
        fontFamily="monospace"
      >
        {fmtPct(maxV, false)}
      </text>
      <text
        x={PAD.left - 4}
        y={H - PAD.bottom - 2}
        textAnchor="end"
        fill="#4A5568"
        fontSize="9"
        fontFamily="monospace"
      >
        {fmtPct(minV, false)}
      </text>
      {/* Legend */}
      <rect x={PAD.left} y={4} width={10} height={6} fill="#5B8CFF" rx="1" />
      <text x={PAD.left + 14} y={10} fill="#8B9EB5" fontSize="9">
        In-Sample
      </text>
      <rect
        x={PAD.left + 80}
        y={4}
        width={10}
        height={6}
        fill="#34D399"
        rx="1"
      />
      <text x={PAD.left + 94} y={10} fill="#8B9EB5" fontSize="9">
        Out-of-Sample
      </text>
    </svg>
  );
}

// ─── Hurst Exponent Card ──────────────────────────────────────────────────────
function HurstCard({ hurst }) {
  if (!hurst) return null;
  const H = Number(hurst.H);
  const pct = Math.max(0, Math.min(100, H * 100));
  let color, label, icon;
  if (H < 0.45) {
    color = "#5B8CFF";
    label = "Mean-Reverting";
    icon = "↩";
  } else if (H < 0.55) {
    color = "#FBBF24";
    label = "Random Walk";
    icon = "↔";
  } else {
    color = "#34D399";
    label = "Trending";
    icon = "↗";
  }

  return (
    <div style={{ fontFamily: "monospace" }}>
      <div
        style={{
          display: "flex",
          alignItems: "baseline",
          gap: 10,
          marginBottom: 10,
        }}
      >
        <span
          style={{ fontSize: 36, fontWeight: 900, color, letterSpacing: -1 }}
        >
          {H.toFixed(3)}
        </span>
        <span style={{ fontSize: 18, color }}>{icon}</span>
        <span
          style={{ fontSize: 12, color: "#8B9EB5", fontFamily: "sans-serif" }}
        >
          {label}
        </span>
      </div>
      {/* Spectrum bar */}
      <div
        style={{
          position: "relative",
          height: 6,
          borderRadius: 4,
          background:
            "linear-gradient(90deg, #5B8CFF 0%, #FBBF24 50%, #34D399 100%)",
          marginBottom: 8,
        }}
      >
        <div
          style={{
            position: "absolute",
            top: -3,
            left: `${pct}%`,
            width: 12,
            height: 12,
            borderRadius: "50%",
            background: color,
            border: "2px solid #0D1117",
            transform: "translateX(-50%)",
            boxShadow: `0 0 8px ${color}`,
          }}
        />
      </div>
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          fontSize: 9,
          color: "#4A5568",
          marginBottom: 12,
        }}
      >
        <span>0 — Mean Rev.</span>
        <span>0.5 — Random</span>
        <span>1 — Trending</span>
      </div>
      <p
        style={{
          fontSize: 11,
          color: "#8B9EB5",
          fontFamily: "sans-serif",
          lineHeight: 1.5,
          margin: 0,
        }}
      >
        {hurst.interpretation || hurst.signal || "Hurst analysis complete."}
      </p>
    </div>
  );
}

