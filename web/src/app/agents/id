export default function AgentDetail({ params }) {
  const [agent, setAgent] = useState(null);
  const [triggers, setTriggers] = useState([]);
  const [riskRules, setRiskRules] = useState([]);
  const [positions, setPositions] = useState([]);
  const [recentTrades, setRecentTrades] = useState([]);
  const [backtest, setBacktest] = useState(null);
  const [trustScore, setTrustScore] = useState(null);
  const [loading, setLoading] = useState(true);
  const [backtesting, setBacktesting] = useState(false);
  const [shareLoading, setShareLoading] = useState(false);
  const [shareUrl, setShareUrl] = useState(null);
  const [shareCopied, setShareCopied] = useState(false);
  const [showTerminal, setShowTerminal] = useState(false);

  useEffect(() => {
    loadAgent();
    loadTrustScore();
  }, [params.id]);

  const loadAgent = async () => {
    try {
      const res = await fetch(`/api/agents/${params.id}`);
      if (!res.ok) throw new Error("Failed to load agent");
      const data = await res.json();
      setAgent(data.agent);
      setTriggers(data.triggers || []);
      setRiskRules(data.riskRules || []);
      setPositions(data.positions || []);
      setRecentTrades(data.recentTrades || []);
      setBacktest(data.backtest || null);
    } catch (err) {
      console.error(err);
    } finally {
      setLoading(false);
    }
  };

  const loadTrustScore = async () => {
    try {
      const res = await fetch(`/api/agent/trust-score?agentId=${params.id}`);
      if (res.ok) {
        const d = await res.json();
        setTrustScore(d.trustScore);
      }
    } catch (_) {}
  };

  const toggleStatus = async () => {
    const ns = agent.status === "active" ? "paused" : "active";
    try {
      const res = await fetch(`/api/agents/${params.id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status: ns }),
      });
      if (!res.ok) throw new Error();
      const d = await res.json();
      setAgent(d.agent);
    } catch (_) {}
  };

  const deleteAgent = async () => {
    if (!confirm("Delete this agent permanently?")) return;
    try {
      await fetch(`/api/agents/${params.id}`, { method: "DELETE" });
      if (typeof window !== "undefined") {
        window.location.href = "/agents";
      }
    } catch (_) {}
  };

  const runBacktest = async () => {
    setBacktesting(true);
    try {
      const endDate = new Date().toISOString().split("T")[0];
      const startDate = new Date(Date.now() - 365 * 24 * 60 * 60 * 1000)
        .toISOString()
        .split("T")[0];
      const res = await fetch("/api/backtest/run", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          agentId: params.id,
          startDate,
          endDate,
          initialCapital: 10000,
        }),
      });
      if (!res.ok) throw new Error();
      await loadAgent();
      // Reload trust score — it's computed from the new backtest results
      await loadTrustScore();
    } catch (_) {
      alert("Backtest failed — check console.");
    } finally {
      setBacktesting(false);
    }
  };

  const handleShare = async () => {
    setShareLoading(true);
    try {
      const res = await fetch("/api/agents/share", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ agentId: params.id, action: "enable" }),
      });
      const data = await res.json();
      if (data.url) setShareUrl(data.url);
    } catch (e) {
      console.error("Share failed:", e);
    } finally {
      setShareLoading(false);
    }
  };

  const copyShareUrl = () => {
    if (!shareUrl) return;
    navigator.clipboard.writeText(shareUrl).catch(() => {});
    setShareCopied(true);
    setTimeout(() => setShareCopied(false), 2000);
  };

  // ── Derived values ─────────────────────────────────────────────────────────
  const totalPnL = positions.reduce(
    (s, p) => s + parseFloat(p.unrealized_pnl || 0),
    0,
  );
  const hasBacktest = !!backtest;
  const bt = backtest || {};
  const mc = bt.monteCarlo;
  const wfa = bt.walkForward;
  const hurst = bt.hurst;
  const overfit = bt.overfitAnalysis;
  const equity = bt.equity_curve || [];
  const btTrades = bt.trades || [];
  const initCap = bt.initial_capital || 10000;

  if (loading)
    return (
      <div style={{ minHeight: "100vh", background: "#080B10" }}>
        <AppNav />
        <div
          style={{
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            minHeight: "60vh",
          }}
        >
          <div style={{ color: "#4A5568", fontSize: 14 }}>Loading agent…</div>
        </div>
      </div>
    );

  if (!agent)
    return (
      <div style={{ minHeight: "100vh", background: "#080B10" }}>
        <AppNav />
        <div
          style={{
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            minHeight: "60vh",
          }}
        >
          <div style={{ color: "#4A5568", fontSize: 14 }}>Agent not found.</div>
        </div>
      </div>
    );

  return (
    <div style={{ minHeight: "100vh", background: "#080B10" }}>
      <AppNav />

      <div
        style={{ maxWidth: 1100, margin: "0 auto", padding: "32px 20px 80px" }}
      >
        {/* ── Back + Header ─────────────────────────────────────────────────── */}
        <a
          href="/agents"
          style={{
            display: "inline-flex",
            alignItems: "center",
            gap: 6,
            color: "#4A5568",
            fontSize: 13,
            marginBottom: 24,
            textDecoration: "none",
            transition: "color 0.2s",
          }}
        >
          <ArrowLeft size={16} />
          Back to My Agents
        </a>

        <div
          style={{
            display: "flex",
            alignItems: "flex-start",
            justifyContent: "space-between",
            flexWrap: "wrap",
            gap: 16,
            marginBottom: 32,
          }}
        >
          <div>
            <div
              style={{
                display: "flex",
                alignItems: "center",
                gap: 12,
                marginBottom: 6,
              }}
            >
              <h1
                style={{
                  fontSize: 26,
                  fontWeight: 900,
                  color: "#EEF2FF",
                  margin: 0,
                }}
              >
                {agent.name}
              </h1>
              <span
                style={{
                  padding: "3px 12px",
                  borderRadius: 20,
                  fontSize: 11,
                  fontWeight: 700,
                  background:
                    agent.status === "active"
                      ? "rgba(52,211,153,0.12)"
                      : "rgba(251,191,36,0.12)",
                  color: agent.status === "active" ? "#34D399" : "#FBBF24",
                }}
              >
                {agent.status.toUpperCase()}
              </span>
            </div>
            <p
              style={{
                fontSize: 13,
                color: "#4A5568",
                margin: 0,
                maxWidth: 500,
              }}
            >
              {agent.description}
            </p>
          </div>
          <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
            {/* ── LIVE QUANT TERMINAL ── */}
            <button
              onClick={() => setShowTerminal(true)}
              style={{
                padding: "8px 18px",
                borderRadius: 10,
                cursor: "pointer",
                border: "1px solid rgba(91,140,255,0.45)",
                background: "rgba(91,140,255,0.1)",
                color: "#5B8CFF",
                fontSize: 13,
                fontWeight: 700,
                display: "flex",
                alignItems: "center",
                gap: 6,
              }}
            >
              <Terminal size={14} />
              Live Quant Terminal
            </button>

            {/* ── Share — always visible ── */}
            <button
              onClick={handleShare}
              disabled={shareLoading}
              style={{
                padding: "8px 18px",
                borderRadius: 10,
                cursor: shareLoading ? "not-allowed" : "pointer",
                border: "1px solid rgba(52,211,153,0.4)",
                background: "rgba(52,211,153,0.08)",
                color: "#34D399",
                fontSize: 13,
                fontWeight: 700,
                display: "flex",
                alignItems: "center",
                gap: 6,
                opacity: shareLoading ? 0.6 : 1,
              }}
            >
              <Award size={14} />
              {shareLoading
                ? "Generating…"
                : shareUrl
                  ? "Share Again"
                  : "Share Strategy"}
            </button>
            <button
              onClick={toggleStatus}
              style={{
                padding: "8px 18px",
                borderRadius: 10,
                border: "1px solid",
                borderColor:
                  agent.status === "active"
                    ? "rgba(251,191,36,0.3)"
                    : "rgba(52,211,153,0.3)",
                background:
                  agent.status === "active"
                    ? "rgba(251,191,36,0.08)"
                    : "rgba(52,211,153,0.08)",
                color: agent.status === "active" ? "#FBBF24" : "#34D399",
                fontSize: 13,
                fontWeight: 600,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 6,
              }}
            >
              {agent.status === "active" ? (
                <>
                  <Pause size={15} />
                  Pause
                </>
              ) : (
                <>
                  <Play size={15} />
                  Activate
                </>
              )}
            </button>
            <button
              onClick={deleteAgent}
              style={{
                padding: "8px 18px",
                borderRadius: 10,
                border: "1px solid rgba(248,113,113,0.3)",
                background: "rgba(248,113,113,0.08)",
                color: "#F87171",
                fontSize: 13,
                fontWeight: 600,
                cursor: "pointer",
                display: "flex",
                alignItems: "center",
                gap: 6,
