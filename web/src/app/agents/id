          <KPI
            label="Unrealised P&L"
            value={fmtCurrency(totalPnL)}
            color={returnColor(totalPnL)}
          />
          <KPI
            label="Open Positions"
            value={positions.length}
            color="#EEF2FF"
          />
          <KPI
            label="Total Trades"
            value={recentTrades.length}
            color="#EEF2FF"
          />
          {hasBacktest && (
            <>
              <KPI
                label="Backtest Return"
                value={fmtPct(bt.total_return)}
                color={returnColor(bt.total_return)}
              />
              <KPI
                label="Final Capital"
                value={fmtCurrency(bt.final_capital)}
                color={returnColor(bt.final_capital - initCap)}
              />
            </>
          )}
          {trustScore && (
            <KPI
              label="Trust Score"
              value={`${trustScore.overall}/100`}
              color={
                trustScore.overall >= 80
                  ? "#34D399"
                  : trustScore.overall >= 60
                    ? "#FBBF24"
                    : "#F87171"
              }
              sub={trustScore.confidence + " CONFIDENCE"}
            />
          )}
        </div>

        {/* ── Strategy Trust Report (shown when backtest + trustScore ready) ── */}
        {trustScore && hasBacktest && (
          <div
            style={{
              marginBottom: 20,
              padding: "20px 24px",
              borderRadius: 16,
              background: "rgba(255,255,255,0.025)",
