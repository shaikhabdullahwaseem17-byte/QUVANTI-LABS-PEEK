// ── Tiny reusable components ─────────────────────────────────

function KpiCard({
  label,
  value,
  sub,
  color = C.cyan,
  icon: Icon,
  formula,
  glow,
}) {
  return (
    <div
      className="relative overflow-hidden rounded-2xl border p-5 flex flex-col gap-1 transition-all hover:scale-[1.02]"
      style={{
        background: `linear-gradient(135deg, ${color}12 0%, ${color}05 100%)`,
        borderColor: `${color}40`,
        boxShadow: glow ? `0 0 30px ${color}30` : "none",
      }}
    >
      <div
        className="absolute top-0 right-0 w-24 h-24 rounded-full blur-3xl opacity-20"
        style={{ background: color }}
      />
      <div className="flex items-center justify-between mb-1">
        <span
          className="text-xs font-bold uppercase tracking-widest"
          style={{ color }}
        >
          {label}
        </span>
        {Icon && <Icon size={16} style={{ color }} />}
      </div>
      <div className="text-3xl font-black text-white leading-none">{value}</div>
      {sub && <div className="text-xs text-gray-400 mt-1">{sub}</div>}
      {formula && (
        <div className="mt-2 px-2 py-1 rounded-md bg-white/5 border border-white/10 text-[10px] font-mono text-gray-400 truncate">
          {formula}
        </div>
      )}
    </div>
  );
}

function SectionHeader({ icon: Icon, title, subtitle, color = C.cyan, badge }) {
  return (
    <div className="flex items-start justify-between mb-6">
      <div className="flex items-start gap-4">
        <div
          className="p-3 rounded-xl border"
          style={{ background: `${color}20`, borderColor: `${color}40` }}
        >
          <Icon size={22} style={{ color }} />
        </div>
        <div>
          <h2 className="text-xl font-black text-white">{title}</h2>
          <p className="text-sm text-gray-400 mt-0.5">{subtitle}</p>
        </div>
      </div>
      {badge && (
        <span
          className="px-3 py-1 rounded-full text-xs font-bold border"
          style={{ color, borderColor: `${color}50`, background: `${color}20` }}
        >
          {badge}
        </span>
      )}
    </div>
  );
}

function MathBox({ formula, description }) {
  return (
    <div className="flex flex-col gap-1 p-3 rounded-xl bg-white/3 border border-white/8">
      <code className="text-xs font-mono text-cyan-300">{formula}</code>
      {description && (
        <p className="text-[11px] text-gray-500">{description}</p>
      )}
    </div>
  );
}

function ValidationBadge({ status, wfe }) {
  const config = {
    VALID: { color: C.emerald, Icon: CheckCircle, label: `VALID (WFE=${wfe})` },
    OVERFIT: { color: C.red, Icon: XCircle, label: `OVERFIT (WFE=${wfe})` },
    UNSTABLE: {
      color: C.amber,
      Icon: AlertTriangle,
      label: `UNSTABLE (WFE=${wfe})`,
    },
  }[status] || { color: C.gray, Icon: Info, label: status };

  const { color, Icon, label } = config;
  return (
    <span
      className="inline-flex items-center gap-1.5 px-2 py-1 rounded-lg text-xs font-bold"
      style={{
        color,
        background: `${color}20`,
        border: `1px solid ${color}40`,
      }}
    >
      <Icon size={11} />
      {label}
    </span>
  );
}

// ── Custom tooltip for Recharts ──────────────────────────────
function DarkTooltip({ active, payload, label, prefix = "$", suffix = "" }) {
  if (!active || !payload?.length) return null;
  return (
    <div className="rounded-xl border border-white/10 bg-[#0d1117] shadow-2xl p-3 text-xs">
      <p className="text-gray-400 mb-2 font-semibold">{label}</p>
      {payload.map((p) => (
        <div key={p.name} className="flex items-center gap-2">
          <div
            className="w-2 h-2 rounded-full"
            style={{ background: p.color }}
          />
          <span className="text-gray-300">{p.name}:</span>
          <span className="font-bold text-white">
            {prefix}
            {typeof p.value === "number" ? p.value.toFixed(2) : p.value}
            {suffix}
          </span>
        </div>
      ))}
    </div>
  );
}

// ── MAIN PAGE ────────────────────────────────────────────────

const SYMBOLS = ["BTC", "ETH", "SOL", "MATIC", "AVAX", "LINK"];

export default function QuantEnginePage() {
  const [symbol, setSymbol] = useState("BTC");
  const [days, setDays] = useState(90);
  const [capital, setCapital] = useState(10000);
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState(null);
  const [error, setError] = useState(null);
  const [errorHint, setErrorHint] = useState(null);
  const [step, setStep] = useState("");
  const [expandedSection, setExpandedSection] = useState(null);

  const runAnalysis = useCallback(async () => {
    setLoading(true);
    setResult(null);
    setError(null);
    setErrorHint(null);

    const steps = [
      "Fetching real OHLCV data from CoinGecko…",
      "Computing daily log returns…",
      "Running Monte Carlo Bootstrap (N=1,000)…",
      "Rescaled Range (R/S) Hurst analysis…",
      "Walk-Forward Optimization (5 windows)…",
      "Calculating Sharpe & Sortino ratios…",
      "Finalising output…",
    ];

    let si = 0;
    const stepInterval = setInterval(() => {
      setStep(steps[Math.min(si++, steps.length - 1)]);
    }, 500);

    try {
      const res = await fetch(
        `/api/quant-engine?symbol=${symbol}&days=${days}&capital=${capital}`,
      );
      const data = await res.json();
      clearInterval(stepInterval);

      if (!res.ok || data.error) {
        setError(data.error || "Engine returned an error");
        setErrorHint(data.hint || null);
      } else {
        setResult(data);
        setStep("Complete ✓");
      }
    } catch (err) {
      clearInterval(stepInterval);
      setError(err.message);
    } finally {
      setLoading(false);
    }
  }, [symbol, days, capital]);

  const hurstColor = result
    ? result.hurst.regime === "PERSISTENT"
      ? C.emerald
      : result.hurst.regime === "ANTI_PERSISTENT"
