                  dot={false}
                />
              </AreaChart>
            </ResponsiveContainer>
          </div>

          {/* ── 2. MONTE CARLO ──────────────────────────────── */}
          <div className="rounded-2xl bg-white/3 border border-white/8 p-6">
            <SectionHeader
              icon={Sigma}
              title="Monte Carlo Bootstrap Simulation"
              subtitle="N=1,000 paths generated via non-parametric resampling with replacement. Equity fan shows percentile bands."
              color={C.purple}
              badge="N = 1,000 paths"
            />

            {/* Sub KPIs */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
              <div className="rounded-xl border border-white/8 bg-white/3 p-4">
                <p className="text-xs text-gray-400 mb-1">Value at Risk (5%)</p>
                <p className="text-2xl font-black" style={{ color: C.red }}>
                  ${result.monteCarlo.VaR.toFixed(0)}
                </p>
                <p className="text-xs text-gray-500 mt-1">
                  {result.monteCarlo.VaRPercent}% of capital
                </p>
