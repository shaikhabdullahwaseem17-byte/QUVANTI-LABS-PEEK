              </div>

              {/* Progress step */}
              {loading && (
                <div className="mt-3 px-3 py-2 rounded-lg bg-cyan-500/10 border border-cyan-500/20">
                  <p className="text-xs text-cyan-400 font-mono">{step}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* ── RESULTS ─────────────────────────────────────────── */}
      {error && (
        <div className="max-w-7xl mx-auto px-4 py-8 space-y-3">
          <div className="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-start gap-3">
            <AlertTriangle size={18} className="flex-shrink-0 mt-0.5" />
            <div>
              <p className="font-bold mb-1">Engine Error</p>
              <p>{error}</p>
              {errorHint && (
