              icon={BookOpen}
              title="Methodology & References"
              subtitle="Every metric is computed from raw return arrays with zero LLM hallucination. Source formulas below."
              color={C.purple}
            />
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
              {[
                {
                  ref: "Sharpe (1966)",
                  title: "Mutual Fund Performance",
                  formula: "S = (Rp − Rf) / σp · √252",
                  note: "Annualized excess return per unit total vol",
                },
                {
                  ref: "Sortino (1980s)",
                  title: "Downside Risk",
                  formula: "S_so = (Rp − Rf) / σd · √252",
                  note: "σd only counts below-MAR returns",
                },
                {
                  ref: "Mandelbrot & Wallis (1969)",
                  title: "R/S Analysis (Hurst)",
                  formula: "log(E[R/S]) = H·log(n) + C",
                  note: "H via OLS on log-log scale",
                },
                {
                  ref: "Bootstrap (Efron, 1979)",
                  title: "Monte Carlo Resampling",
                  formula: "P_k ~ Uniform(r, replace=T)",
                  note: "Non-parametric, no distributional assumption",
                },
              ].map(({ ref, title, formula, note }) => (
                <div
                  key={ref}
                  className="p-4 rounded-xl bg-white/4 border border-white/8"
                >
                  <p className="text-gray-500 text-[10px] mb-1">{ref}</p>
                  <p className="font-bold text-white mb-2">{title}</p>
                  <code className="block font-mono text-cyan-300 text-[11px] mb-1">
                    {formula}
                  </code>
                  <p className="text-gray-500 text-[10px]">{note}</p>
                </div>
              ))}
            </div>
          </div>

          {/* ── 6. WHALE-SHADOW TRACKER ─────────────────────── */}
          <div>
            <WhaleTracker defaultSymbol={symbol} />
          </div>
        </div>
      )}

      {/* ── EMPTY STATE ─────────────────────────────────────── */}
      {!result && !loading && !error && (
        <div className="max-w-3xl mx-auto px-4 py-24 text-center">
          <div className="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 mb-6">
            <Cpu className="text-cyan-400" size={36} />
          </div>
          <h2 className="text-2xl font-black text-white mb-3">Ready to Run</h2>
          <p className="text-gray-400 mb-8">
            Select an asset and click{" "}
            <strong className="text-cyan-400">Run Quant Engine</strong> to see
            the full quantitative analysis — Monte Carlo, Hurst Exponent,
            Walk-Forward Optimization, Sharpe and Sortino.
          </p>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {[
              "Monte Carlo N=1,000",
              "Hurst Exponent",
              "Walk-Forward OOS",
              "Sharpe · Sortino",
            ].map((f) => (
              <div
                key={f}
                className="p-3 rounded-xl bg-white/3 border border-white/8 text-xs text-gray-400 font-medium"
              >
                {f}
              </div>
            ))}
          </div>
        </div>
      )}

      {/* animations */}
      <style jsx global>{`
        @keyframes spin { to { transform: rotate(360deg); } }
        .animate-spin { animation: spin 1s linear infinite; }
      `}</style>
    </div>
  );
}



