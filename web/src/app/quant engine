              </span>
              <span className="text-xs text-gray-500">
                Data:{" "}
                <span className="text-emerald-400 font-bold">
                  {result.dataSource}
                </span>
              </span>
            </div>
            <span className="text-xs text-gray-600 font-mono">
              Computed in {result.computeTimeMs}ms
            </span>
          </div>

          {/* TOP KPIs ─────────────────────────────────────── */}
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
            <KpiCard
              label="Total Return"
              value={`${result.summary.totalReturn > 0 ? "+" : ""}${result.summary.totalReturn}%`}
              sub={`$${result.summary.totalReturnDollar.toFixed(0)} P&L`}
              color={result.summary.totalReturn >= 0 ? C.emerald : C.red}
              icon={result.summary.totalReturn >= 0 ? TrendingUp : TrendingDown}
              glow
            />
            <KpiCard
              label="Sharpe Ratio"
              value={result.sharpe.sharpe.toFixed(2)}
              sub={result.sharpe.interpretation}
              color={
                result.sharpe.sharpe > 1
                  ? C.cyan
                  : result.sharpe.sharpe > 0
                    ? C.amber
                    : C.red
              }
              icon={Target}
              formula="S = E[Rp−Rf]/σp × √252"
            />
            <KpiCard
              label="Sortino Ratio"
              value={result.sortino.sortino.toFixed(2)}
              sub={result.sortino.interpretation}
              color={
                result.sortino.sortino > 2
