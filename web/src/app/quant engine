                          color: symbol === s ? C.cyan : "#9CA3AF",
                        }}
                      >
                        {s}
                      </button>
                    ))}
                  </div>
                </div>

                {/* Lookback */}
                <div>
                  <label className="text-xs text-gray-400 font-semibold mb-1.5 block">
