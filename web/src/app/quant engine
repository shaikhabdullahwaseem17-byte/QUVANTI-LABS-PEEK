                </div>
                <span className="text-xs font-bold text-cyan-400 uppercase tracking-widest">
                  Institutional-Grade
                </span>
              </div>
              <h1 className="text-4xl sm:text-5xl font-black text-white leading-tight">
                Quantitative Engine
                <span className="block text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-purple-500">
                  Core
                </span>
              </h1>
              <p className="mt-3 text-lg text-gray-400 max-w-xl">
                Deterministic backtesting &amp; risk analytics. Monte Carlo,
                Hurst, Walk-Forward, Sharpe, Sortino — all computed from raw
                price arrays with zero LLM hallucination.
              </p>
              {/* Method pills */}
              <div className="flex flex-wrap gap-2 mt-5">
