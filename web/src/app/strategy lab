"use client";

import { useState, useEffect } from "react";
import {
  Sparkles,
  Download,
  Save,
  Star,
  Clock,
  MessageSquare,
  FileText,
  Code,
  TrendingUp,
  Target,
  CheckCircle,
  X,
  AlertCircle,
  Lock,
} from "lucide-react";
import SubscriptionBanner from "@/components/SubscriptionBanner";
import PaywallModal from "@/components/PaywallModal";
import UsageIndicator from "@/components/UsageIndicator";
import AppNav from "@/components/AppNav";
import InternalLayout from "@/components/InternalLayout";
import GlassButton from "@/components/GlassButton";
import GeneticMutator from "@/components/GeneticMutator";
import AnimatedIcon from "@/components/AnimatedIcon"; // ← iOS spring physics

export default function StrategyLab() {
  const [prompt, setPrompt] = useState("");
  const [parsedStrategy, setParsedStrategy] = useState(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [subscription, setSubscription] = useState(null);
  const [showPaywall, setShowPaywall] = useState(false);
  const [savedStrategies, setSavedStrategies] = useState([]);
  const [conversationHistory, setConversationHistory] = useState([]);
  const [exportFormat, setExportFormat] = useState(null);
  const [exporting, setExporting] = useState(false);

  // Toast system
  const [toasts, setToasts] = useState([]);

  const showToast = (message, type = "info") => {
    const id = Date.now();
    setToasts((prev) => [...prev, { id, message, type }]);
    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, 5000);
  };

  useEffect(() => {
    loadSubscription();
    loadSavedStrategies();
  }, []);

  const loadSubscription = async () => {
    try {
      const res = await fetch("/api/subscription/status");
      if (res.ok) {
        const data = await res.json();
        setSubscription(data);
      }
    } catch (error) {
      console.error("Error loading subscription:", error);
    }
  };

  const loadSavedStrategies = async () => {
    try {
      const res = await fetch("/api/strategies/list");
      if (res.ok) {
        const data = await res.json();
        setSavedStrategies(data.strategies || []);
      }
    } catch (error) {
      console.error("Error loading strategies:", error);
    }
  };

  const handleParse = async () => {
    if (!prompt.trim()) return;

    setError(null);
    setLoading(true);

    try {
      const response = await fetch("/api/strategy-lab/parse", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          prompt,
          conversationHistory,
        }),
      });

      const data = await response.json();

      if (response.status === 403 && data.error === "usage_limit_reached") {
        setShowPaywall(true);
        setLoading(false);
        return;
      }

      if (!response.ok) {
        throw new Error(data.error || "Failed to parse strategy");
      }

      setParsedStrategy(data.strategy);
      showToast("✅ Strategy generated successfully!", "success");

      // Add to conversation history for chat-style interaction
      setConversationHistory([
        ...conversationHistory,
        { role: "user", content: prompt },
        { role: "assistant", content: JSON.stringify(data.strategy) },
      ]);

      loadSubscription();
    } catch (err) {
      console.error("Error parsing strategy:", err);
      setError(err.message);
      showToast(err.message, "error");
    } finally {
      setLoading(false);
    }
  };

  const handleSaveStrategy = async () => {
    if (!parsedStrategy) return;

    try {
      const response = await fetch("/api/strategies/save", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          strategyData: parsedStrategy,
          originalPrompt: prompt,
        }),
      });

      if (response.ok) {
        showToast("✅ Strategy saved successfully!", "success");
        loadSubscription();
        loadSavedStrategies();
      } else {
        throw new Error("Failed to save strategy");
      }
    } catch (error) {
      console.error("Error saving strategy:", error);
      showToast("Failed to save strategy", "error");
    }
  };

  const handleExport = async (format) => {
    if (!subscription || subscription.tier !== "pro") {
      setShowPaywall(true);
      return;
    }

    setExporting(true);
    setExportFormat(format);

    try {
      const response = await fetch("/api/strategies/export", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          strategyData: parsedStrategy,
          format,
        }),
      });

      if (response.status === 403) {
        setShowPaywall(true);
        return;
      }

      if (!response.ok) {
        throw new Error("Export failed");
      }

      const data = await response.json();

      // Download as file
      const blob = new Blob([data.content], { type: "text/plain" });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = data.filename;
      a.click();
      window.URL.revokeObjectURL(url);

      showToast(`✅ Exported as ${format.toUpperCase()}`, "success");
    } catch (error) {
      console.error("Export error:", error);
      showToast("Export failed", "error");
    } finally {
      setExporting(false);
      setExportFormat(null);
    }
  };

  const isPro = subscription?.tier === "pro";

  return (
    <InternalLayout>
      {showPaywall && (
        <PaywallModal
          tier={subscription?.tier || "free"}
          onClose={() => setShowPaywall(false)}
        />
      )}

      {/* Toast Container */}
      <div className="fixed top-4 right-4 z-50 space-y-3 max-w-md">
        {toasts.map((toast) => (
          <div
            key={toast.id}
            className="p-4 rounded-xl flex items-start gap-3"
            style={{
              background:
                toast.type === "success"
                  ? "rgba(16,185,129,0.12)"
                  : toast.type === "error"
                    ? "rgba(239,68,68,0.12)"
                    : "rgba(6,182,212,0.12)",
              border: `1px solid ${
                toast.type === "success"
                  ? "rgba(16,185,129,0.3)"
                  : toast.type === "error"
                    ? "rgba(239,68,68,0.3)"
                    : "rgba(6,182,212,0.3)"
              }`,
              backdropFilter: "blur(16px)",
            }}
          >
            {toast.type === "success" && (
              <AnimatedIcon
                icon={CheckCircle}
                size={20}
                variant="alert"
                active={true}
                style={{ color: "#34D399", flexShrink: 0 }}
              />
            )}
            {toast.type === "error" && (
              <AnimatedIcon
                icon={AlertCircle}
                size={20}
                variant="alert"
                active={true}
                style={{ color: "#F87171", flexShrink: 0 }}
              />
            )}
            {toast.type === "info" && (
              <AnimatedIcon
                icon={Sparkles}
                size={20}
                variant="breathe"
                style={{ color: "#22D3EE", flexShrink: 0 }}
              />
            )}
            <p
              className={`text-sm font-semibold flex-1 ${
                toast.type === "success"
                  ? "text-emerald-400"
                  : toast.type === "error"
                    ? "text-red-400"
                    : "text-cyan-400"
              }`}
            >
              {toast.message}
            </p>
            <button
              onClick={() =>
                setToasts((prev) => prev.filter((t) => t.id !== toast.id))
              }
              className="text-gray-400 hover:text-white transition-colors"
            >
              <AnimatedIcon icon={X} size={16} variant="spring" />
            </button>
          </div>
        ))}
      </div>

      <AppNav />

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Page Header */}
        <div className="mb-8">
          <div className="flex items-center gap-3 mb-3">
            <div
              className="p-2 rounded-lg"
              style={{
                background:
                  "linear-gradient(135deg, rgba(168,85,247,0.3), rgba(236,72,153,0.3))",
                border: "1px solid rgba(168,85,247,0.3)",
              }}
            >
              <AnimatedIcon
                icon={Sparkles}
                size={28}
                variant="breathe"
                style={{ color: "#ffffff" }}
              />
            </div>
            <h1 className="text-2xl sm:text-3xl font-bold text-[#F8FAFC] dynamic-flow-header">
              Strategy Lab
            </h1>
            <span
              className="px-3 py-1 rounded-full font-bold text-xs text-white"
              style={{
                background:
                  "linear-gradient(135deg, rgba(245,158,11,0.3), rgba(234,88,12,0.3))",
                border: "1px solid rgba(245,158,11,0.3)",
              }}
            >
              AI ENHANCED
            </span>
          </div>
          <p className="text-[#94A3B8] text-sm sm:text-lg font-[400]">
            Convert natural language into structured, executable trading
            strategies
          </p>
        </div>

        {/* Subscription & Usage */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          {subscription && (
            <SubscriptionBanner
              tier={subscription.tier}
              usage={subscription.usage}
            />
          )}
          {subscription && <UsageIndicator subscription={subscription} />}
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
          {/* LEFT: Input Section + Saved Strategies */}
          <div className="lg:col-span-1 space-y-6">
            {/* Input Card */}
            <div
              className="rounded-xl p-4 sm:p-6"
              style={{
                background: "rgba(255,255,255,0.04)",
                border: "1px solid rgba(255,255,255,0.08)",
                backdropFilter: "blur(20px)",
              }}
            >
              <label
                className="block text-sm font-semibold mb-3 flex items-center gap-2"
                style={{ color: "#E2E8F0" }}
              >
                <AnimatedIcon
                  icon={MessageSquare}
                  size={18}
                  variant="breathe"
                  style={{ color: "#C084FC" }}
                />
                Describe Your Strategy
              </label>
              <textarea
                value={prompt}
                onChange={(e) => setPrompt(e.target.value)}
                placeholder="Example: Buy Bitcoin when RSI drops below 30 and MACD crosses bullish. Sell when RSI hits 70. Use 5% stop loss and 2% position sizing."
                rows={8}
                className="w-full rounded-xl px-4 py-3 text-sm sm:text-base placeholder-gray-500 focus:outline-none resize-none transition-all"
                style={{
                  background: "rgba(0,0,0,0.4)",
                  border: "1px solid rgba(255,255,255,0.08)",
                  color: "#E2E8F0",
                  fontFamily: "Inter, sans-serif",
                }}
                onFocus={(e) => {
                  e.target.style.borderColor = "rgba(168,85,247,0.4)";
                }}
                onBlur={(e) => {
                  e.target.style.borderColor = "rgba(255,255,255,0.08)";
                }}
              />
            </div>

            {/* Generate Strategy Button */}
            <GlassButton
              onClick={handleParse}
              disabled={
                loading ||
                !prompt.trim() ||
                (subscription &&
                  subscription.usage &&
                  subscription.usage.remaining === 0)
              }
              size="lg"
              style={{
                width: "100%",
                background: loading
                  ? "rgba(255,255,255,0.06)"
                  : "linear-gradient(135deg, rgba(168,85,247,0.3) 0%, rgba(236,72,153,0.3) 100%)",
                border: "1px solid rgba(168,85,247,0.35)",
                color: "#FFFFFF",
              }}
            >
              {loading ? (
                <span>Generating Strategy...</span>
              ) : (
                <>
                  <AnimatedIcon
                    icon={Sparkles}
                    size={20}
                    variant="action"
                    spinning={loading}
                  />
                  Generate Strategy
                  {subscription?.usage && (
                    <span
                      className="ml-2 px-2 sm:px-3 py-1 rounded-full text-xs font-bold"
                      style={{ background: "rgba(255,255,255,0.15)" }}
                    >
                      {subscription.usage.remaining || 0}/
                      {subscription.tier === "pro" ? "15" : "1"}{" "}
                      {subscription.tier === "free" ? "per 24h" : "today"}
                    </span>
                  )}
                </>
              )}
            </GlassButton>

            {error && (
              <div
                className="rounded-xl p-4 text-sm text-red-400"
                style={{
                  background: "rgba(239,68,68,0.08)",
                  border: "1px solid rgba(239,68,68,0.2)",
                }}
              >
                {error}
              </div>
            )}

            {/* Saved Strategies Sidebar */}
            {savedStrategies.length > 0 && (
              <div
                className="rounded-xl p-4 sm:p-6"
                style={{
                  background: "rgba(255,255,255,0.04)",
                  border: "1px solid rgba(255,255,255,0.08)",
                  backdropFilter: "blur(20px)",
                }}
              >
                <h3
                  className="text-sm font-semibold mb-3 flex items-center gap-2"
                  style={{ color: "#E2E8F0" }}
                >
                  <AnimatedIcon
                    icon={Clock}
                    size={16}
                    variant="breathe"
                    style={{ color: "#22D3EE" }}
                  />
                  Saved Strategies ({savedStrategies.length})
                </h3>
                <div className="space-y-2 max-h-64 overflow-y-auto">
                  {savedStrategies.slice(0, 10).map((strategy) => (
                    <button
                      key={strategy.id}
                      onClick={() => {
                        setParsedStrategy(
                          typeof strategy.strategy_data === "string"
                            ? JSON.parse(strategy.strategy_data)
                            : strategy.strategy_data,
                        );
                        setPrompt(strategy.original_prompt);
                      }}
                      className="w-full text-left p-3 rounded-lg text-xs sm:text-sm transition-all"
                      style={{
                        background: "rgba(0,0,0,0.3)",
                        border: "1px solid rgba(255,255,255,0.07)",
                        color: "#E2E8F0",
                      }}
                      onMouseEnter={(e) => {
                        e.currentTarget.style.borderColor =
                          "rgba(6,182,212,0.3)";
                      }}
                      onMouseLeave={(e) => {
                        e.currentTarget.style.borderColor =
                          "rgba(255,255,255,0.07)";
                      }}
                    >
                      {strategy.name}
                    </button>
                  ))}
                </div>
              </div>
            )}
          </div>

          {/* RIGHT: Strategy Display (2 columns) */}
          <div className="lg:col-span-2">
            {parsedStrategy ? (
              <div className="space-y-6">
                {/* Strategy Header + Actions - FIXED MOBILE */}
                <div
                  className="rounded-xl p-4 sm:p-6"
                  style={{
                    background: "rgba(255,255,255,0.04)",
                    border: "1px solid rgba(255,255,255,0.08)",
                    backdropFilter: "blur(20px)",
                  }}
                >
                  <div className="flex flex-col gap-4 mb-4">
                    <div className="flex-1">
                      <h2
                        className="text-xl sm:text-2xl font-bold mb-2 no-breathe"
                        style={{ color: "#F8FAFC" }}
                      >
                        {parsedStrategy.name}
                      </h2>
                      <div className="flex items-center gap-2 flex-wrap">
                        {[
                          { label: parsedStrategy.type, color: "purple" },
                          { label: parsedStrategy.market, color: "cyan" },
                          { label: parsedStrategy.timeframe, color: "emerald" },
                        ].map(({ label, color }) => (
                          <span
                            key={label}
                            className="text-xs px-2 sm:px-3 py-1 rounded-full font-medium"
                            style={{
                              background: `rgba(${
                                color === "purple"
                                  ? "168,85,247"
                                  : color === "cyan"
                                    ? "6,182,212"
                                    : "16,185,129"
                              },0.12)`,
                              border: `1px solid rgba(${
                                color === "purple"
                                  ? "168,85,247"
                                  : color === "cyan"
                                    ? "6,182,212"
                                    : "16,185,129"
                              },0.25)`,
                              color:
                                color === "purple"
                                  ? "#C084FC"
                                  : color === "cyan"
                                    ? "#22D3EE"
                                    : "#34D399",
                            }}
                          >
                            {label}
                          </span>
                        ))}
                      </div>
                    </div>

                    {/* Strategy Score - FIXED: Stacks on mobile */}
                    {parsedStrategy.strategy_score && (
                      <div
                        className="rounded-xl p-4 text-center w-full sm:w-auto sm:self-start"
                        style={{
                          background: "rgba(245,158,11,0.1)",
                          border: "1px solid rgba(245,158,11,0.25)",
                        }}
                      >
                        <div className="text-3xl sm:text-4xl font-bold text-yellow-400">
                          {parsedStrategy.strategy_score.score || 0}
                          <span className="text-xl sm:text-2xl">/10</span>
                        </div>
                        <div className="text-xs text-yellow-300 mt-1">
                          Grade:{" "}
                          {parsedStrategy.strategy_score.score >= 8
                            ? "A"
                            : parsedStrategy.strategy_score.score >= 6
                              ? "B"
                              : parsedStrategy.strategy_score.score >= 4
                                ? "C"
                                : "D"}
                        </div>
                        <div className="text-xs text-yellow-300">
                          {parsedStrategy.strategy_score
                            .confidence_percentage || 0}
                          % confidence
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Action Buttons - FIXED: Better mobile spacing */}
                  <div className="flex flex-wrap gap-2 sm:gap-3">
                    <GlassButton
                      size="sm"
                      onClick={handleSaveStrategy}
                      style={{
                        background: "rgba(6,182,212,0.15)",
                        border: "1px solid rgba(6,182,212,0.3)",
                        color: "#22D3EE",
                      }}
                    >
                      <AnimatedIcon icon={Save} size={15} variant="spring" />
                      <span className="hidden sm:inline">Save Strategy</span>
                      <span className="sm:hidden">Save</span>
                    </GlassButton>

                    {/* EXPORT BUTTONS - PRO GATED - Better mobile */}
                    {[
                      {
                        format: "txt",
                        label: "TXT",
                        short: "TXT",
                        color: "rgba(16,185,129,0.15)",
                        borderColor: "rgba(16,185,129,0.3)",
                        textColor: "#34D399",
                      },
                      {
                        format: "binance",
                        label: "Binance",
                        short: "BIN",
                        color: "rgba(245,158,11,0.15)",
                        borderColor: "rgba(245,158,11,0.3)",
                        textColor: "#FCD34D",
                      },
                      {
                        format: "tradingview",
                        label: "Pine Script",
                        short: "Pine",
                        color: "rgba(168,85,247,0.15)",
                        borderColor: "rgba(168,85,247,0.3)",
                        textColor: "#C084FC",
                      },
                      {
                        format: "python",
                        label: "Python Bot",
                        short: "Py",
                        color: "rgba(59,130,246,0.15)",
                        borderColor: "rgba(59,130,246,0.3)",
                        textColor: "#60A5FA",
                      },
                    ].map(
                      ({
                        format,
                        label,
                        short,
                        color,
                        borderColor,
                        textColor,
                      }) => (
                        <GlassButton
                          key={format}
                          size="sm"
                          onClick={() => handleExport(format)}
                          disabled={!isPro || exporting}
                          style={
                            isPro
                              ? {
                                  background: color,
                                  border: `1px solid ${borderColor}`,
                                  color: textColor,
                                }
                              : {
                                  background: "rgba(255,255,255,0.04)",
                                  border: "1px solid rgba(255,255,255,0.1)",
                                  color: "#4B5563",
                                }
                          }
                        >
                          <AnimatedIcon
                            icon={Code}
                            size={14}
                            variant="spring"
                          />
                          <span className="hidden sm:inline">
                            {exporting && exportFormat === format
                              ? "..."
                              : label}
                          </span>
                          <span className="sm:hidden">{short}</span>
                          {!isPro && (
                            <AnimatedIcon
                              icon={Lock}
                              size={11}
                              variant="breathe"
                            />
                          )}
                        </GlassButton>
                      ),
                    )}
                  </div>
                </div>

                {/* 8-SECTION DISPLAY */}
                <div className="grid grid-cols-1 gap-6">
                  {/* SECTION 2: Entry Rules */}
                  {parsedStrategy.entry_rules && (
                    <div
                      className="rounded-xl p-6"
                      style={{
                        background: "rgba(6,182,212,0.04)",
                        border: "1px solid rgba(6,182,212,0.15)",
                        backdropFilter: "blur(16px)",
                      }}
                    >
                      <h3
                        className="text-lg font-bold text-cyan-400 mb-4 flex items-center gap-2"
                        style={{ color: "#E2E8F0" }}
                      >
                        <AnimatedIcon
                          icon={Target}
                          size={20}
                          variant="breathe"
                          style={{ color: "#22D3EE" }}
                        />
                        Entry Rules
                      </h3>
                      <ul className="space-y-2">
                        {parsedStrategy.entry_rules.map((rule, i) => (
                          <li
                            key={i}
                            className="flex items-start gap-3"
                            style={{ color: "#E2E8F0" }}
                          >
                            <span
                              className="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5"
                              style={{
                                background: "rgba(6,182,212,0.15)",
                                color: "#22D3EE",
                              }}
                            >
                              {i + 1}
                            </span>
                            <span>{rule}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {/* SECTION 3: Exit Rules */}
                  {parsedStrategy.exit_rules && (
                    <div
                      className="rounded-xl p-6"
                      style={{
                        background: "rgba(16,185,129,0.04)",
                        border: "1px solid rgba(16,185,129,0.15)",
                        backdropFilter: "blur(16px)",
                      }}
                    >
                      <h3
                        className="text-lg font-bold text-emerald-400 mb-4"
                        style={{ color: "#E2E8F0" }}
                      >
                        Exit Rules
                      </h3>
                      <div className="space-y-2" style={{ color: "#E2E8F0" }}>
                        <div className="flex justify-between">
                          <span style={{ color: "#94A3B8" }}>Take Profit:</span>
                          <span className="font-semibold">
                            {parsedStrategy.exit_rules?.take_profit ||
                              "Not specified"}
                          </span>
                        </div>
                        <div className="flex justify-between">
                          <span style={{ color: "#94A3B8" }}>Stop Loss:</span>
                          <span className="font-semibold">
                            {parsedStrategy.exit_rules?.stop_loss ||
                              "Not specified"}
                          </span>
                        </div>
                        <div className="flex justify-between">
                          <span style={{ color: "#94A3B8" }}>Time-Based:</span>
                          <span className="font-semibold">
                            {parsedStrategy.exit_rules?.time_based || "None"}
                          </span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* SECTION 4: Risk Management */}
                  {parsedStrategy.risk_management && (
                    <div
                      className="rounded-xl p-6"
                      style={{
                        background: "rgba(245,158,11,0.04)",
                        border: "1px solid rgba(245,158,11,0.15)",
                        backdropFilter: "blur(16px)",
                      }}
                    >
                      <h3
                        className="text-lg font-bold text-amber-400 mb-4"
                        style={{ color: "#E2E8F0" }}
                      >
                        Risk Management
                      </h3>
                      <div
                        className="grid grid-cols-2 gap-4"
                        style={{ color: "#E2E8F0" }}
                      >
                        <div>
                          <p className="text-sm" style={{ color: "#94A3B8" }}>
                            Risk Per Trade
                          </p>
                          <p className="text-xl font-bold">
                            {parsedStrategy.risk_management
                              ?.risk_per_trade_percentage || 0}
                            %
                          </p>
                        </div>
                        <div>
                          <p className="text-sm" style={{ color: "#94A3B8" }}>
                            Max Daily Loss
                          </p>
                          <p className="text-xl font-bold">
                            {parsedStrategy.risk_management
                              ?.max_daily_loss_percentage || 0}
                            %
                          </p>
                        </div>
                        <div className="col-span-2">
                          <p className="text-sm" style={{ color: "#94A3B8" }}>
                            Position Sizing
                          </p>
                          <p className="font-semibold">
                            {parsedStrategy.risk_management
                              ?.position_sizing_logic || "Not specified"}
                          </p>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* SECTION 5: Performance Estimation */}
                  {parsedStrategy.performance_estimation && (
                    <div
                      className="rounded-xl p-6"
                      style={{
                        background: "rgba(168,85,247,0.04)",
                        border: "1px solid rgba(168,85,247,0.15)",
                        backdropFilter: "blur(16px)",
                      }}
                    >
                      <h3
                        className="text-lg font-bold text-purple-400 mb-2"
                        style={{ color: "#E2E8F0" }}
                      >
                        Performance Estimation
                      </h3>
                      {/* Honest disclaimer — these are AI estimates, not real backtest data */}
                      <div
                        className="mb-4 flex items-start gap-2 px-3 py-2 rounded-lg"
                        style={{
                          background: "rgba(245,158,11,0.08)",
                          border: "1px solid rgba(245,158,11,0.2)",
                        }}
                      >
                        <AnimatedIcon
                          icon={AlertCircle}
                          size={13}
                          variant="breathe"
                          style={{
                            color: "#FDE68A",
                            flexShrink: 0,
                            marginTop: "2px",
                          }}
                        />
                        <p
                          className="text-xs leading-relaxed"
                          style={{ color: "#FDE68A" }}
                        >
                          <strong>AI Estimates — Not Backtested.</strong> Use{" "}
                          <a
                            href="/agents/create"
                            className="underline font-bold hover:text-amber-200"
                          >
                            Create Agent
                          </a>{" "}
                          for real backtested results.
                        </p>
                      </div>
                      <div className="grid grid-cols-3 gap-4 text-center">
                        <div>
                          <p className="text-sm" style={{ color: "#94A3B8" }}>
                            Win Rate
                          </p>
                          <p className="text-2xl font-bold text-emerald-400">
                            {parsedStrategy.performance_estimation
                              ?.estimated_win_rate_percentage || 0}
                            %
                          </p>
                        </div>
                        <div>
                          <p className="text-sm" style={{ color: "#94A3B8" }}>
                            R:R Ratio
                          </p>
                          <p className="text-2xl font-bold text-cyan-400">
                            {parsedStrategy.performance_estimation
                              ?.estimated_risk_reward_ratio || 0}
                          </p>
                        </div>
                        <div>
                          <p className="text-sm" style={{ color: "#94A3B8" }}>
                            Max Drawdown
                          </p>
                          <p className="text-2xl font-bold text-red-400">
                            {parsedStrategy.performance_estimation
                              ?.estimated_max_drawdown_percentage || 0}
                            %
                          </p>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* SECTION 6: Flow Logic */}
                  {parsedStrategy.flow_logic &&
                    parsedStrategy.flow_logic.length > 0 && (
                      <div
                        className="rounded-xl p-6"
                        style={{
                          background: "rgba(236,72,153,0.04)",
                          border: "1px solid rgba(236,72,153,0.15)",
                          backdropFilter: "blur(16px)",
                        }}
                      >
                        <h3
                          className="text-lg font-bold text-pink-400 mb-4"
                          style={{ color: "#E2E8F0" }}
                        >
                          Execution Flow
                        </h3>
                        <div className="space-y-3">
                          {parsedStrategy.flow_logic.map((step, i) => (
                            <div
                              key={i}
                              className="flex items-start gap-3"
                              style={{ color: "#E2E8F0" }}
                            >
                              <span
                                className="px-3 py-1 rounded-lg text-sm font-bold"
                                style={{
                                  background: "rgba(236,72,153,0.15)",
                                  color: "#F472B6",
                                }}
                              >
                                Step {i + 1}
                              </span>
                              <span>{step}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                </div>
              </div>
            ) : (
              <div
                className="rounded-xl p-8 sm:p-12 text-center"
                style={{
                  background: "rgba(255,255,255,0.03)",
                  border: "1px solid rgba(255,255,255,0.07)",
                  backdropFilter: "blur(16px)",
                }}
              >
                <AnimatedIcon
                  icon={Sparkles}
                  size={48}
                  variant="breathe"
                  style={{ color: "#6B7280", marginBottom: "16px" }}
                />
                <p
                  className="text-sm sm:text-base"
                  style={{ color: "#94A3B8" }}
                >
                  Enter a strategy on the left and click Generate Strategy
                </p>
                <p
                  className="text-xs sm:text-sm mt-2"
                  style={{ color: "#475569" }}
                >
                  Your structured strategy will appear here with all sections
                </p>
              </div>
            )}
          </div>
        </div>

        {/* Legal Disclaimer */}
        <div
          className="mt-8 rounded-xl p-4 sm:p-6 text-center"
          style={{
            background: "rgba(255,255,255,0.02)",
            border: "1px solid rgba(255,255,255,0.06)",
          }}
        >
          <p className="text-xs leading-relaxed" style={{ color: "#475569" }}>
            <strong style={{ color: "#94A3B8" }}>Notice:</strong> This platform
            and its AI outputs are for educational and research purposes only.
            Content does not constitute financial, investment, or legal advice.
            Trading involves significant risk. Quvanti and its management are
            not responsible for financial losses incurred from the use of this
            software.
          </p>
        </div>

        {/* ── GENETIC STRATEGY MUTATOR ─────────────────────────── */}
        <div className="mt-10">
          <div className="mb-5">
            <h2
              className="text-xl font-black dynamic-flow-header"
              style={{ color: "#F8FAFC", letterSpacing: "-0.025em", margin: 0 }}
            >
              Genetic Strategy Optimizer
            </h2>
            <p className="text-sm mt-1" style={{ color: "#64748B" }}>
              Evolve your strategy parameters using real genetic mutation.
              P_offspring = P_parent ± (MutationRate × σ) — each child scored by
              Sharpe Ratio (S = (R_p − R_f) / σ_p × √252).
            </p>
          </div>
          <GeneticMutator defaultSymbol="BTC" />
        </div>
      </div>

      <style jsx global>{`
        @keyframes slide-in {
          from {
            transform: translateX(100%);
            opacity: 0;
          }
          to {
            transform: translateX(0);
            opacity: 1;
          }
        }
        .animate-slide-in {
          animation: slide-in 0.3s ease-out;
        }
      `}</style>
    </InternalLayout>
  );
