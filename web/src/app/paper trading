"use client";

import { useState, useEffect } from "react";
import {
  TrendingUp,
  TrendingDown,
  DollarSign,
  Activity,
  Lock,
  Crown,
  Zap,
  ArrowRight,
  PlayCircle,
  Target,
  Plus,
  X,
  RefreshCw,
  BarChart3,
  Clock,
  ArrowUpRight,
  ArrowDownRight,
  Trash2,
  CheckCircle,
  XCircle,
  Info,
  AlertCircle,
} from "lucide-react";
import InternalLayout from "@/components/InternalLayout";
import AppNav from "@/components/AppNav";
import useUser from "@/utils/useUser";

export default function PaperTrading() {
  const { data: user, loading: userLoading } = useUser();
  const [portfolio, setPortfolio] = useState(null);
  const [positions, setPositions] = useState([]);
  const [recentTrades, setRecentTrades] = useState([]);
  const [loading, setLoading] = useState(true);
  const [isPro, setIsPro] = useState(false);

  // Toast notifications
  const [toasts, setToasts] = useState([]);

  // Confirmation modal
  const [confirmModal, setConfirmModal] = useState(null);

  // Trading modal
  const [showTradeModal, setShowTradeModal] = useState(false);
  const [tradeSymbol, setTradeSymbol] = useState("");
  const [tradeQuantity, setTradeQuantity] = useState("");
  const [tradeType, setTradeType] = useState("buy");
  const [currentPrice, setCurrentPrice] = useState(null);
  const [fetchingPrice, setFetchingPrice] = useState(false);
  const [executing, setExecuting] = useState(false);

  // Toast notification system
  const showToast = (message, type = "info") => {
    const id = Date.now();
    setToasts((prev) => [...prev, { id, message, type }]);
    setTimeout(() => {
      setToasts((prev) => prev.filter((t) => t.id !== id));
    }, 5000);
  };

  // Custom confirmation modal
  const showConfirm = (message, onConfirm) => {
    setConfirmModal({ message, onConfirm });
  };

  useEffect(() => {
    checkProStatus();
  }, []);

  useEffect(() => {
    if (isPro) {
      loadPortfolio();
      const interval = setInterval(loadPortfolio, 30000); // Refresh every 30s
      return () => clearInterval(interval);
    }
  }, [isPro]);

  const checkProStatus = async () => {
    try {
      const res = await fetch("/api/subscription/status");
      if (res.ok) {
        const data = await res.json();
        setIsPro(data.tier === "pro" && data.license_status === "active");
      }
      setLoading(false);
    } catch (error) {
      console.error("Error checking PRO status:", error);
      setLoading(false);
    }
  };

  const loadPortfolio = async () => {
    try {
      const res = await fetch("/api/paper-trading/portfolio");
      if (res.ok) {
        const data = await res.json();
        setPortfolio(data.portfolio);
        setPositions(data.positions || []);
        setRecentTrades(data.recentTrades || []);
      }
    } catch (error) {
      console.error("Error loading portfolio:", error);
    }
  };

  const fetchPrice = async () => {
    if (!tradeSymbol.trim()) {
      showToast("Please enter a symbol", "error");
      return;
    }

    setFetchingPrice(true);
    try {
      const res = await fetch(
        `/api/paper-trading/price?symbol=${tradeSymbol.toUpperCase()}`,
      );
      if (res.ok) {
        const data = await res.json();
        setCurrentPrice(data.price);
        showToast(
          `${tradeSymbol.toUpperCase()}: $${data.price.toFixed(2)}`,
          "success",
        );
      } else {
        const errorData = await res.json();
        showToast(
          errorData.error ||
            "Failed to fetch price. Check symbol and try again.",
          "error",
        );
        setCurrentPrice(null);
      }
    } catch (error) {
      console.error("Fetch price error:", error);
      showToast("Network error. Please try again.", "error");
    } finally {
      setFetchingPrice(false);
    }
  };

  const executeTrade = async () => {
    if (!tradeSymbol || !tradeQuantity || !currentPrice) {
      showToast("Please fill all fields and fetch current price", "error");
      return;
    }

    setExecuting(true);
    try {
      const res = await fetch("/api/paper-trading/execute", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          symbol: tradeSymbol.toUpperCase(),
          quantity: parseFloat(tradeQuantity),
          tradeType,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        showToast(data.error || "Trade failed", "error");
        setExecuting(false);
        return;
      }

      showToast(
        `✅ ${tradeType.toUpperCase()} ${tradeQuantity} ${tradeSymbol.toUpperCase()} @ $${currentPrice.toFixed(2)}`,
        "success",
      );

      // Reset modal and reload
      setShowTradeModal(false);
      setTradeSymbol("");
      setTradeQuantity("");
      setCurrentPrice(null);
      loadPortfolio();
    } catch (error) {
      console.error("Execute trade error:", error);
      showToast("Failed to execute trade. Please try again.", "error");
    } finally {
      setExecuting(false);
    }
  };

  const closePosition = async (position) => {
    showConfirm(
      `Close entire ${position.symbol} position (${position.quantity} shares)?`,
      async () => {
        setExecuting(true);
        try {
          const res = await fetch("/api/paper-trading/execute", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              symbol: position.symbol,
              quantity: parseFloat(position.quantity),
              tradeType: "sell",
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            showToast(data.error || "Failed to close position", "error");
            setExecuting(false);
            return;
          }

          const pnl = data.trade.realizedPnL;
          showToast(
            `Position closed! Realized P&L: ${pnl >= 0 ? "+" : ""}$${pnl.toFixed(2)}`,
            pnl >= 0 ? "success" : "error",
          );
          loadPortfolio();
        } catch (error) {
          console.error("Close position error:", error);
          showToast("Failed to close position", "error");
        } finally {
          setExecuting(false);
        }
      },
    );
  };

  const resetPortfolio = async () => {
    showConfirm(
      "Reset portfolio to $10,000? This will close all positions and clear stats.",
      async () => {
        try {
          const res = await fetch("/api/paper-trading/reset", {
            method: "POST",
          });

          if (res.ok) {
            showToast("✅ Portfolio reset to $10,000!", "success");
            loadPortfolio();
          } else {
            showToast("Failed to reset portfolio", "error");
          }
        } catch (error) {
          console.error("Reset error:", error);
          showToast("Failed to reset portfolio", "error");
        }
      },
    );
  };

  if (userLoading || loading) {
    return (
      <InternalLayout>
        <AppNav />
        <div className="flex items-center justify-center min-h-[60vh]">
          <Activity className="text-cyan-400 animate-pulse" size={48} />
        </div>
      </InternalLayout>
    );
  }

  // PRO GATE
  if (!isPro) {
    return (
      <InternalLayout>
        <AppNav />
        <div className="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
          <div className="text-center mb-12">
            <div className="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-gradient-to-br from-amber-500/20 to-orange-500/20 border-2 border-amber-400/40 mb-8">
              <Lock className="text-amber-400" size={48} />
            </div>
            <h1 className="text-5xl font-black text-white mb-4">
              Practice Trading
              <br />
              <span className="bg-gradient-to-r from-amber-400 via-orange-400 to-red-400 bg-clip-text text-transparent">
                Without Risking Real Money
              </span>
            </h1>
            <p className="text-xl text-gray-300 max-w-2xl mx-auto mb-8">
              Paper trading lets you test strategies with simulated money. See
              how they perform before going live.
            </p>
          </div>

          <div className="grid md:grid-cols-3 gap-6 mb-12">
            <div className="p-6 rounded-2xl bg-white/5 border border-emerald-500/30">
              <Target className="text-emerald-400 mb-4" size={32} />
              <h3 className="text-lg font-bold text-white mb-2">
                Zero Risk Practice
              </h3>
              <p className="text-sm text-gray-400">
                Trade with $10,000 virtual capital. No real money at risk.
              </p>
            </div>
            <div className="p-6 rounded-2xl bg-white/5 border border-cyan-500/30">
              <Activity className="text-cyan-400 mb-4" size={32} />
              <h3 className="text-lg font-bold text-white mb-2">
                Real Market Prices
              </h3>
              <p className="text-sm text-gray-400">
                Live price feeds, realistic execution simulation.
              </p>
            </div>
            <div className="p-6 rounded-2xl bg-white/5 border border-purple-500/30">
              <TrendingUp className="text-purple-400 mb-4" size={32} />
              <h3 className="text-lg font-bold text-white mb-2">
                Track Performance
              </h3>
              <p className="text-sm text-gray-400">
                See P&L, win rate, and equity curve in real-time.
              </p>
            </div>
          </div>

          <div className="text-center p-12 rounded-3xl bg-gradient-to-br from-amber-500/20 via-orange-500/20 to-red-500/20 border-2 border-amber-400/40">
            <Crown className="mx-auto text-amber-400 mb-6" size={56} />
            <h2 className="text-3xl font-black text-white mb-4">
              Unlock Paper Trading
            </h2>
            <p className="text-lg text-gray-200 mb-8">
              Practice with virtual $10K. Test strategies risk-free. Available
              exclusively for PRO members.
            </p>
            <a
              href="/upgrade"
              className="inline-flex items-center gap-3 px-12 py-5 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 hover:from-amber-400 hover:via-orange-400 hover:to-red-400 text-white font-black text-xl shadow-2xl shadow-amber-500/50 transition-all hover:scale-110"
            >
              <Zap size={24} />
              Upgrade to PRO
              <ArrowRight size={24} />
            </a>
          </div>
        </div>
      </InternalLayout>
    );
  }

  // PRO USER VIEW - Full Paper Trading Platform
  const winRate =
    portfolio?.total_trades > 0
      ? ((portfolio.winning_trades / portfolio.total_trades) * 100).toFixed(1)
      : 0;

  return (
    <InternalLayout>
      <AppNav />

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        {/* Header */}
        <div className="flex items-center justify-between mb-8">
          <div className="flex items-center gap-3">
            <div className="p-3 rounded-xl bg-emerald-500/20 border border-emerald-500/40">
              <PlayCircle className="text-emerald-400" size={32} />
            </div>
            <div>
              <h1 className="text-4xl font-black text-white flex items-center gap-3">
                Paper Trading
                <span className="px-4 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 text-sm font-bold flex items-center gap-1.5">
                  <div className="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" />
                  LIVE
                </span>
              </h1>
              <p className="text-gray-400 text-lg">
                Practice trading with virtual capital - Real prices, zero risk
              </p>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <button
              onClick={() => loadPortfolio()}
              className="px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white transition-all flex items-center gap-2"
            >
              <RefreshCw size={18} />
              Refresh
            </button>
            <button
              onClick={resetPortfolio}
              className="px-4 py-2 rounded-xl bg-red-500/20 hover:bg-red-500/30 border border-red-500/40 text-red-400 transition-all flex items-center gap-2"
            >
              <Trash2 size={18} />
              Reset Portfolio
            </button>
            <button
              onClick={() => setShowTradeModal(true)}
              className="px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-white font-bold transition-all flex items-center gap-2 shadow-lg"
            >
              <Plus size={20} />
              New Trade
            </button>
          </div>
        </div>

        {/* Portfolio Stats */}
        {portfolio && (
          <div className="grid grid-cols-1 md:grid-cols-5 gap-6 mb-8">
            <div className="rounded-2xl bg-gradient-to-br from-emerald-500/20 to-emerald-500/10 border-2 border-emerald-500/40 p-6">
              <DollarSign className="text-emerald-400 mb-3" size={28} />
              <p className="text-sm text-emerald-400 font-semibold mb-2">
                Total Value
              </p>
              <p className="text-4xl font-black text-white mb-1">
                ${parseFloat(portfolio.total_value).toFixed(0)}
              </p>
              <p className="text-xs text-gray-400">
                Cash: ${parseFloat(portfolio.cash_balance).toFixed(0)}
              </p>
            </div>

            <div
              className={`rounded-2xl border-2 p-6 ${
                parseFloat(portfolio.total_pnl) >= 0
                  ? "bg-gradient-to-br from-cyan-500/20 to-cyan-500/10 border-cyan-500/40"
                  : "bg-gradient-to-br from-red-500/20 to-red-500/10 border-red-500/40"
              }`}
            >
              {parseFloat(portfolio.total_pnl) >= 0 ? (
                <TrendingUp className="text-cyan-400 mb-3" size={28} />
              ) : (
                <TrendingDown className="text-red-400 mb-3" size={28} />
              )}
              <p
                className={`text-sm font-semibold mb-2 ${
                  parseFloat(portfolio.total_pnl) >= 0
                    ? "text-cyan-400"
                    : "text-red-400"
                }`}
              >
                Total P&L
              </p>
              <p className="text-4xl font-black text-white mb-1">
                {parseFloat(portfolio.total_pnl) >= 0 ? "+" : ""}$
                {Math.abs(parseFloat(portfolio.total_pnl)).toFixed(2)}
              </p>
              <p className="text-xs text-gray-400">
                {parseFloat(portfolio.total_return_percent) >= 0 ? "+" : ""}
                {parseFloat(portfolio.total_return_percent).toFixed(2)}%
              </p>
            </div>

            <div className="rounded-2xl bg-gradient-to-br from-purple-500/20 to-purple-500/10 border-2 border-purple-500/40 p-6">
              <Activity className="text-purple-400 mb-3" size={28} />
              <p className="text-sm text-purple-400 font-semibold mb-2">
                Total Trades
              </p>
              <p className="text-4xl font-black text-white mb-1">
                {portfolio.total_trades || 0}
              </p>
              <p className="text-xs text-gray-400">Executed</p>
            </div>

            <div className="rounded-2xl bg-gradient-to-br from-amber-500/20 to-amber-500/10 border-2 border-amber-500/40 p-6">
              <Target className="text-amber-400 mb-3" size={28} />
              <p className="text-sm text-amber-400 font-semibold mb-2">
                Win Rate
              </p>
              <p className="text-4xl font-black text-white mb-1">{winRate}%</p>
              <p className="text-xs text-gray-400">
                {portfolio.winning_trades}W / {portfolio.losing_trades}L
              </p>
            </div>

            <div className="rounded-2xl bg-gradient-to-br from-pink-500/20 to-pink-500/10 border-2 border-pink-500/40 p-6">
              <BarChart3 className="text-pink-400 mb-3" size={28} />
              <p className="text-sm text-pink-400 font-semibold mb-2">
                Open Positions
              </p>
              <p className="text-4xl font-black text-white mb-1">
                {positions.length}
              </p>
              <p className="text-xs text-gray-400">
                Value: ${(parseFloat(portfolio.position_value) || 0).toFixed(0)}
              </p>
            </div>
          </div>
        )}

        {/* Open Positions */}
        <div className="rounded-2xl bg-white/5 border border-white/10 overflow-hidden mb-8">
          <div className="px-6 py-4 border-b border-white/10 flex items-center justify-between">
            <div>
              <h2 className="text-xl font-bold text-white">Open Positions</h2>
              <p className="text-sm text-gray-400 mt-1">
                Real-time market values and unrealized P&L
              </p>
            </div>
          </div>

          {positions.length === 0 ? (
            <div className="p-12 text-center">
              <Target className="mx-auto text-gray-600 mb-4" size={48} />
              <p className="text-gray-400 mb-4">No open positions</p>
              <button
                onClick={() => setShowTradeModal(true)}
                className="px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-white font-bold transition-all inline-flex items-center gap-2"
              >
                <Plus size={18} />
                Open Your First Position
              </button>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full">
                <thead className="bg-white/5">
                  <tr>
                    <th className="text-left p-4 text-sm font-semibold text-gray-400">
                      Symbol
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Quantity
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Avg Entry
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Current Price
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Market Value
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Unrealized P&L
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Actions
                    </th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-white/10">
                  {positions.map((pos) => {
                    const isProfit = parseFloat(pos.unrealized_pnl) >= 0;
                    return (
                      <tr key={pos.id} className="hover:bg-white/5">
                        <td className="p-4">
                          <div className="text-white font-bold text-lg">
                            {pos.symbol}
                          </div>
                          {pos.agent_name && (
                            <div className="text-xs text-gray-500 mt-1">
                              via {pos.agent_name}
                            </div>
                          )}
                        </td>
                        <td className="p-4 text-right text-white font-mono">
                          {parseFloat(pos.quantity).toFixed(4)}
                        </td>
                        <td className="p-4 text-right text-white font-mono">
                          ${parseFloat(pos.avg_entry_price).toFixed(2)}
                        </td>
                        <td className="p-4 text-right text-white font-mono font-bold">
                          ${parseFloat(pos.current_price).toFixed(2)}
                        </td>
                        <td className="p-4 text-right text-white font-mono">
                          ${parseFloat(pos.market_value).toFixed(2)}
                        </td>
                        <td className="p-4 text-right">
                          <div
                            className={`inline-flex items-center gap-1 font-bold ${
                              isProfit ? "text-emerald-400" : "text-red-400"
                            }`}
                          >
                            {isProfit ? (
                              <ArrowUpRight size={16} />
                            ) : (
                              <ArrowDownRight size={16} />
                            )}
                            {isProfit ? "+" : ""}$
                            {Math.abs(parseFloat(pos.unrealized_pnl)).toFixed(
                              2,
                            )}
                          </div>
                          <div className="text-xs text-gray-500 mt-1">
                            {isProfit ? "+" : ""}
                            {parseFloat(pos.unrealized_pnl_percent).toFixed(2)}%
                          </div>
                        </td>
                        <td className="p-4 text-right">
                          <button
                            onClick={() => closePosition(pos)}
                            disabled={executing}
                            className="px-3 py-1.5 rounded-lg bg-red-500/20 hover:bg-red-500/30 border border-red-500/40 text-red-400 text-xs font-bold transition-all"
                          >
                            Close
                          </button>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </div>

        {/* Recent Trades */}
        <div className="rounded-2xl bg-white/5 border border-white/10 overflow-hidden">
          <div className="px-6 py-4 border-b border-white/10">
            <h2 className="text-xl font-bold text-white">Trade History</h2>
            <p className="text-sm text-gray-400 mt-1">
              Last {recentTrades.length} trades
            </p>
          </div>

          {recentTrades.length === 0 ? (
            <div className="p-12 text-center">
              <Clock className="mx-auto text-gray-600 mb-4" size={48} />
              <p className="text-gray-400">No trades yet</p>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full">
                <thead className="bg-white/5">
                  <tr>
                    <th className="text-left p-4 text-sm font-semibold text-gray-400">
                      Date
                    </th>
                    <th className="text-left p-4 text-sm font-semibold text-gray-400">
                      Symbol
                    </th>
                    <th className="text-left p-4 text-sm font-semibold text-gray-400">
                      Type
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Quantity
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Price
                    </th>
                    <th className="text-right p-4 text-sm font-semibold text-gray-400">
                      Total
                    </th>
                    <th className="text-left p-4 text-sm font-semibold text-gray-400">
                      Notes
                    </th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-white/10">
                  {recentTrades.map((trade) => (
                    <tr key={trade.id} className="hover:bg-white/5">
                      <td className="p-4 text-sm text-gray-400">
                        {new Date(trade.executed_at).toLocaleString()}
                      </td>
                      <td className="p-4 text-white font-bold">
                        {trade.symbol}
                      </td>
                      <td className="p-4">
                        <span
                          className={`px-3 py-1 rounded-full text-xs font-bold ${
                            trade.trade_type === "buy"
                              ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/40"
                              : "bg-red-500/20 text-red-400 border border-red-500/40"
                          }`}
                        >
                          {trade.trade_type.toUpperCase()}
                        </span>
                      </td>
                      <td className="p-4 text-right text-white font-mono">
                        {parseFloat(trade.quantity).toFixed(4)}
                      </td>
                      <td className="p-4 text-right text-white font-mono">
                        ${parseFloat(trade.price).toFixed(2)}
                      </td>
                      <td className="p-4 text-right text-white font-mono font-bold">
                        ${Math.abs(parseFloat(trade.total_cost)).toFixed(2)}
                      </td>
                      <td className="p-4 text-sm text-gray-400">
                        {trade.notes || "-"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>

      {/* Trade Modal */}
      {showTradeModal && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-[#1A1F2E] rounded-2xl border-2 border-white/10 max-w-lg w-full p-8 shadow-2xl">
            <div className="flex items-center justify-between mb-6">
              <h2 className="text-2xl font-black text-white">New Trade</h2>
              <button
                onClick={() => setShowTradeModal(false)}
                className="text-gray-400 hover:text-white transition-colors"
              >
                <X size={24} />
              </button>
            </div>

            <div className="space-y-6">
              {/* Trade Type */}
              <div>
                <label className="block text-sm font-semibold text-white mb-3">
                  Trade Type
                </label>
                <div className="grid grid-cols-2 gap-3">
                  <button
                    onClick={() => setTradeType("buy")}
                    className={`px-4 py-3 rounded-xl font-bold transition-all ${
                      tradeType === "buy"
                        ? "bg-emerald-500/30 border-2 border-emerald-500 text-emerald-400"
                        : "bg-white/5 border-2 border-white/10 text-gray-400 hover:border-white/20"
                    }`}
                  >
                    BUY
                  </button>
                  <button
                    onClick={() => setTradeType("sell")}
                    className={`px-4 py-3 rounded-xl font-bold transition-all ${
                      tradeType === "sell"
                        ? "bg-red-500/30 border-2 border-red-500 text-red-400"
                        : "bg-white/5 border-2 border-white/10 text-gray-400 hover:border-white/20"
                    }`}
                  >
                    SELL
                  </button>
                </div>
              </div>

              {/* Symbol */}
              <div>
                <label className="block text-sm font-semibold text-white mb-3">
                  Symbol
                </label>
                <input
                  type="text"
                  value={tradeSymbol}
                  onChange={(e) => setTradeSymbol(e.target.value.toUpperCase())}
                  placeholder="e.g., BTC, ETH, AAPL"
                  className="w-full px-4 py-3 rounded-xl bg-white/5 border-2 border-white/10 focus:border-cyan-500 text-white placeholder-gray-500 outline-none transition-all uppercase"
                />
              </div>

              {/* Fetch Price */}
              <button
                onClick={fetchPrice}
                disabled={!tradeSymbol || fetchingPrice}
                className="w-full px-4 py-3 rounded-xl bg-purple-500/20 hover:bg-purple-500/30 border-2 border-purple-500/40 text-purple-400 font-bold transition-all disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {fetchingPrice ? "Fetching..." : "Fetch Current Price"}
              </button>

              {currentPrice && (
                <div className="p-4 rounded-xl bg-cyan-500/10 border border-cyan-500/30">
                  <p className="text-sm text-cyan-400 mb-1">Current Price</p>
                  <p className="text-3xl font-black text-white">
                    ${currentPrice.toFixed(2)}
                  </p>
                </div>
              )}

              {/* Quantity */}
              <div>
                <label className="block text-sm font-semibold text-white mb-3">
                  Quantity
                </label>
                <input
                  type="number"
                  step="0.0001"
                  value={tradeQuantity}
                  onChange={(e) => setTradeQuantity(e.target.value)}
                  placeholder="0.00"
                  className="w-full px-4 py-3 rounded-xl bg-white/5 border-2 border-white/10 focus:border-cyan-500 text-white placeholder-gray-500 outline-none transition-all font-mono"
                />
                {currentPrice && tradeQuantity && (
                  <p className="text-sm text-gray-400 mt-2">
                    Total: $
                    {(parseFloat(tradeQuantity) * currentPrice).toFixed(2)}
                  </p>
                )}
              </div>

              {/* Execute */}
              <button
                onClick={executeTrade}
                disabled={
                  !tradeSymbol || !tradeQuantity || !currentPrice || executing
                }
                className="w-full px-6 py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 disabled:from-gray-600 disabled:to-gray-600 text-white font-black text-lg transition-all disabled:cursor-not-allowed shadow-lg"
              >
                {executing
                  ? "Executing..."
                  : `Execute ${tradeType.toUpperCase()}`}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Toast Container */}
      <div className="fixed top-4 right-4 z-50 space-y-3 max-w-md pointer-events-none">
        {toasts.map((toast) => (
          <div
            key={toast.id}
            className={`p-4 rounded-xl border-2 shadow-2xl backdrop-blur-md flex items-start gap-3 pointer-events-auto slide-in ${
              toast.type === "success"
                ? "bg-emerald-900/90 border-emerald-500/60"
                : toast.type === "error"
                  ? "bg-red-900/90 border-red-500/60"
                  : "bg-cyan-900/90 border-cyan-500/60"
            }`}
          >
            {toast.type === "success" && (
              <CheckCircle
                className="text-emerald-400 flex-shrink-0"
                size={20}
              />
            )}
            {toast.type === "error" && (
              <XCircle className="text-red-400 flex-shrink-0" size={20} />
            )}
            {toast.type === "info" && (
              <Info className="text-cyan-400 flex-shrink-0" size={20} />
            )}
            <p
              className={`text-sm font-semibold flex-1 ${
                toast.type === "success"
                  ? "text-emerald-100"
                  : toast.type === "error"
                    ? "text-red-100"
                    : "text-cyan-100"
              }`}
            >
              {toast.message}
            </p>
            <button
              onClick={() =>
                setToasts((prev) => prev.filter((t) => t.id !== toast.id))
              }
              className="text-gray-400 hover:text-white transition-colors"
            >
              <X size={16} />
            </button>
          </div>
        ))}
      </div>

      {/* Confirmation Modal */}
      {confirmModal && (
        <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex items-center justify-center z-50 p-4">
          <div className="bg-[#1A1F2E] rounded-2xl border-2 border-white/10 max-w-md w-full p-8 shadow-2xl">
            <div className="flex items-start gap-4 mb-6">
              <div className="p-3 rounded-xl bg-amber-500/20 border border-amber-500/40">
                <AlertCircle className="text-amber-400" size={24} />
              </div>
              <div className="flex-1">
                <h3 className="text-xl font-bold text-white mb-2">
                  Confirm Action
                </h3>
                <p className="text-gray-300">{confirmModal.message}</p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <button
                onClick={() => setConfirmModal(null)}
                className="flex-1 px-4 py-3 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold transition-all"
              >
                Cancel
              </button>
              <button
                onClick={() => {
                  confirmModal.onConfirm();
                  setConfirmModal(null);
                }}
                className="flex-1 px-4 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-white font-bold transition-all"
              >
                Confirm
              </button>
            </div>
          </div>
        </div>
      )}

      <style jsx global>{`
        @keyframes slide-in {
          from {
            transform: translateX(100%);
            opacity: 0;
          }
          to {
            transform: translateX(0);
            opacity: 1;
          }
        }
        .slide-in {
          animation: slide-in 0.3s ease-out;
        }
      `}</style>
    </InternalLayout>
  );
}



