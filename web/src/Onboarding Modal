"use client";

import { useState } from "react";
import { X, Sparkles, Zap, BarChart3, Target } from "lucide-react";

export default function OnboardingModal({ onClose }) {
  const [step, setStep] = useState(1);

  const steps = [
    {
      icon: <Target className="text-cyan-400" size={48} />,
      title: "Describe Your Strategy",
      description:
        "Tell us your trading idea in plain English—no code, no complexity. Just describe what you want.",
      example: '"Buy BTC when it breaks $45K with high volume"',
    },
    {
      icon: <Zap className="text-purple-400" size={48} />,
      title: "AI Builds & Optimizes",
      description:
        "Our AI instantly generates, backtests, and optimizes your strategy with real market data.",
      example: "Takes 30-60 seconds",
    },
    {
      icon: <BarChart3 className="text-emerald-400" size={48} />,
      title: "Run Your Agent",
      description:
        "Deploy your AI trading agent and monitor performance in real-time. Adjust anytime.",
      example: "Track P&L, win rate, and risk metrics",
    },
  ];

  const handleComplete = () => {
    localStorage.setItem("quvanti_onboarding_completed", "true");
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-black/90 backdrop-blur-sm flex items-center justify-center z-50 p-4 sm:p-6 animate-fadeIn overflow-y-auto">
      <div className="bg-gradient-to-br from-[#1F2937] to-[#111827] border-2 border-cyan-500/30 rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-10 relative shadow-2xl my-auto">
        <button
          onClick={handleComplete}
          className="sticky top-0 right-0 float-right z-50 text-[#9CA3AF] hover:text-cyan-400 transition-colors bg-[#1F2937] rounded-full p-2 shadow-lg"
        >
          <X size={24} className="sm:w-7 sm:h-7" />
        </button>

        {/* Header */}
        <div className="text-center mb-6 sm:mb-10 clear-both pt-12 sm:pt-0">
          <div className="bg-gradient-to-br from-cyan-500/20 to-purple-500/20 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl flex items-center justify-center mx-auto mb-4 sm:mb-6 border border-cyan-500/30">
            <Sparkles className="text-cyan-400" size={32} />
          </div>
          <h2 className="text-2xl sm:text-4xl font-bold mb-2 sm:mb-3 bg-gradient-to-r from-cyan-400 via-purple-400 to-pink-400 bg-clip-text text-transparent px-2">
            Create Your First AI Trading Agent
          </h2>
          <p className="text-[#9CA3AF] text-sm sm:text-lg px-4">
            It's easier than you think—just 3 simple steps
          </p>
        </div>

        {/* Steps Progress - MOBILE OPTIMIZED */}
        <div className="flex items-center justify-center gap-2 sm:gap-3 mb-8 sm:mb-12">
          {[1, 2, 3].map((num) => (
            <div key={num} className="flex items-center gap-2 sm:gap-3">
              <div
                className={`w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center font-bold text-sm sm:text-base transition-all ${
                  step >= num
                    ? "bg-gradient-to-r from-cyan-500 to-purple-600 text-white shadow-lg shadow-cyan-500/40"
                    : "bg-[#374151] text-[#9CA3AF]"
                }`}
              >
                {num}
              </div>
              {num < 3 && (
                <div
                  className={`w-8 sm:w-16 h-1 rounded-full transition-all ${
                    step > num ? "bg-cyan-500" : "bg-[#374151]"
                  }`}
                ></div>
              )}
            </div>
          ))}
        </div>

        {/* Step Content - MOBILE OPTIMIZED */}
        <div className="mb-6 sm:mb-10 min-h-[240px] sm:min-h-[280px]">
          <div className="bg-gradient-to-br from-[#111827] to-[#0B0F14] border-2 border-[#374151] rounded-xl p-5 sm:p-8 text-center">
            <div className="flex justify-center mb-4 sm:mb-6">
              {steps[step - 1].icon}
            </div>
            <h3 className="text-xl sm:text-2xl font-bold text-[#E5E7EB] mb-3 sm:mb-4">
              {steps[step - 1].title}
            </h3>
            <p className="text-[#9CA3AF] text-sm sm:text-lg mb-4 sm:mb-6 leading-relaxed">
              {steps[step - 1].description}
            </p>
            <div className="bg-[#0B0F14] border border-cyan-500/30 rounded-lg p-3 sm:p-4 inline-block max-w-full">
              <p className="text-cyan-400 text-xs sm:text-sm font-mono break-words">
                {steps[step - 1].example}
              </p>
            </div>
          </div>
        </div>

        {/* Navigation Buttons - MOBILE STACKED */}
        <div className="flex flex-col sm:flex-row gap-3 sm:gap-4">
          {step > 1 && (
            <button
              onClick={() => setStep(step - 1)}
              className="w-full sm:flex-1 bg-[#374151] hover:bg-[#4B5563] text-white px-4 sm:px-6 py-3 sm:py-4 rounded-xl font-semibold transition-all text-sm sm:text-base"
            >
              Previous
            </button>
          )}
          {step < 3 ? (
            <button
              onClick={() => setStep(step + 1)}
              className="w-full sm:flex-1 bg-gradient-to-r from-cyan-600 to-purple-600 hover:from-cyan-500 hover:to-purple-500 text-white px-4 sm:px-6 py-3 sm:py-4 rounded-xl font-semibold transition-all shadow-lg shadow-cyan-500/30 text-sm sm:text-base"
            >
              Next Step
            </button>
          ) : (
            <div className="w-full sm:flex-1 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              <a
                href="/demo"
                onClick={handleComplete}
                className="bg-[#374151] hover:bg-[#4B5563] text-white px-4 sm:px-6 py-3 sm:py-4 rounded-xl font-semibold transition-all flex items-center justify-center gap-2 text-sm sm:text-base"
              >
                <Target size={18} />
                Try Demo First
              </a>
              <a
                href="/dashboard"
                onClick={handleComplete}
                className="bg-gradient-to-r from-cyan-600 to-purple-600 hover:from-cyan-500 hover:to-purple-500 text-white px-4 sm:px-6 py-3 sm:py-4 rounded-xl font-semibold transition-all shadow-lg shadow-cyan-500/30 flex items-center justify-center gap-2 text-sm sm:text-base"
              >
                <Sparkles size={18} />
                Create Agent
              </a>
            </div>
          )}
        </div>

        {/* Skip Option */}
        <div className="text-center mt-4 sm:mt-6">
          <button
            onClick={handleComplete}
            className="text-[#9CA3AF] hover:text-cyan-400 text-xs sm:text-sm transition-colors underline"
          >
            Skip tutorial and explore on my own
          </button>
        </div>
      </div>
    </div>
  );
}



