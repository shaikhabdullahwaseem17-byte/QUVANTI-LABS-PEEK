        {/* Scrolling track */}
        <div
          className="ticker-track"
          style={{ display: "flex", gap: "0", whiteSpace: "nowrap" }}
        >
          {tickerItems.map((t, i) => (
            <div
              key={`${t.symbol}-${i}`}
              style={{
                display: "inline-flex",
                alignItems: "center",
                gap: "6px",
