          {/* Trust strip */}
          <div
            style={{
              display: "flex",
              flexWrap: "wrap",
              gap: "10px",
              justifyContent: "center",
            }}
          >
            {[
              "No credit card",
              "Free forever tier",
              "Real market data",
              "Instant results",
            ].map((t) => (
              <div
                key={t}
                style={{
                  padding: "5px 14px",
                  borderRadius: "8px",
                  fontSize: "11px",
                  background: "rgba(255,255,255,0.03)",
                  border: "1px solid rgba(255,255,255,0.07)",
                  color: "rgba(255,255,255,0.35)",
                  fontFamily: "monospace",
                  letterSpacing: "0.05em",
                }}
              >
                ✓ {t}
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* ── HUD Bottom Row ─────────────────────────────────────── */}
      <div
        style={{
          position: "relative",
          zIndex: 10,
          display: "flex",
