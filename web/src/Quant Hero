// ── HUD corner bracket component ─────────────────────────────────────────
function HudCorner({ label, value, sub, right = false, bottom = false }) {
  const h = bottom ? "bottom" : "top";
  const w = right ? "right" : "left";
  return (
    <div
      style={{
        position: "relative",
        padding: "10px 14px",
        minWidth: "170px",
      }}
    >
      {/* Corner bracket marks */}
      {/* outer corner */}
      <div
        style={{
          position: "absolute",
          [h]: 0,
          [w]: 0,
          width: "10px",
          height: "10px",
          borderTop: bottom ? "none" : "1px solid rgba(91,140,255,0.45)",
          borderBottom: bottom ? "1px solid rgba(91,140,255,0.45)" : "none",
          borderLeft: right ? "none" : "1px solid rgba(91,140,255,0.45)",
          borderRight: right ? "1px solid rgba(91,140,255,0.45)" : "none",
        }}
      />
      {/* inner content */}
      <p
        style={{
          fontFamily: "monospace",
          fontSize: "9px",
          color: "rgba(91,140,255,0.65)",
          letterSpacing: "0.14em",
          textTransform: "uppercase",
          margin: "0 0 3px 0",
        }}
      >
        {label}
      </p>
      <p
        style={{
          fontFamily: "monospace",
          fontSize: "13px",
          fontWeight: 700,
          color: "#EEF2FF",
          margin: "0 0 2px 0",
        }}
      >
        {value}
      </p>
      {sub && (
        <p
          style={{
            fontFamily: "monospace",
            fontSize: "9px",
            color: "rgba(255,255,255,0.28)",
            margin: 0,
            letterSpacing: "0.06em",
          }}
        >
          {sub}
        </p>
      )}
    </div>
  );
}

// ── Radar pulse rings ────────────────────────────────────────────────────
function RadarPulse() {
  return (
    <div
      style={{
        position: "absolute",
        inset: 0,
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        pointerEvents: "none",
      }}
    >
      {[0, 1, 2].map((i) => (
        <div
          key={i}
          style={{
            position: "absolute",
            width: "1px",
            height: "1px",
            borderRadius: "50%",
            border: "1px solid rgba(91,140,255,0.18)",
            animation: `radarRing 4s ease-out ${i * 1.33}s infinite`,
          }}
        />
      ))}
    </div>
  );
}

// ── Main hero export ─────────────────────────────────────────────────────
export default function QuantHero() {
  // ── Typing animation ──────────────────────────────────────────────────
  const [stratIdx, setStratIdx] = useState(0);
  const [typedText, setTypedText] = useState("");
  const [isTyping, setIsTyping] = useState(true);
  const [showCursor, setShowCursor] = useState(true);

  // Live HUD metrics (fake-live numbers)
  const [hudMetrics, setHudMetrics] = useState({
    nodes: 78,
    connections: 1124,
    particles: 89,
    signals: 42,
    successProb: 97.8,
  });

  // Ticker prices
  const [tickers, setTickers] = useState(BASE_TICKERS);

  // ── Clock ──────────────────────────────────────────────────────────────
  const [clock, setClock] = useState("");
  useEffect(() => {
    const tick = () =>
      setClock(new Date().toUTCString().slice(17, 25) + " UTC");
    tick();
    const iv = setInterval(tick, 1000);
    return () => clearInterval(iv);
  }, []);

  // ── Cursor blink ──────────────────────────────────────────────────────
  useEffect(() => {
    const iv = setInterval(() => setShowCursor((p) => !p), 530);
    return () => clearInterval(iv);
  }, []);

  // ── Typing effect ─────────────────────────────────────────────────────
  useEffect(() => {
    const full = STRATEGIES[stratIdx];
    if (isTyping) {
      if (typedText.length < full.length) {
        const t = setTimeout(
          () => setTypedText(full.slice(0, typedText.length + 1)),
          42,
        );
        return () => clearTimeout(t);
      } else {
        const t = setTimeout(() => setIsTyping(false), 2800);
        return () => clearTimeout(t);
      }
    } else {
      if (typedText.length > 0) {
        const t = setTimeout(() => setTypedText((p) => p.slice(0, -1)), 22);
        return () => clearTimeout(t);
      } else {
        setStratIdx((p) => (p + 1) % STRATEGIES.length);
        setIsTyping(true);
      }
    }
  }, [typedText, isTyping, stratIdx]);

  // ── Live HUD counter flicker ───────────────────────────────────────────
  useEffect(() => {
    const iv = setInterval(() => {
      setHudMetrics({
        nodes: 78 + Math.floor(Math.random() * 4),
        connections: 1124 + Math.floor(Math.random() * 80) - 40,
        particles: 89 + Math.floor(Math.random() * 42),
        signals: 40 + Math.floor(Math.random() * 6),
        successProb: +(97 + Math.random() * 2).toFixed(1),
      });
    }, 1800);
    return () => clearInterval(iv);
  }, []);

  // ── Ticker price drift ────────────────────────────────────────────────
  useEffect(() => {
    const iv = setInterval(() => {
      setTickers((prev) =>
        prev.map((t) => {
          const delta = t.price * (Math.random() - 0.499) * 0.0012;
          const newPrice = t.price + delta;
          const newChange = t.change + (Math.random() - 0.5) * 0.08;
          return {
            ...t,
            price: newPrice,
            change: newChange,
            up: newChange > 0,
          };
        }),
      );
    }, 2800);
    return () => clearInterval(iv);
  }, []);

  function fmtPrice(p) {
    if (p >= 1000)
      return `$${p.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    if (p >= 1) return `$${p.toFixed(3)}`;
    return `$${p.toFixed(4)}`;
  }

  // Triple-duplicate tickers for seamless CSS scroll loop
  const tickerItems = [...tickers, ...tickers, ...tickers];

  return (
    <section
      style={{
        position: "relative",
        minHeight: "100vh",
        display: "flex",
        flexDirection: "column",
        overflow: "hidden",
        background: "#040608",
      }}
    >
      {/* ── Neural canvas background ────────────────────────────── */}
      <div style={{ position: "absolute", inset: 0, opacity: 0.58 }}>
        <NeuralTradingCanvas />
      </div>

      {/* ── Vignette layers ────────────────────────────────────── */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          pointerEvents: "none",
          background:
            "radial-gradient(ellipse at 50% 50%, transparent 25%, rgba(4,6,8,0.82) 100%)",
        }}
      />
      {/* Hard edge vignette bottom */}
      <div
        style={{
          position: "absolute",
          bottom: 0,
          left: 0,
          right: 0,
          height: "200px",
          pointerEvents: "none",
          background: "linear-gradient(to top, rgba(4,6,8,0.95), transparent)",
        }}
      />

      {/* ── Radar pulse ────────────────────────────────────────── */}
      <RadarPulse />

      {/* ── Grid overlay (very faint) ──────────────────────────── */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          pointerEvents: "none",
          opacity: 0.035,
          backgroundImage:
            "linear-gradient(rgba(91,140,255,1) 1px, transparent 1px), linear-gradient(90deg, rgba(91,140,255,1) 1px, transparent 1px)",
          backgroundSize: "80px 80px",
        }}
      />

      {/* ── AppNav ─────────────────────────────────────────────── */}
      <div style={{ position: "relative", zIndex: 20 }}>
        <AppNav />
      </div>

      {/* ── HUD Top Row ────────────────────────────────────────── */}
      <div
        style={{
          position: "relative",
          zIndex: 10,
          display: "flex",
          justifyContent: "space-between",
          alignItems: "flex-start",
          padding: "0 28px 0 28px",
        }}
      >
        <HudCorner
          label="Neural Engine"
          value="ACTIVE ●"
          sub={`${hudMetrics.nodes} nodes // ${hudMetrics.connections} edges`}
        />
        <HudCorner
          label="System Clock"
          value={clock}
          sub={`Signals: ${hudMetrics.signals} live`}
          right
        />
      </div>

      {/* ── CENTER CONTENT ─────────────────────────────────────── */}
      <div
        style={{
          flex: 1,
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          position: "relative",
          zIndex: 10,
          padding: "20px 24px 40px",
        }}
      >
        <div style={{ textAlign: "center", maxWidth: "860px", width: "100%" }}>
          {/* Badge */}
          <div
            style={{
              display: "inline-flex",
              alignItems: "center",
              gap: "8px",
              padding: "6px 16px",
              borderRadius: "100px",
