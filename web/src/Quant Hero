                letterSpacing: "0.18em",
                textTransform: "uppercase",
              }}
            >
              Quvanti Labs · AI Quant Engine Active
            </span>
          </div>

          {/* Headline */}
          <h1
            className="no-breathe"
            style={{
              fontSize: "clamp(2.8rem, 7.5vw, 6rem)",
              fontWeight: 900,
