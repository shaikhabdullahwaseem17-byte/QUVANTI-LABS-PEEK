import { useEffect, useState } from "react";
import { AlertCircle } from "lucide-react";

export default function UsageGuard({
  children,
  actionType = "strategy_parse",
}) {
  const [canProceed, setCanProceed] = useState(null);
  const [error, setError] = useState("");
  const [usage, setUsage] = useState(null);

  useEffect(() => {
    checkUsage();
  }, []);

  const checkUsage = async () => {
    try {
      const response = await fetch("/api/usage/track");
      if (!response.ok) {
        throw new Error("Failed to check usage");
      }

      const data = await response.json();
      setUsage(data);

      if (data.remaining_runs <= 0) {
        setCanProceed(false);
        setError(
          `You've reached your daily limit of ${data.max_runs} runs. ${data.tier === "pro" ? "Your limit resets in 24 hours." : "Upgrade to Pro for 15 runs per day!"}`,
        );
      } else {
        setCanProceed(true);
      }
    } catch (err) {
      console.error("Usage check error:", err);
      setCanProceed(true); // Allow on error to not block users
    }
  };

  if (canProceed === null) {
    return (
      <div className="flex items-center justify-center p-12">
        <div className="text-gray-600">Checking usage limits...</div>
      </div>
    );
  }

  if (!canProceed) {
    return (
      <div className="max-w-2xl mx-auto p-8">
        <div className="bg-red-50 border border-red-200 rounded-xl p-6 text-center">
          <AlertCircle className="w-12 h-12 text-red-600 mx-auto mb-4" />
          <h3 className="text-lg font-semibold text-red-900 mb-2">
            Daily Limit Reached
          </h3>
          <p className="text-red-700 mb-6">{error}</p>
          {usage?.tier === "free" && (
            <div className="flex gap-4 justify-center">
              <a
                href="/upgrade"
                className="px-6 py-3 bg-indigo-600 text-white rounded-lg font-semibold hover:bg-indigo-700 transition"
              >
                Upgrade to Pro
              </a>
              <a
                href="/dashboard"
                className="px-6 py-3 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition"
              >
                Back to Dashboard
              </a>
            </div>
          )}
          {usage?.tier === "pro" && (
            <a
              href="/dashboard"
              className="inline-block px-6 py-3 bg-gray-100 text-gray-700 rounded-lg font-semibold hover:bg-gray-200 transition"
            >
              Back to Dashboard
            </a>
          )}
        </div>
      </div>
    );
  }

  return children;
}



